#[test]
#[fuzzer(runs: 128, seed: 801)]
fn fuzz_layout_ops(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let y = mb(a, b, c, d);
    assert_eq!(x.transpose().transpose(), x);
    assert_eq!(Mat4Trait::from_cols_array(x.to_cols_array()), x);
    assert_eq!(Mat4Trait::from_rows_array(x.to_rows_array()), x);
    assert_eq!(Mat4Trait::from_cols_array_2d(x.to_cols_array_2d()), x);
    assert_eq!(Mat4Trait::from_rows(x.row(0), x.row(1), x.row(2), x.row(3)), x);
    assert_eq!(Mat4Trait::from_cols(x.col(0), x.col(1), x.col(2), x.col(3)), x);
    assert_eq!(x.col(0), x.transpose().row(0));
    assert_eq!((x + y) - y, x);
    assert_eq!(x + y, y + x);
    assert_eq!(x - y, x + (-y));
    assert_eq!(-(-x), x);
    assert_eq!(x.add_mat4(y), x + y);
    assert_eq!(x.sub_mat4(y), x - y);
    assert_eq!(x.mul_scalar(f(0x100000000)), x);
    assert_eq!(x.abs().abs(), x.abs());
    assert!(x.abs_diff_eq(x, f(0)));
}

#[test]
#[fuzzer(runs: 128, seed: 802)]
fn fuzz_mul_vec(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let v = va(a, b, c, d);
    let w = vb(a, b, c, d);
    assert_eq!(Mat4Trait::IDENTITY.mul_vec4(v), v);
    assert_eq!(x.mul_vec4(Vec4Trait::ZERO), Vec4Trait::ZERO);
    assert_eq!(x.mul_transpose_vec4(v), x.transpose().mul_vec4(v));
    // one floor rescale per component on each side: the two differ by at most 1 ULP
    assert!(x.mul_vec4(v + w).abs_diff_eq(x.mul_vec4(v) + x.mul_vec4(w), f(1)));
    assert_eq!(Mat4Trait::from_diagonal(v).mul_vec4(w), v * w);
    assert_eq!(Mat4Trait::from_diagonal(v).diagonal(), v);
}

#[test]
#[fuzzer(runs: 128, seed: 803)]
fn fuzz_mul_mat(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let y = mb(a, b, c, d);
    let v = va(a, b, c, d);
    assert_eq!(x * Mat4Trait::IDENTITY, x);
    assert_eq!(Mat4Trait::IDENTITY * x, x);
    assert_eq!(x * Mat4Trait::ZERO, Mat4Trait::ZERO);
    assert_eq!(x.mul_mat4(y), x * y);
    assert_eq!((x * y).transpose(), y.transpose() * x.transpose());
    let mut p = x;
    p *= y;
    assert_eq!(p, x * y);
    // (x * y) * v and x * (y * v) floor twice each, with factors of at most 8:
    // |diff| <= 2 * (8 * 4 + 1) ULP
    assert!((x * y).mul_vec4(v).abs_diff_eq(x.mul_vec4(y.mul_vec4(v)), f(66)));
}

#[test]
#[fuzzer(runs: 128, seed: 804)]
fn fuzz_determinant(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let v = va(a, b, c, d);
    let w = vb(a, b, c, d);
    assert_eq!(Mat4Trait::IDENTITY.determinant(), f(0x100000000));
    assert_eq!(Mat4Trait::ZERO.determinant(), f(0));
    // the determinant of the transpose is the same sum of products, up to the floor of the
    // six shared 2x2 minors (12 products of factors <= 64): |diff| <= 769 ULP
    assert!(x.transpose().determinant().abs_diff_eq(x.determinant(), f(1024)));
    // two equal columns make the matrix singular
    let s = Mat4Trait::from_cols(v, v, w, w);
    assert!(s.determinant().abs_diff_eq(f(0), f(1024)));
}

#[test]
#[fuzzer(runs: 128, seed: 805)]
fn fuzz_inverse(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let d = x.determinant();
    if d.abs() >= f(0x100000000) {
        let inv = x.inverse();
        assert_eq!(x.try_inverse(), Some(inv));
        assert_eq!(x.inverse_or_zero(), inv);
        // each element of the inverse is the floored adjugate element (1 ULP) divided
        // once (< 1 ULP), plus the propagated error of the floored determinant
        // (|inverse| <= 3072 ULP for |det| >= 1); the product multiplies that by
        // |element| <= 8 and floors once: |diff| <= 8 * 4 * (3072 + 2) + 1
        assert!(x.mul_mat4(inv).abs_diff_eq(Mat4Trait::IDENTITY, f(98369)));
    } else if d == f(0) {
        assert_eq!(x.try_inverse(), None);
        assert_eq!(x.inverse_or_zero(), Mat4Trait::ZERO);
    }
}

#[test]
#[fuzzer(runs: 128, seed: 806)]
fn fuzz_transform(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let v = va(a, b, c, d);
    let p = Vec3Trait::new(v.x, v.y, v.z);
    assert_eq!(x.transform_point3(p), x.transform_vector3(p) + Vec4Trait::truncate(x.w_axis));
    assert_eq!(Mat4Trait::from_translation(p).transform_point3(p), p + p);
    assert_eq!(Mat4Trait::IDENTITY.transform_vector3(p), p);
    // an affine matrix has `w = 1`, so the projection is the affine transform
    let affine = Mat4Trait::from_translation(p);
    assert_eq!(affine.project_point3(p), affine.transform_point3(p));
}
