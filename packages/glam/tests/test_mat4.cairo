        [
            f(6442450944), f(-2147483648), f(1073741824), f(4294967296), f(536870912),
            f(8589934592), f(-3221225472), f(0), f(-4294967296), f(2147483648), f(10737418240),
            f(1073741824), f(8589934592), f(-4294967296), f(0), f(12884901888),
        ],
    );
    let k = Mat4Trait::from_cols_array(
        [
            f(12884901888), f(7516192768), f(-2684354560), f(2147483648), f(-9663676416),
            f(17179869184), f(268435456), f(-8589934592), f(2147483648), f(-6442450944),
            f(25769803776), f(4294967296), f(0), f(4294967296), f(-4294967296), f(21474836480),
        ],
