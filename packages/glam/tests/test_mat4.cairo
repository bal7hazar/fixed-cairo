        assert_eq!(mx(r, 0) + mx(r, 16), mx(r, 33));
        assert_eq!(mx(r, 0).add_mat4(mx(r, 16)), mx(r, 33));
        assert_eq!(mx(r, 0) - mx(r, 16), mx(r, 49));
        assert_eq!(mx(r, 0).sub_mat4(mx(r, 16)), mx(r, 49));
        assert_eq!(-mx(r, 0), mx(r, 65));
        assert_eq!(mx(r, 0).mul_scalar(fx(r, 32)), mx(r, 81));
        assert_eq!(mx(r, 0).div_scalar(fx(r, 32)), mx(r, 97));
        assert_eq!(mx(r, 0).abs(), mx(r, 113));
        assert_eq!(mx(r, 0).mul_diagonal_scale(vc(r, 129)), mx(r, 133));
        assert_eq!(
            mx(r, 0).mul_diagonal_scale(vc(r, 129)),
            mx(r, 0).mul_mat4(Mat4Trait::from_diagonal(vc(r, 129))),
        );
        let mut p = mx(r, 0);
        p += mx(r, 16);
        assert_eq!(p, mx(r, 33));
        let mut p = mx(r, 0);
        p -= mx(r, 16);
        assert_eq!(p, mx(r, 49));
        let mut p = mx(r, 0);
        p *= fx(r, 32);
        assert_eq!(p, mx(r, 81));
        let mut p = mx(r, 0);
        p /= fx(r, 32);
        assert_eq!(p, mx(r, 97));
        assert!(mx(r, 0).abs_diff_eq(mx(r, 0), f(0)));
    }
}
