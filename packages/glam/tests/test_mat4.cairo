#[test]
fn test_mul_mat() {
    for row in MUL_MAT.span() {
        let r = row.span();
        assert_eq!(mx(r, 0).mul_mat4(mx(r, 16)), mx(r, 32));
        assert_eq!(mx(r, 0) * mx(r, 16), mx(r, 32));
        assert_eq!(mx(r, 16) * mx(r, 0), mx(r, 48));
        assert_eq!(mx(r, 0) * Mat4Trait::IDENTITY, mx(r, 0));
        assert_eq!(Mat4Trait::IDENTITY * mx(r, 0), mx(r, 0));
        let mut p = mx(r, 0);
        p *= mx(r, 16);
        assert_eq!(p, mx(r, 32));
    }
}
