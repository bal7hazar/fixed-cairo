#[test]
fn test_angle_between_axes() {
    assert_eq!(Vec3Trait::X.angle_between(Vec3Trait::Y), FRAC_PI_2);
    assert_eq!(Vec3Trait::Y.angle_between(Vec3Trait::X), FRAC_PI_2);
    assert_eq!(Vec3Trait::X.angle_between(Vec3Trait::X), f(0));
    assert_eq!(Vec3Trait::X.angle_between(Vec3Trait::NEG_X), PI);
    assert_eq!(
        Vec3Trait::X.angle_between(vec3(f(4294967296), f(4294967296), f(0)))
            + Vec3Trait::X.angle_between(vec3(f(4294967296), f(4294967296), f(0))),
        FRAC_PI_2,
    );
    assert_eq!(
        vec3(f(4294967296), f(8589934592), f(12884901888))
            .angle_between(vec3(f(8589934592), f(17179869184), f(25769803776))),
        f(0),
    );
    assert_eq!(Vec3Trait::ZERO.angle_between(Vec3Trait::X), f(0));
    // where the acos form loses the angle: the cosine of 1.5e-5 rad is 1 - 1.2e-10, half
    // a raw ULP below 1; the atan2 form keeps the angle to a few ULP (atan(2^-16))
    let w = vec3(f(4294967296), f(0), f(0)).with_y(f(65536));
    assert!(Vec3Trait::X.angle_between(w).abs_diff_eq(f(65536), f(3)));
}
