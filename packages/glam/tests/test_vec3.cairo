#[test]
fn test_abs_diff_eq() {
    let a = vec3(f(4294967296), f(8589934592), f(12884901888));
    let b = vec3(f(4294967299), f(8589934589), f(12884901888));
    assert!(a.abs_diff_eq(a, f(0)));
    assert!(a.abs_diff_eq(b, f(3)));
    assert!(!a.abs_diff_eq(b, f(2)));
    assert!(!Vec3Trait::MIN.abs_diff_eq(Vec3Trait::MAX, f(0)));
    assert!(!Vec3Trait::MIN.abs_diff_eq(Vec3Trait::MAX, f(9223372036854775807)));
}
