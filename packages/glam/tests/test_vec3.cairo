#[test]
fn test_hash_serde() {
    let a = vec3(f(4294967296), f(8589934592), f(12884901888));
    let b = vec3(f(17179869184), f(12884901888), f(8589934592));
    assert_eq!(hash(a), hash(a));
    assert!(hash(a) != hash(b));
    let mut out = array![];
    a.serialize(ref out);
    assert_eq!(out.len(), 3);
    let mut span = out.span();
    assert_eq!(Serde::<Vec3>::deserialize(ref span), Some(a));
}
