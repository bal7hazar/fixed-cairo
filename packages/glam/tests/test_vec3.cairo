    assert_eq!(v.x, f(4294967296));
    assert_eq!(v.y, f(8589934592));
    assert_eq!(v.z, f(12884901888));
    assert_eq!(v, vec3(f(4294967296), f(8589934592), f(12884901888)));
    let tu = (f(4294967296), f(8589934592), f(12884901888));
    let v: Vec3 = tu.into();
    assert_eq!(v, vec3(f(4294967296), f(8589934592), f(12884901888)));
    let tu2: (Fixed, Fixed, Fixed) = v.into();
    assert_eq!(tu2, tu);
    let a = [f(4294967296), f(8589934592), f(12884901888)];
    let v: Vec3 = a.into();
    assert_eq!(v, vec3(f(4294967296), f(8589934592), f(12884901888)));
    assert_eq!(Vec3Trait::from_array(a), vec3(f(4294967296), f(8589934592), f(12884901888)));
    let a2: [Fixed; 3] = v.into();
    assert_eq!(a2, a);
    assert_eq!(v.to_array(), a);
    assert_eq!(Default::<Vec3>::default(), Vec3Trait::ZERO);
    assert_eq!(
        Vec3Trait::splat(f(30064771072)), vec3(f(30064771072), f(30064771072), f(30064771072)),
    );
    assert_eq!(
        vec3(f(4294967296), f(8589934592), f(12884901888)).with_x(f(38654705664)),
