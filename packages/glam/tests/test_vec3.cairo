#[test]
fn test_consts() {
    assert_eq!(Vec3Trait::ZERO, vec3(f(0), f(0), f(0)));
    assert_eq!(Vec3Trait::ONE, vec3(f(4294967296), f(4294967296), f(4294967296)));
    assert_eq!(Vec3Trait::NEG_ONE, vec3(f(-4294967296), f(-4294967296), f(-4294967296)));
    assert_eq!(
        Vec3Trait::MIN,
        vec3(f(-9223372036854775808), f(-9223372036854775808), f(-9223372036854775808)),
    );
    assert_eq!(
        Vec3Trait::MAX,
        vec3(f(9223372036854775807), f(9223372036854775807), f(9223372036854775807)),
    );
    assert_eq!(Vec3Trait::X, vec3(f(4294967296), f(0), f(0)));
    assert_eq!(Vec3Trait::Y, vec3(f(0), f(4294967296), f(0)));
    assert_eq!(Vec3Trait::Z, vec3(f(0), f(0), f(4294967296)));
    assert_eq!(Vec3Trait::NEG_X, vec3(f(-4294967296), f(0), f(0)));
    assert_eq!(Vec3Trait::NEG_Y, vec3(f(0), f(-4294967296), f(0)));
    assert_eq!(Vec3Trait::NEG_Z, vec3(f(0), f(0), f(-4294967296)));
    let [ax, ay, az] = Vec3Trait::AXES;
    assert_eq!(ax, Vec3Trait::X);
    assert_eq!(ay, Vec3Trait::Y);
    assert_eq!(az, Vec3Trait::Z);
}

