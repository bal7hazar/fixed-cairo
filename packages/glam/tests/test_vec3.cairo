#[test]
fn test_normalize_axes() {
    assert_eq!(Vec3Trait::X.normalize(), Vec3Trait::X);
    assert_eq!(Vec3Trait::Y.normalize(), Vec3Trait::Y);
    assert_eq!(Vec3Trait::Z.normalize(), Vec3Trait::Z);
    assert_eq!(Vec3Trait::NEG_X.normalize(), Vec3Trait::NEG_X);
    assert_eq!(Vec3Trait::NEG_Y.normalize(), Vec3Trait::NEG_Y);
    assert_eq!(Vec3Trait::NEG_Z.normalize(), Vec3Trait::NEG_Z);
    assert!(Vec3Trait::X.is_normalized());
    assert!(Vec3Trait::Y.is_normalized());
    assert!(Vec3Trait::Z.is_normalized());
    assert!(!Vec3Trait::ONE.is_normalized());
    assert!(!Vec3Trait::ZERO.is_normalized());
