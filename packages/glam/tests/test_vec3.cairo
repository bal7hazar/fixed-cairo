#[test]
fn test_ops() {
    for row in OPS.span() {
        let r = row.span();
        assert_eq!(vc(r, 0) + vc(r, 3), vc(r, 10));
        assert_eq!(vc(r, 0) - vc(r, 3), vc(r, 13));
        assert_eq!(vc(r, 0) * vc(r, 3), vc(r, 16));
        assert_eq!(vc(r, 0) / vc(r, 3), vc(r, 19));
        assert_eq!(vc(r, 0) % vc(r, 3), vc(r, 22));
        assert_eq!(vc(r, 0).add_scalar(fx(r, 6)), vc(r, 25));
        assert_eq!(vc(r, 0).sub_scalar(fx(r, 6)), vc(r, 28));
        assert_eq!(vc(r, 0).mul_scalar(fx(r, 6)), vc(r, 31));
        assert_eq!(vc(r, 0).div_scalar(fx(r, 6)), vc(r, 34));
        assert_eq!(vc(r, 0).rem_scalar(fx(r, 6)), vc(r, 37));
        assert_eq!(-vc(r, 0), vc(r, 7));
        assert_eq!(-(-vc(r, 0)), vc(r, 0));
        let mut v = vc(r, 0);
        v += vc(r, 3);
        assert_eq!(v, vc(r, 10));
        let mut v = vc(r, 0);
        v += fx(r, 6);
        assert_eq!(v, vc(r, 25));
        let mut v = vc(r, 0);
        v -= vc(r, 3);
        assert_eq!(v, vc(r, 13));
        let mut v = vc(r, 0);
        v -= fx(r, 6);
        assert_eq!(v, vc(r, 28));
        let mut v = vc(r, 0);
        v *= vc(r, 3);
        assert_eq!(v, vc(r, 16));
        let mut v = vc(r, 0);
        v *= fx(r, 6);
        assert_eq!(v, vc(r, 31));
        let mut v = vc(r, 0);
        v /= vc(r, 3);
        assert_eq!(v, vc(r, 19));
        let mut v = vc(r, 0);
        v /= fx(r, 6);
        assert_eq!(v, vc(r, 34));
        let mut v = vc(r, 0);
        v %= vc(r, 3);
        assert_eq!(v, vc(r, 22));
        let mut v = vc(r, 0);
        v %= fx(r, 6);
        assert_eq!(v, vc(r, 37));
    }
}
