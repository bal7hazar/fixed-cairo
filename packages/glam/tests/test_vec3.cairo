#[test]
fn test_rotate_xyz() {
    for row in ROTATE_XYZ.span() {
        let r = row.span();
        assert!(vc(r, 0).rotate_x(fx(r, 3)).abs_diff_eq(vc(r, 4), fx(r, 13)));
        assert!(vc(r, 0).rotate_y(fx(r, 3)).abs_diff_eq(vc(r, 7), fx(r, 13)));
        assert!(vc(r, 0).rotate_z(fx(r, 3)).abs_diff_eq(vc(r, 10), fx(r, 13)));
        if fx(r, 3) == f(0) {
            assert_eq!(vc(r, 0).rotate_x(fx(r, 3)), vc(r, 0));
            assert_eq!(vc(r, 0).rotate_y(fx(r, 3)), vc(r, 0));
            assert_eq!(vc(r, 0).rotate_z(fx(r, 3)), vc(r, 0));
        }
    }
}

#[test]
fn test_rotate_axes() {
    assert!(Vec3Trait::Y.rotate_x(FRAC_PI_2).abs_diff_eq(Vec3Trait::Z, f(1)));
    assert!(Vec3Trait::Z.rotate_y(FRAC_PI_2).abs_diff_eq(Vec3Trait::X, f(1)));
    assert!(Vec3Trait::X.rotate_z(FRAC_PI_2).abs_diff_eq(Vec3Trait::Y, f(1)));
    assert!(Vec3Trait::Z.rotate_x(-FRAC_PI_2).abs_diff_eq(Vec3Trait::Y, f(1)));
    assert!(Vec3Trait::X.rotate_y(FRAC_PI_2).abs_diff_eq(Vec3Trait::NEG_Z, f(1)));
    assert!(Vec3Trait::Y.rotate_z(FRAC_PI_2).abs_diff_eq(Vec3Trait::NEG_X, f(1)));
    // the rotation axis is fixed exactly
    assert_eq!(Vec3Trait::X.rotate_x(FRAC_PI_2), Vec3Trait::X);
    assert_eq!(Vec3Trait::Y.rotate_y(PI), Vec3Trait::Y);
    assert_eq!(Vec3Trait::Z.rotate_z(f(1)), Vec3Trait::Z);
}

#[test]
#[fuzzer(runs: 128, seed: 301)]
fn fuzz_dot_length(a: i64, b: i64, c: i64, d: i64) {
    let va = vec3(small(a), small(b), small(c));
    let vb = vec3(small(c), small(d), small(b));
    assert_eq!(va.dot(vb), vb.dot(va));
    assert_eq!(va.length_squared(), va.dot(va));
    assert_eq!(va.distance_squared(vb), (va - vb).length_squared());
    assert_eq!(va.distance(vb), (va - vb).length());
    // the length is the floor of the exact root: len^2 <= |v|^2 < (len + 1)^2
    let len = va.length();
    assert!(len.to_raw() >= 0);
    assert!(mul_raw(len, len) <= sq_raw(va));
    assert!(mul_raw(len + f(1), len + f(1)) > sq_raw(va));
    assert_eq!(va.element_sum(), va.x + va.y + va.z);
    // the fused product is the floor of the exact one; the chain floors after every
    // multiplication and the error is amplified by the remaining factors (|x| < 8)
    assert!(va.element_product().abs_diff_eq(va.x * va.y * va.z, f(9)));
}

#[test]
#[fuzzer(runs: 128, seed: 302)]
fn fuzz_normalize(a: i64, b: i64, c: i64, d: i64) {
    let va = vec3(small(a), small(b), small(c));
    if va == Vec3Trait::ZERO {
        assert_eq!(va.try_normalize(), None);
        assert_eq!(va.normalize_or_zero(), Vec3Trait::ZERO);
        assert_eq!(va.normalize_and_length(), (Vec3Trait::X, f(0)));
    } else {
        let u = va.normalize();
        assert_eq!(va.try_normalize(), Some(u));
        assert_eq!(va.normalize_or_zero(), u);
        assert_eq!(va.normalize_or(Vec3Trait::Y), u);
        assert_eq!(va.normalize_and_length(), (u, va.length()));
        // one rounded division per component: the squared length stays within the
        // `is_normalized` threshold as long as the input is at least 1 raw ULP long
        assert!(u.length_squared().abs_diff_eq(f(0x100000000), f(1024)));
    }
}

#[test]
#[fuzzer(runs: 128, seed: 303)]
fn fuzz_min_max_clamp_cmp(a: i64, b: i64, c: i64, d: i64) {
    let va = vec3(small(a), small(b), small(c));
    let vb = vec3(small(c), small(d), small(b));
    let lo = va.min(vb);
    let hi = va.max(vb);
    assert!(lo.cmple(hi).all());
    assert!(lo.cmple(va).all() && lo.cmple(vb).all());
    assert!(hi.cmpge(va).all() && hi.cmpge(vb).all());
    assert_eq!(Vec3Trait::select(va.cmplt(vb), va, vb), lo);
    assert_eq!(Vec3Trait::select(va.cmpgt(vb), va, vb), hi);
    assert_eq!(va.cmpeq(vb), !va.cmpne(vb));
    assert_eq!(va.cmpge(vb), !va.cmplt(vb));
    assert_eq!(va.cmple(vb), !va.cmpgt(vb));
    assert_eq!(va.clamp(lo, hi), va);
    assert_eq!(va[va.min_position()], va.min_element());
    assert_eq!(va[va.max_position()], va.max_element());
    assert!(va.min_element() <= va.max_element());
}

#[test]
#[fuzzer(runs: 128, seed: 304)]
fn fuzz_sign_rounding(a: i64, b: i64, c: i64, d: i64) {
    let va = vec3(small(a), small(b), small(c));
    assert_eq!(va.abs(), va.abs().abs());
    assert_eq!((-va).abs(), va.abs());
    assert_eq!(va.signum() * va.abs(), va);
    assert_eq!(va.copysign(va), va);
    assert_eq!(va.copysign(Vec3Trait::ONE), va.abs());
    assert_eq!(va.copysign(Vec3Trait::NEG_ONE), -va.abs());
    assert_eq!(va.is_negative_mask(), va.cmplt(Vec3Trait::ZERO));
    assert_eq!(va.is_negative_bitmask(), va.is_negative_mask().bitmask());
    assert!(va.floor().cmple(va).all() && va.ceil().cmpge(va).all());
    assert_eq!(va.fract(), va - va.trunc());
    assert_eq!(va.fract_gl(), va - va.floor());
    assert!(
        va.fract_gl().cmpge(Vec3Trait::ZERO).all() && va.fract_gl().cmplt(Vec3Trait::ONE).all(),
    );
    assert!(va.round().abs().cmpge(va.trunc().abs()).all());
}

#[test]
#[fuzzer(runs: 128, seed: 305)]
fn fuzz_ops(a: i64, b: i64, c: i64, d: i64) {
    let va = vec3(small(a), small(b), small(c));
    let vb = vec3(small(c), small(d), small(b));
    assert_eq!((va + vb) - vb, va);
    assert_eq!(va + vb, vb + va);
    assert_eq!(va.midpoint(vb), va.lerp(vb, f(0x80000000)));
    assert_eq!(va.lerp(vb, f(0)), va);
    assert_eq!(va.lerp(vb, f(0x100000000)), vb);
    assert_eq!(va.move_towards(vb, f(0)), va);
    assert_eq!(va.move_towards(vb, f(1099511627776)), vb);
    assert_eq!(va.mul_add(vb, Vec3Trait::ZERO), mul_exact(va, vb));
    assert!(va.abs_diff_eq(va, f(0)));
    assert!(va.abs_diff_eq(vb, f(9223372036854775807)));
    assert_eq!(va.dot_into_vec(vb), Vec3Trait::splat(va.dot(vb)));
    assert_eq!(va.add_scalar(f(0x100000000)), va + Vec3Trait::ONE);
    assert_eq!(va.sub_scalar(f(0x100000000)), va - Vec3Trait::ONE);
    assert_eq!(va.mul_scalar(f(0x100000000)), va);
}

#[test]
#[fuzzer(runs: 128, seed: 306)]
fn fuzz_geometry(a: i64, b: i64, c: i64, d: i64) {
    let va = vec3(small(a), small(b), small(c));
    let vb = vec3(small(c), small(d), small(b));
    let c = va.cross(vb);
    assert!(vb.cross(va).abs_diff_eq(-c, f(1)));
    assert_eq!(va.cross(va), Vec3Trait::ZERO);
    // one floor rescale per component of the cross product, then one more in the
    // dot product: |c . a| <= (sum |a_i| + 1) ULP, and |a_i| <= 8
    assert!(c.dot(va).abs() <= f(25));
    assert!(c.dot(vb).abs() <= f(25));
    if vb.dot(vb) != f(0) {
        let p = va.project_onto(vb);
        let r = va.reject_from(vb);
        // `p + r` is `va` up to the floor rescales of both
        assert!((p + r).abs_diff_eq(va, f(6)));
    }
}

#[test]
#[fuzzer(runs: 128, seed: 307)]
fn fuzz_angle_between(a: i64, b: i64, c: i64, d: i64) {
    let va = vec3(small(a), small(b), small(c));
    let vb = vec3(small(c), small(d), small(b));
    assert_eq!(va.angle_between(va), f(0));
    assert_eq!(va.angle_to(va, Vec3Trait::Z), f(0));
    // `atan2` of a non-negative first argument: in `[0, pi]` up to its 3.22 ULP
    let ab = va.angle_between(vb);
    assert!(ab >= f(0) && ab <= PI + f(4));
    if va.dot(va) != f(0) {
        assert_eq!(va.angle_between(-va), PI);
    }
}

#[test]
#[fuzzer(runs: 128, seed: 308)]
fn fuzz_rotate(a: i64, b: i64, c: i64, d: i64) {
    let va = vec3(small(a), small(b), small(c));
    let ang = f(a % 13493037705);
    assert_eq!(va.rotate_x(f(0)), va);
    assert_eq!(va.rotate_y(f(0)), va);
    assert_eq!(va.rotate_z(f(0)), va);
    assert_eq!(va.rotate_x(ang).x, va.x);
    assert_eq!(va.rotate_y(ang).y, va.y);
    assert_eq!(va.rotate_z(ang).z, va.z);
    // |R v| = sqrt(c^2 + s^2) |v_yz| up to the floors: the length moves by at most
    // 1.34 * |v_yz| + sqrt(2) (|v_yz| <= 8 sqrt(2)) + 1 (two floored lengths) < 18 ULP
    let len = va.length();
    assert!(va.rotate_x(ang).length().abs_diff_eq(len, f(17)));
    assert!(va.rotate_y(ang).length().abs_diff_eq(len, f(17)));
    assert!(va.rotate_z(ang).length().abs_diff_eq(len, f(17)));
}
