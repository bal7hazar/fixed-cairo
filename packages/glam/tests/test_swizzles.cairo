        assert_eq!(
            v.with_wzy(Vec3 { x: val(5), y: val(6), z: val(7) }),
            Vec4 { x: val(1), y: val(7), z: val(6), w: val(5) },
        );
        assert_eq!(v.zyx().xy().yx(), Vec2 { x: val(2), y: val(3) });
        assert_eq!(v.wx().xxy().zyxx(), Vec4 { x: val(1), y: val(4), z: val(4), w: val(4) });
