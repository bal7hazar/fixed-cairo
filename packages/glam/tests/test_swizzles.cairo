    fn val(d: u32) -> u32 {
        d * 100 + 7
    }

    fn ck2(r: UVec2, e: u32, tag: felt252) {
        let expected = UVec2 { x: val(e / 10), y: val(e % 10) };
        if r != expected {
            panic_with_felt252(tag);
        }
    }

    fn ck3(r: UVec3, e: u32, tag: felt252) {
        let expected = UVec3 { x: val(e / 100), y: val(e / 10 % 10), z: val(e % 10) };
        if r != expected {
            panic_with_felt252(tag);
        }
    }

    fn ck4(r: UVec4, e: u32, tag: felt252) {
        let expected = UVec4 {
            x: val(e / 1000), y: val(e / 100 % 10), z: val(e / 10 % 10), w: val(e % 10),
        };
        if r != expected {
            panic_with_felt252(tag);
