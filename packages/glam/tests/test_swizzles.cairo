    #[test]
    fn anchors() {
        let v = UVec4 { x: val(1), y: val(2), z: val(3), w: val(4) };
        assert_eq!(v.wzyx(), UVec4 { x: val(4), y: val(3), z: val(2), w: val(1) });
        assert_eq!(
            v.with_wzy(UVec3 { x: val(5), y: val(6), z: val(7) }),
            UVec4 { x: val(1), y: val(7), z: val(6), w: val(5) },
        );
        assert_eq!(v.zyx().xy().yx(), UVec2 { x: val(2), y: val(3) });
        assert_eq!(v.wx().xxy().zyxx(), UVec4 { x: val(1), y: val(4), z: val(4), w: val(4) });
    }

    #[test]
    #[should_panic(expected: 'yx')]
    fn checker_detects_mismatch() {
        ck2(UVec2 { x: val(1), y: val(2) }.xy(), 21, 'yx');
    }
