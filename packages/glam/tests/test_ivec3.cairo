#[test]
#[fuzzer(runs: 256, seed: 3001)]
fn fuzz_wrapping_checked_saturating(a: i32, b: i32, c: i32, d: i32) {
    let va = ivec3(a, b, a);
    let vb = ivec3(c, d, a);
    let exact = [wide(a) + wide(c), wide(b) + wide(d), wide(a) + wide(a)];
    assert_eq!(va.wrapping_add(vb).to_array(), map_wrap(exact));
    assert_eq!(va.saturating_add(vb).to_array(), map_sat(exact));
    assert_eq!(va.checked_add(vb), map_checked(exact));
    let exact = [wide(a) - wide(c), wide(b) - wide(d), wide(a) - wide(a)];
    assert_eq!(va.wrapping_sub(vb).to_array(), map_wrap(exact));
    assert_eq!(va.saturating_sub(vb).to_array(), map_sat(exact));
    assert_eq!(va.checked_sub(vb), map_checked(exact));
    let exact = [wide(a) * wide(c), wide(b) * wide(d), wide(a) * wide(a)];
    assert_eq!(va.wrapping_mul(vb).to_array(), map_wrap(exact));
    assert_eq!(va.saturating_mul(vb).to_array(), map_sat(exact));
    assert_eq!(va.checked_mul(vb), map_checked(exact));
    // mixed signedness: the other-signedness operand is `vb` reinterpreted
    let ub = vb.as_uvec3();
    let [ux, uy, uz] = ub.to_array();
    let exact = [wide(a) + wide_o(ux), wide(b) + wide_o(uy), wide(a) + wide_o(uz)];
    assert_eq!(va.wrapping_add_unsigned(ub).to_array(), map_wrap(exact));
    assert_eq!(va.saturating_add_unsigned(ub).to_array(), map_sat(exact));
    assert_eq!(va.checked_add_unsigned(ub), map_checked(exact));
    let exact = [wide(a) - wide_o(ux), wide(b) - wide_o(uy), wide(a) - wide_o(uz)];
    assert_eq!(va.wrapping_sub_unsigned(ub).to_array(), map_wrap(exact));
    assert_eq!(va.saturating_sub_unsigned(ub).to_array(), map_sat(exact));
    assert_eq!(va.checked_sub_unsigned(ub), map_checked(exact));
}

#[test]
#[fuzzer(runs: 256, seed: 3002)]
fn fuzz_min_max_clamp_select_cmp_distances(a: i32, b: i32, c: i32, d: i32) {
    let va = ivec3(a, b, a);
    let vb = ivec3(c, d, a);
    let lo = va.min(vb);
    let hi = va.max(vb);
    assert!(lo.cmple(hi).all());
    assert!(lo.cmple(va).all() && lo.cmple(vb).all());
    assert!(hi.cmpge(va).all() && hi.cmpge(vb).all());
    assert_eq!(IVec3Trait::select(va.cmplt(vb), va, vb), lo);
    assert_eq!(IVec3Trait::select(va.cmpgt(vb), va, vb), hi);
    assert_eq!(va.cmpeq(vb), !va.cmpne(vb));
    assert_eq!(va.cmpge(vb), !va.cmplt(vb));
    assert_eq!(va.cmple(vb), !va.cmpgt(vb));
    let vc = ivec3(d, a, c);
    assert_eq!(vc.clamp(lo, hi), vc.max(lo).min(hi));
    assert!(lo.min_element() <= lo.max_element());
    assert_eq!(va[va.min_position()], va.min_element());
    assert_eq!(va[va.max_position()], va.max_element());
    let d = [abs_wide(wide(a) - wide(c)), abs_wide(wide(b) - wide(d)), abs_wide(wide(a) - wide(a))];
    let [dx, dy, dz] = d;
    let sum = dx + dy + dz;
    let expected: Option<u32> = sum.try_into();
    assert_eq!(va.checked_manhattan_distance(vb), expected);
    assert_eq!(vb.checked_manhattan_distance(va), expected);
    let mut m = dx;
    if dy > m {
        m = dy;
    }
    if dz > m {
        m = dz;
    }
    assert_eq!(wide_u(va.chebyshev_distance(vb)), m);
}

#[test]
#[fuzzer(runs: 256, seed: 3004)]
fn fuzz_dot_casts_bits_shifts(a: i32, b: i32, c: i32, d: i32, k: u32) {
    // 14-bit operands: nothing overflows
    let va = ivec3(a / 0x40000, b / 0x40000, a / 0x40000);
    let vb = ivec3(c / 0x40000, d / 0x40000, a / 0x40000);
    let expected = wide(a / 0x40000) * wide(c / 0x40000)
        + wide(b / 0x40000) * wide(d / 0x40000)
        + wide(a / 0x40000) * wide(a / 0x40000);
    assert_eq!(wide(va.dot(vb)), expected);
    assert_eq!(va.dot(vb), vb.dot(va));
    assert_eq!(va.length_squared(), va.dot(va));
    assert_eq!(wide(va.element_sum()), wide(a / 0x40000) + wide(b / 0x40000) + wide(a / 0x40000));
    let tiny = ivec3(a / 0x1000000, b / 0x1000000, a / 0x1000000);
    assert_eq!(
        wide(tiny.element_product()),
        wide(a / 0x1000000) * wide(b / 0x1000000) * wide(a / 0x1000000),
    );
    assert_eq!(
        wide(va.distance_squared(vb)),
        (wide(a / 0x40000) - wide(c / 0x40000)) * (wide(a / 0x40000) - wide(c / 0x40000))
            + (wide(b / 0x40000) - wide(d / 0x40000)) * (wide(b / 0x40000) - wide(d / 0x40000))
            + (wide(a / 0x40000) - wide(a / 0x40000)) * (wide(a / 0x40000) - wide(a / 0x40000)),
    );
    let tb = ivec3(c / 0x1000000, d / 0x1000000, a / 0x1000000);
    let c = tiny.cross(tb);
    assert_eq!(c.dot(tiny), 0);
    assert_eq!(c.dot(tb), 0);
    assert_eq!(tb.cross(tiny), -c);
    let va = ivec3(a, b, a);
    let vb = ivec3(b, a, a);
    assert_eq!(va.as_uvec3().as_ivec3(), va);
    assert_eq!(wide_o(va.as_uvec3().x), wrap_o(wide(a)));
    // (a & b) + (a | b) == a + b and (a ^ b) + 2 * (a & b) == a + b
    assert_eq!(wide((va & vb).x) + wide((va | vb).x), wide(a) + wide(b));
    assert_eq!(wide((va ^ vb).x) + 2 * wide((va & vb).x), wide(a) + wide(b));
    assert_eq!((va ^ vb) ^ vb, va);
    assert_eq!(~(va & vb), ~va | ~vb);
    assert_eq!(wide((~va).x), -1 - wide(a));
    let k = k % 32;
    let p = pow2(k);
    assert_eq!(wide(va.shl(k).x), wrap(wide(a) * p));
    assert_eq!(wide(va.shr(k).x), floor_div(wide(a), p));
}

#[test]
#[fuzzer(runs: 256, seed: 3006)]
fn fuzz_div_euclid_rem_euclid_abs_signum(a: i32, b: i32, c: i32, d: i32) {
    let va = ivec3(a, b, a);
    let vb = ivec3(nz(c), nz(d), nz(a));
    if !((a == -2147483648 && nz(c) == -1)
        || (b == -2147483648 && nz(d) == -1)
        || (a == -2147483648 && nz(a) == -1)) {
        let q = va.div_euclid(vb);
        let r = va.rem_euclid(vb);
        let tq = va / vb;
        let tr = va % vb;
        assert!(r.cmpge(IVec3Trait::ZERO).all());
        for i in 0..3_usize {
            assert!(wide(r[i]) < abs_wide(wide(vb[i])));
            assert_eq!(wide(q[i]) * wide(vb[i]) + wide(r[i]), wide(va[i]));
            assert_eq!(wide(tq[i]) * wide(vb[i]) + wide(tr[i]), wide(va[i]));
            assert!(abs_wide(wide(tr[i])) < abs_wide(wide(vb[i])));
            assert!(wide(tr[i]) == 0 || (tr[i] < 0) == (va[i] < 0));
        }
        assert_eq!(va.wrapping_div(vb), tq);
    }
    let a = if a == -2147483648 {
        0
    } else {
        a
    };
    let b = if b == -2147483648 {
        0
    } else {
        b
    };
    let va = ivec3(a, b, a);
    assert_eq!(va.signum() * va.abs(), va);
    assert_eq!((-va).abs(), va.abs());
    assert_eq!(-(-va), va);
    assert!(va.abs().cmpge(IVec3Trait::ZERO).all());
    assert_eq!(va.is_negative_mask(), va.cmplt(IVec3Trait::ZERO));
    assert_eq!(va.is_negative_bitmask(), va.is_negative_mask().bitmask());
}
