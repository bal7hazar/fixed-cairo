#[test]
fn test_hash_serde() {
    let a = ivec3(1, 2, 3);
    let b = ivec3(3, 2, 1);
    assert_eq!(hash(a), hash(a));
    assert!(hash(a) != hash(b));
    let mut out = array![];
    a.serialize(ref out);
    assert_eq!(out.len(), 3);
    let mut span = out.span();
    assert_eq!(Serde::<IVec3>::deserialize(ref span), Some(a));
}

