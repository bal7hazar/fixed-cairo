        assert_eq!(vc(r, 0).mul_scalar(fx(r, 4)), vc(r, 21));
        assert_eq!(vc(r, 0).div_scalar(fx(r, 4)), vc(r, 23));
        assert_eq!(vc(r, 0).rem_scalar(fx(r, 4)), vc(r, 25));
        assert_eq!(-vc(r, 0), vc(r, 5));
        assert_eq!(-(-vc(r, 0)), vc(r, 0));
        let mut v = vc(r, 0);
        v += vc(r, 2);
        assert_eq!(v, vc(r, 7));
        let mut v = vc(r, 0);
        v += fx(r, 4);
        assert_eq!(v, vc(r, 17));
        let mut v = vc(r, 0);
        v -= vc(r, 2);
        assert_eq!(v, vc(r, 9));
        let mut v = vc(r, 0);
        v -= fx(r, 4);
        assert_eq!(v, vc(r, 19));
        let mut v = vc(r, 0);
        v *= vc(r, 2);
        assert_eq!(v, vc(r, 11));
        let mut v = vc(r, 0);
        v *= fx(r, 4);
        assert_eq!(v, vc(r, 21));
        let mut v = vc(r, 0);
