    assert_eq!(Vec2Trait::NEG_X.normalize(), Vec2Trait::NEG_X);
    assert_eq!(Vec2Trait::NEG_Y.normalize(), Vec2Trait::NEG_Y);
    assert!(Vec2Trait::X.is_normalized());
    assert!(Vec2Trait::Y.is_normalized());
    assert!(!Vec2Trait::ONE.is_normalized());
    assert!(!Vec2Trait::ZERO.is_normalized());
    assert!(Vec2Trait::ONE.normalize().is_normalized());
    assert_eq!(
        vec2(f(12884901888), f(17179869184)).normalize(), vec2(f(2576980378), f(3435973837)),
    );
}

