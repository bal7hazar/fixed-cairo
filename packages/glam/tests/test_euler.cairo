//! Tests of `glam::euler`: the two identities of the glam-rs test suite (`tests/euler.rs`) over
//! the 24 orders, the exact cases, the gimbal-lock branch and seeded fuzz properties.
//!
//! The numeric agreement with glam-rs is pinned by `golden_euler.cairo` (generated by
//! `tools/refgen` with `DQuat`, `DMat3` and `DMat4` as the oracle). This file covers what a
//! golden table cannot: the structural identities that must hold for **every** order, the
//! bit-exact cases, and the branches whose thresholds are re-derived for Q32.32.
//!
//! The two identities, both taken from `tests/euler.rs` of glam-rs:
//!
//! * composition: `from_euler(order, a, b, c)` is the product of the three elemental rotations,
//!   read left to right for an intrinsic order and right to left for an extrinsic one;
//! * round trip: `from_euler(order, to_euler(m))` is `m` again. The angles themselves do not
//!   round trip (`(a, b, c)` and `(a + pi, -b, c + pi)` are the same proper-Euler rotation), the
//!   rotation does.

use fixed::fixed::{Fixed, FixedTrait};
use fixed::trig::TrigTrait;
use glam::euler::{EulerRot, GIMBAL_EPS, Mat3EulerTrait, Mat4EulerTrait, QuatEulerTrait};
use glam::mat3::{Mat3, Mat3Trait};
use glam::mat4::Mat4Trait;
use glam::quat::{Quat, QuatTrait};
use glam::vec3::{Vec3Trait, vec3};

fn f(raw: i64) -> Fixed {
    FixedTrait::from_raw(raw)
}

const ZERO: Fixed = Fixed { raw: 0 };
/// `pi / 2` and `pi`, quantized.
const FRAC_PI_2: Fixed = Fixed { raw: 6746518852 };
const PI: Fixed = Fixed { raw: 13493037705 };
/// One turn: the fuzz angles are reduced modulo it.
const TAU_RAW: i64 = 26986075409;

/// `from_euler` rounds three `sin_cos` (1.02 ULP) into factors of modulus <= 1 and floors once:
/// 8 ULP. The composition multiplies two matrices on top of that (one floored `dot3` each, with
/// factors of modulus <= 1): 8 + 3 * 8 + 2 <= 34, rounded up to 40.
const COMPOSE_TOL: Fixed = Fixed { raw: 40 };
/// The round trip reads the first and the third angle from entries whose magnitude is the
/// residual `r` of the order (`|cos(middle)|` for a Tait-Bryan sequence, `|sin(middle)|` for a
/// proper Euler one), so the 8 ULP that `from_euler` leaves in them become `8 / r` ULP on each
/// of the two angles (docs of `GIMBAL_EPS`). With `r >= 1/4` that is 32 ULP each, plus the
/// 4 ULP of `atan2` and the 8 ULP of the second `from_euler`: `2 * 36 + 8 = 80`.
const ROUND_TRIP_TOL: Fixed = Fixed { raw: 80 };
/// The residual below which the round trip is no longer accurate to [`ROUND_TRIP_TOL`]; `1/4`.
const MIN_RESIDUAL: Fixed = Fixed { raw: 0x40000000 };
/// The 24 orders, the axis of each of the three elemental rotations (`0 = x`, `1 = y`,
/// `2 = z`) and whether the sequence is intrinsic. This is the `axis_order` / `is_intrinsic`
/// table of `tests/euler.rs` in glam-rs, which is written down independently of the
/// `decode` table of the module under test.
#[cairofmt::skip]
const ORDERS: [(EulerRot, u8, u8, u8, bool); 24] = [
    (EulerRot::XYZ, 0, 1, 2, true),
    (EulerRot::XYX, 0, 1, 0, true),
    (EulerRot::XZY, 0, 2, 1, true),
    (EulerRot::XZX, 0, 2, 0, true),
    (EulerRot::YZX, 1, 2, 0, true),
    (EulerRot::YZY, 1, 2, 1, true),
    (EulerRot::YXZ, 1, 0, 2, true),
    (EulerRot::YXY, 1, 0, 1, true),
    (EulerRot::ZXY, 2, 0, 1, true),
    (EulerRot::ZXZ, 2, 0, 2, true),
    (EulerRot::ZYX, 2, 1, 0, true),
    (EulerRot::ZYZ, 2, 1, 2, true),
    (EulerRot::ZYXEx, 2, 1, 0, false),
    (EulerRot::XYXEx, 0, 1, 0, false),
    (EulerRot::YZXEx, 1, 2, 0, false),
    (EulerRot::XZXEx, 0, 2, 0, false),
    (EulerRot::XZYEx, 0, 2, 1, false),
    (EulerRot::YZYEx, 1, 2, 1, false),
    (EulerRot::ZXYEx, 2, 0, 1, false),
    (EulerRot::YXYEx, 1, 0, 1, false),
    (EulerRot::YXZEx, 1, 0, 2, false),
    (EulerRot::ZXZEx, 2, 0, 2, false),
    (EulerRot::XYZEx, 0, 1, 2, false),
    (EulerRot::ZYZEx, 2, 1, 2, false),
];
/// Angle triples in raw Q32.32. In degrees: `(30, 18, 12.9)`, `(15, -135, 60)` and
/// `(-30, 45, 179)`. They stay away from gimbal lock for every order (no angle is a multiple of
/// `pi / 2`), which is what makes the round trip a test of the general branch.
#[cairofmt::skip]
const ANGLES: [[i64; 3]; 3] = [
    [2248839617, 1349303770, 963788407],
    [1124419809, -10119778278, 4497679235],
    [-2248839617, 3373259426, 13418076384],
];
/// The 12 pairs `(extrinsic, intrinsic)` whose letters are the reverse of each other: an
/// extrinsic sequence is the intrinsic one applied in the opposite order.
#[cairofmt::skip]
const REVERSED: [(EulerRot, EulerRot); 12] = [
    (EulerRot::XYZEx, EulerRot::ZYX),
    (EulerRot::XZYEx, EulerRot::YZX),
    (EulerRot::YZXEx, EulerRot::XZY),
    (EulerRot::YXZEx, EulerRot::ZXY),
    (EulerRot::ZXYEx, EulerRot::YXZ),
    (EulerRot::ZYXEx, EulerRot::XYZ),
    (EulerRot::XYXEx, EulerRot::XYX),
    (EulerRot::XZXEx, EulerRot::XZX),
    (EulerRot::YXYEx, EulerRot::YXY),
    (EulerRot::YZYEx, EulerRot::YZY),
    (EulerRot::ZXZEx, EulerRot::ZXZ),
    (EulerRot::ZYZEx, EulerRot::ZYZ),
];

fn mat3_axis(axis: u8, angle: Fixed) -> Mat3 {
    match axis {
        0 => Mat3Trait::from_rotation_x(angle),
        1 => Mat3Trait::from_rotation_y(angle),
        _ => Mat3Trait::from_rotation_z(angle),
    }
}

fn quat_axis(axis: u8, angle: Fixed) -> Quat {
    match axis {
        0 => QuatTrait::from_rotation_x(angle),
        1 => QuatTrait::from_rotation_y(angle),
        _ => QuatTrait::from_rotation_z(angle),
    }
}

/// The product of the three elemental rotations of an order, in the order glam-rs composes them.
fn mat3_compose(i: u8, j: u8, k: u8, intrinsic: bool, a: Fixed, b: Fixed, c: Fixed) -> Mat3 {
    if intrinsic {
        mat3_axis(i, a) * mat3_axis(j, b) * mat3_axis(k, c)
    } else {
        mat3_axis(k, c) * mat3_axis(j, b) * mat3_axis(i, a)
    }
}

fn quat_compose(i: u8, j: u8, k: u8, intrinsic: bool, a: Fixed, b: Fixed, c: Fixed) -> Quat {
    if intrinsic {
        quat_axis(i, a) * quat_axis(j, b) * quat_axis(k, c)
    } else {
        quat_axis(k, c) * quat_axis(j, b) * quat_axis(i, a)
    }
}

/// `q` and `-q` are the same rotation: compare up to that sign.
fn quat_eq(a: Quat, b: Quat, tol: Fixed) -> bool {
    a.abs_diff_eq(b, tol) || a.abs_diff_eq(-b, tol)
}

/// An angle in `(-tau, tau)` from a raw fuzz input.
fn angle(raw: i64) -> Fixed {
    f(raw % TAU_RAW)
}

#[test]
fn test_default_and_eq() {
    assert_eq!(Default::<EulerRot>::default(), EulerRot::YXZ);
    assert!(EulerRot::YXZ == EulerRot::YXZ);
    assert!(EulerRot::YXZ != EulerRot::YXZEx);
    assert!(EulerRot::XYZ != EulerRot::XYZEx);
    // `GIMBAL_EPS` is the Q32.32 transposition of the `16 * EPSILON` of glam-rs.
    assert_eq!(GIMBAL_EPS, f(16));
}

#[test]
fn test_compose_mat3() {
    for row in ORDERS.span() {
        let (order, i, j, k, intrinsic) = *row;
        for angles in ANGLES.span() {
            let r = angles.span();
            let (a, b, c) = (f(*r[0]), f(*r[1]), f(*r[2]));
            let m = Mat3EulerTrait::from_euler(order, a, b, c);
            assert!(m.abs_diff_eq(mat3_compose(i, j, k, intrinsic, a, b, c), COMPOSE_TOL));
        }
    }
}

#[test]
fn test_compose_quat() {
    for row in ORDERS.span() {
        let (order, i, j, k, intrinsic) = *row;
        for angles in ANGLES.span() {
            let r = angles.span();
            let (a, b, c) = (f(*r[0]), f(*r[1]), f(*r[2]));
            let q = QuatEulerTrait::from_euler(order, a, b, c);
            assert!(quat_eq(q, quat_compose(i, j, k, intrinsic, a, b, c), COMPOSE_TOL));
        }
    }
}

#[test]
fn test_round_trip_mat3() {
    for row in ORDERS.span() {
        let (order, _, _, _, _) = *row;
        for angles in ANGLES.span() {
            let r = angles.span();
            let m = Mat3EulerTrait::from_euler(order, f(*r[0]), f(*r[1]), f(*r[2]));
            let (x, y, z) = m.to_euler(order);
            assert!(m.abs_diff_eq(Mat3EulerTrait::from_euler(order, x, y, z), ROUND_TRIP_TOL));
        }
    }
}

#[test]
fn test_round_trip_quat() {
    for row in ORDERS.span() {
        let (order, _, _, _, _) = *row;
        for angles in ANGLES.span() {
            let r = angles.span();
            let q = QuatEulerTrait::from_euler(order, f(*r[0]), f(*r[1]), f(*r[2]));
            let (x, y, z) = q.to_euler(order);
            assert!(quat_eq(q, QuatEulerTrait::from_euler(order, x, y, z), ROUND_TRIP_TOL));
        }
    }
}

#[test]
fn test_extrinsic_is_the_reversed_intrinsic() {
    // Bit-exact: the two orders decode to the same permutation, the same parity and the same
    // repetition; only the frame differs, and the frame only swaps the first and third angle.
    for row in REVERSED.span() {
        let (ex, intrinsic) = *row;
        for angles in ANGLES.span() {
            let r = angles.span();
            let (a, b, c) = (f(*r[0]), f(*r[1]), f(*r[2]));
            assert_eq!(
                Mat3EulerTrait::from_euler(ex, a, b, c),
                Mat3EulerTrait::from_euler(intrinsic, c, b, a),
            );
            assert_eq!(
                QuatEulerTrait::from_euler(ex, a, b, c),
                QuatEulerTrait::from_euler(intrinsic, c, b, a),
            );
            let m = Mat3EulerTrait::from_euler(ex, a, b, c);
            let (x, y, z) = m.to_euler(ex);
            assert_eq!(m.to_euler(intrinsic), (z, y, x));
        }
    }
}

#[test]
fn test_mat4_delegation() {
    // `Mat4::from_euler` embeds the `Mat3` result and `Mat4::to_euler` reads it back: both are
    // exact, for every order.
    for row in ORDERS.span() {
        let (order, _, _, _, _) = *row;
        for angles in ANGLES.span() {
            let r = angles.span();
            let (a, b, c) = (f(*r[0]), f(*r[1]), f(*r[2]));
            let m3 = Mat3EulerTrait::from_euler(order, a, b, c);
            let m4 = Mat4EulerTrait::from_euler(order, a, b, c);
            assert_eq!(m4, Mat4Trait::from_mat3(m3));
            assert_eq!(m4.to_euler(order), m3.to_euler(order));
        }
    }
}

#[test]
fn test_single_axis_is_exact() {
    // With two angles at zero the sines and cosines of the other two axes are exactly 0 and 1,
    // and every entry collapses to the elemental rotation, to the bit.
    for a in ANGLES.span() {
        let k = f(*a.span()[0]);
        assert_eq!(
            Mat3EulerTrait::from_euler(EulerRot::XYZ, k, ZERO, ZERO), Mat3Trait::from_rotation_x(k),
        );
        assert_eq!(
            Mat3EulerTrait::from_euler(EulerRot::YXZ, k, ZERO, ZERO), Mat3Trait::from_rotation_y(k),
        );
        assert_eq!(
            Mat3EulerTrait::from_euler(EulerRot::ZXY, k, ZERO, ZERO), Mat3Trait::from_rotation_z(k),
        );
        assert_eq!(
            QuatEulerTrait::from_euler(EulerRot::XYZ, k, ZERO, ZERO), QuatTrait::from_rotation_x(k),
        );
        assert_eq!(
            QuatEulerTrait::from_euler(EulerRot::YXZ, k, ZERO, ZERO), QuatTrait::from_rotation_y(k),
        );
        assert_eq!(
            QuatEulerTrait::from_euler(EulerRot::ZXY, k, ZERO, ZERO), QuatTrait::from_rotation_z(k),
        );
    }
    // The zero rotation is the identity, exactly.
    assert_eq!(Mat3EulerTrait::from_euler(EulerRot::YXZ, ZERO, ZERO, ZERO), Mat3Trait::IDENTITY);
    assert_eq!(Mat4EulerTrait::from_euler(EulerRot::YXZ, ZERO, ZERO, ZERO), Mat4Trait::IDENTITY);
    assert_eq!(QuatEulerTrait::from_euler(EulerRot::YXZ, ZERO, ZERO, ZERO), QuatTrait::IDENTITY);
    assert_eq!(Mat3Trait::IDENTITY.to_euler(EulerRot::YXZ), (ZERO, ZERO, ZERO));
    assert_eq!(QuatTrait::IDENTITY.to_euler(EulerRot::YXZ), (ZERO, ZERO, ZERO));
}

#[test]
fn test_gimbal_lock_tait_bryan() {
    // A Tait-Bryan order is singular at a middle angle of `+-pi / 2`: `cos(pi / 2)` is -1 raw
    // ULP at the quantized `pi / 2`, well inside `GIMBAL_EPS`, so the branch fires and the
    // third angle comes back as exactly zero with the whole rotation in the first one.
    let (a, c) = (f(2248839617), f(963788407));
    let m = Mat3EulerTrait::from_euler(EulerRot::YXZ, a, FRAC_PI_2, c);
    let (x, y, z) = m.to_euler(EulerRot::YXZ);
    assert_eq!(z, ZERO);
    assert!(y.abs_diff_eq(FRAC_PI_2, f(8)));
    // Only `x - z` is defined there, and `z` is zero: `x` carries `a - c` (the YXZ convention
    // reverses the roll at a pitch of `+pi / 2`).
    assert!(x.abs_diff_eq(a - c, f(64)));
    // The reconstruction is still the same rotation: the split is undefined, the matrix is not.
    assert!(m.abs_diff_eq(Mat3EulerTrait::from_euler(EulerRot::YXZ, x, y, z), ROUND_TRIP_TOL));
    // Same at `-pi / 2`.
    let m = Mat3EulerTrait::from_euler(EulerRot::YXZ, a, -FRAC_PI_2, c);
    let (x, y, z) = m.to_euler(EulerRot::YXZ);
    assert_eq!(z, ZERO);
    assert!(y.abs_diff_eq(-FRAC_PI_2, f(8)));
    assert!(m.abs_diff_eq(Mat3EulerTrait::from_euler(EulerRot::YXZ, x, y, z), ROUND_TRIP_TOL));
}

#[test]
fn test_gimbal_lock_proper_euler() {
    // A proper Euler order is singular at a middle angle of `0` or `pi`.
    let (a, c) = (f(2248839617), f(963788407));
    for b in [ZERO, PI].span() {
        let m = Mat3EulerTrait::from_euler(EulerRot::ZXZ, a, *b, c);
        let (x, y, z) = m.to_euler(EulerRot::ZXZ);
        assert_eq!(z, ZERO);
        assert!(m.abs_diff_eq(Mat3EulerTrait::from_euler(EulerRot::ZXZ, x, y, z), ROUND_TRIP_TOL));
        let q = QuatEulerTrait::from_euler(EulerRot::ZXZ, a, *b, c);
        let (x, y, z) = q.to_euler(EulerRot::ZXZ);
        assert_eq!(z, ZERO);
        assert!(quat_eq(q, QuatEulerTrait::from_euler(EulerRot::ZXZ, x, y, z), ROUND_TRIP_TOL));
    }
}

#[test]
fn test_quat_and_mat3_agree() {
    // The quaternion and the matrix of the same order and angles rotate a vector the same way.
    let v = vec3(f(0x180000000), f(-0x1c0000000), f(0x160000000));
    for row in ORDERS.span() {
        let (order, _, _, _, _) = *row;
        let (a, b, c) = (f(2248839617), f(1349303770), f(963788407));
        let q = QuatEulerTrait::from_euler(order, a, b, c);
        let m = Mat3EulerTrait::from_euler(order, a, b, c);
        // |v| <= 2, one floored rescale per component on each side, and the two forms differ in
        // the order of accumulation: 8 ULP of the entries times |v| plus 2.
        assert!(q.mul_vec3(v).abs_diff_eq(m.mul_vec3(v), f(64)));
    }
}

#[test]
#[fuzzer(runs: 128, seed: 901)]
fn fuzz_round_trip(a: i64, b: i64, c: i64) {
    let (x, y, z) = (angle(a), angle(b), angle(c));
    // A Tait-Bryan order is singular at `cos(y) = 0` and a proper Euler one at `sin(y) = 0`.
    // Inside that band the two extracted angles carry `8 / residual` ULP and only the rotation
    // they encode together is meaningful: the exact singularity is tested by
    // `test_gimbal_lock_*`, and the band in between is documented on `GIMBAL_EPS`, not tested
    // against a fixed tolerance.
    let (sy, cy) = y.sin_cos();
    if sy.abs() < MIN_RESIDUAL || cy.abs() < MIN_RESIDUAL {
        return;
    }
    for order in [EulerRot::YXZ, EulerRot::XYZEx, EulerRot::ZXZ].span() {
        let m = Mat3EulerTrait::from_euler(*order, x, y, z);
        let (i, j, k) = m.to_euler(*order);
        assert!(m.abs_diff_eq(Mat3EulerTrait::from_euler(*order, i, j, k), ROUND_TRIP_TOL));
        let q = QuatEulerTrait::from_euler(*order, x, y, z);
        let (i, j, k) = q.to_euler(*order);
        assert!(quat_eq(q, QuatEulerTrait::from_euler(*order, i, j, k), ROUND_TRIP_TOL));
    }
}

#[test]
#[fuzzer(runs: 128, seed: 902)]
fn fuzz_compose(a: i64, b: i64, c: i64) {
    let (x, y, z) = (angle(a), angle(b), angle(c));
    for row in [(EulerRot::ZYX, 2_u8, 1_u8, 0_u8, true), (EulerRot::YZYEx, 1_u8, 2_u8, 1_u8, false)]
        .span() {
        let (order, i, j, k, intrinsic) = *row;
        assert!(
            Mat3EulerTrait::from_euler(order, x, y, z)
                .abs_diff_eq(mat3_compose(i, j, k, intrinsic, x, y, z), COMPOSE_TOL),
        );
        assert!(
            quat_eq(
                QuatEulerTrait::from_euler(order, x, y, z),
                quat_compose(i, j, k, intrinsic, x, y, z),
                COMPOSE_TOL,
            ),
        );
    }
}

#[test]
#[fuzzer(runs: 128, seed: 903)]
fn fuzz_quat_is_normalized(a: i64, b: i64, c: i64) {
    // `from_euler` never renormalizes, and the two floored triple products keep the quaternion
    // inside the `is_normalized` band of `Quat` (1 024 ULP).
    let (x, y, z) = (angle(a), angle(b), angle(c));
    for order in [EulerRot::XYZ, EulerRot::YXY, EulerRot::ZXYEx].span() {
        assert!(QuatEulerTrait::from_euler(*order, x, y, z).is_normalized());
    }
}

#[test]
#[fuzzer(runs: 128, seed: 904)]
fn fuzz_reversed_frames(a: i64, b: i64, c: i64) {
    // The extrinsic order is the intrinsic one read backwards, bit for bit.
    let (x, y, z) = (angle(a), angle(b), angle(c));
    for row in REVERSED.span() {
        let (ex, intrinsic) = *row;
        assert_eq!(
            Mat3EulerTrait::from_euler(ex, x, y, z), Mat3EulerTrait::from_euler(intrinsic, z, y, x),
        );
        assert_eq!(
            QuatEulerTrait::from_euler(ex, x, y, z), QuatEulerTrait::from_euler(intrinsic, z, y, x),
        );
    }
}

#[test]
#[should_panic(expected: 'i64_add Overflow')]
fn test_quat_to_euler_overflow() {
    // `Quat::to_euler` doubles every component to build the rotation matrix: a component at or
    // above `2^30` overflows there. A normalized quaternion never reaches it.
    let q = QuatTrait::from_xyzw(f(0x4000000000000000), ZERO, ZERO, ZERO);
    let _ = q.to_euler(EulerRot::YXZ);
}

#[test]
#[should_panic(expected: 'Fixed: overflow')]
fn test_mat3_to_euler_overflow() {
    // `to_euler` takes the norm of two entries: it does not fit the scalar range for a matrix
    // whose entries are near the extremes. A rotation matrix never reaches it.
    let big = f(0x7f00000000000000);
    let m = Mat3Trait::from_cols(vec3(big, big, big), vec3(big, big, big), vec3(big, big, big));
    let _ = m.to_euler(EulerRot::XYZ);
}
