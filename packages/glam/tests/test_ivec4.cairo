#[test]
fn test_hash_serde() {
    let a = ivec4(1, 2, 3, 4);
    let b = ivec4(4, 3, 2, 1);
    assert_eq!(hash(a), hash(a));
    assert!(hash(a) != hash(b));
    let mut out = array![];
    a.serialize(ref out);
    assert_eq!(out.len(), 4);
    let mut span = out.span();
    assert_eq!(Serde::<IVec4>::deserialize(ref span), Some(a));
}

