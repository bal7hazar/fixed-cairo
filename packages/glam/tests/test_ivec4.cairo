#[test]
fn test_bit_ops() {
    for row in BIT_OPS.span() {
        let r = row.span();
        assert_eq!(vc(r, 0) & vc(r, 4), vc(r, 8));
        assert_eq!(vc(r, 0) | vc(r, 4), vc(r, 12));
        assert_eq!(vc(r, 0) ^ vc(r, 4), vc(r, 16));
        assert_eq!(~vc(r, 0), vc(r, 20));
    }
}

