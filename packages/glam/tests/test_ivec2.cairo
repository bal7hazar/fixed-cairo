#[test]
fn test_hash_serde() {
    let a = ivec2(1, 2);
    let b = ivec2(2, 1);
    assert_eq!(hash(a), hash(a));
    assert!(hash(a) != hash(b));
    let mut out = array![];
    a.serialize(ref out);
    assert_eq!(out.len(), 2);
    let mut span = out.span();
    assert_eq!(Serde::<IVec2>::deserialize(ref span), Some(a));
}

