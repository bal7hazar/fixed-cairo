#[test]
fn test_div_extremes() {
    assert_eq!(IVec2Trait::MIN.wrapping_div(IVec2Trait::NEG_ONE), IVec2Trait::MIN);
    assert_eq!(IVec2Trait::MIN.saturating_div(IVec2Trait::NEG_ONE), IVec2Trait::MAX);
    assert_eq!(
        IVec2Trait::MAX.checked_div(IVec2Trait::NEG_ONE), Some(ivec2(-2147483647, -2147483647)),
    );
    assert_eq!(IVec2Trait::MIN.rem_euclid(IVec2Trait::NEG_ONE), IVec2Trait::ZERO);
}

