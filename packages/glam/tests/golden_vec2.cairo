// component multiplies it by |rhs| <= 8 before a last floor rescale: <= 8 * 2 + 1 = 17 ULP,
// rounded up. The rejection subtracts `self` inside the same rescale.
#[cairofmt::skip]
const PROJECT_REJECT_CASES: [i64; 48] = [
    -28050507871, -4294967296, 22933258862, -17179869184,
        -15906506151, 11915955621, -12144001720, -16210922917,
    3, 15125871410, -12108588306, -15032385536, 7389414283, 9173697344, -7389414280, 5952174066,
    12925697362, 15032385536, -10737418240, -4872226147,
        16375174860, 7430422596, -3449477498, 7601962940,
    0, -43873, 32212254720, -15941769752, 17441, -8631, -17441, -35242,
    14597388201, -17179869184, -12884901888, 0, 14597388201, 0, 0, -17179869184,
    18596184964, -7159161861, 27476932456, -17781235234,
        16372583286, -10595242219, 2223601678, 3436080358,
];

#[test]
fn golden_vec2_project_reject() {
    let name: ByteArray = "vec2::project_reject";
    let mut d = PROJECT_REJECT_CASES.span();
    let mut case: usize = 0;
    while !d.is_empty() {
        let a0 = next_vec2(ref d);
        let a1 = next_vec2(ref d);
        let (r0, r1): (Vec2, Vec2) = (a0.project_onto(a1), a0.reject_from(a1));
        check_vec2(r0, ref d, 20, @name, case);
        check_vec2(r1, ref d, 20, @name, case);
        case += 1;
    }
}
