#[test]
fn test_rotations() {
    let a = f(0x59999999);
    let (s, c) = a.sin_cos();
    let z = f(0);
    let o = f(0x100000000);
    assert_eq!(Mat3Trait::from_rotation_x(a), mat3(vec3(o, z, z), vec3(z, c, s), vec3(z, -s, c)));
    assert_eq!(Mat3Trait::from_rotation_y(a), mat3(vec3(c, z, -s), vec3(z, o, z), vec3(s, z, c)));
    assert_eq!(Mat3Trait::from_rotation_z(a), mat3(vec3(c, s, z), vec3(-s, c, z), vec3(z, z, o)));
    assert_eq!(Mat3Trait::from_angle(a), mat3(vec3(c, s, z), vec3(-s, c, z), vec3(z, z, o)));
    // `from_axis_angle` around an axis of the basis is `from_rotation_*` up to the
    // extra rescale of its triple products
    assert!(
        Mat3Trait::from_axis_angle(vec3(o, z, z), a)
            .abs_diff_eq(Mat3Trait::from_rotation_x(a), f(2)),
    );
    assert!(
        Mat3Trait::from_axis_angle(vec3(z, o, z), a)
            .abs_diff_eq(Mat3Trait::from_rotation_y(a), f(2)),
    );
    assert!(
        Mat3Trait::from_axis_angle(vec3(z, z, o), a)
            .abs_diff_eq(Mat3Trait::from_rotation_z(a), f(2)),
    );
    // a rotation preserves the determinant and the length
    let r = Mat3Trait::from_axis_angle(vec3(f(0x6db6db6e), f(0xdb6db6db), f(0x49249249)), a);
    assert!(r.determinant().abs_diff_eq(o, f(8)));
    let v = vec3(f(0x180000000), f(-0x1c0000000), f(0x160000000));
    assert!(r.mul_vec3(v).length().abs_diff_eq(v.length(), f(8)));
    let scale = vec2(f(0x200000000), f(0x300000000));
    let tr = vec2(f(0x300000000), f(-0x200000000));
    assert_eq!(
        Mat3Trait::from_scale_angle_translation(scale, a, tr),
        mat3(
            vec3(c * scale.x, s * scale.x, z),
            vec3((-s) * scale.y, c * scale.y, z),
            vec3(tr.x, tr.y, o),
        ),
    );
    assert_eq!(
        Mat3Trait::from_scale(scale), mat3(vec3(scale.x, z, z), vec3(z, scale.y, z), vec3(z, z, o)),
    );
    assert_eq!(
        Mat3Trait::from_translation(tr), mat3(vec3(o, z, z), vec3(z, o, z), vec3(tr.x, tr.y, o)),
    );
    assert_eq!(Mat3Trait::from_translation(tr).transform_point2(scale), scale + tr);
    assert_eq!(
        Mat3Trait::from_scale(scale).transform_vector2(tr), vec2(scale.x * tr.x, scale.y * tr.y),
    );
}

