#[test]
fn test_consts_and_layout() {
    let m = Mat3Trait::from_cols_array(
        [
            f(6442450944), f(-2147483648), f(1073741824), f(536870912), f(8589934592),
            f(-3221225472), f(-4294967296), f(2147483648), f(10737418240),
        ],
    );
    assert_eq!(
        Mat3Trait::ZERO,
        Mat3Trait::from_cols_array([f(0), f(0), f(0), f(0), f(0), f(0), f(0), f(0), f(0)]),
    );
    assert_eq!(
        Mat3Trait::IDENTITY,
        Mat3Trait::from_cols_array(
            [f(4294967296), f(0), f(0), f(0), f(4294967296), f(0), f(0), f(0), f(4294967296)],
        ),
    );
    assert_eq!(Default::<Mat3>::default(), Mat3Trait::IDENTITY);
    let cols = m.to_cols_array();
    assert_eq!(Mat3Trait::from_cols_array(cols), m);
    assert_eq!(Mat3Trait::from_cols_array_2d(m.to_cols_array_2d()), m);
    assert_eq!(Mat3Trait::from_rows_array(m.to_rows_array()), m);
    assert_eq!(m.to_rows_array(), m.transpose().to_cols_array());
    let into: [Fixed; 9] = m.into();
    assert_eq!(into, cols);
    let back: Mat3 = into.into();
    assert_eq!(back, m);
    let into2: [[Fixed; 3]; 3] = m.into();
    let back2: Mat3 = into2.into();
    assert_eq!(back2, m);
    assert_eq!(mat3(m.x_axis, m.y_axis, m.z_axis), m);
    assert_eq!(Mat3Trait::from_cols(m.x_axis, m.y_axis, m.z_axis), m);
    assert_eq!(Mat3Trait::from_rows(m.row(0), m.row(1), m.row(2)), m);
    assert_eq!(m.col(0), m.x_axis);
    assert_eq!(m.col(1), m.y_axis);
    assert_eq!(m.col(2), m.z_axis);
    assert_eq!(m.row(0), m.transpose().col(0));
    assert_eq!(m.row(1), m.transpose().col(1));
    assert_eq!(m.row(2), m.transpose().col(2));
    assert_eq!(
        Mat3Trait::from_diagonal(m.diagonal()),
        Mat3Trait::from_cols_array(
            [f(6442450944), f(0), f(0), f(0), f(8589934592), f(0), f(0), f(0), f(10737418240)],
        ),
    );
}

