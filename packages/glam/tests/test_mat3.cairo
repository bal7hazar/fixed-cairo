fn test_det_inverse() {
    for row in DET_INVERSE.span() {
        let r = row.span();
        assert_eq!(mx(r, 0).determinant(), fx(r, 9));
        assert_eq!(mx(r, 0).transpose().determinant(), fx(r, 10));
        assert_eq!(mx(r, 0).try_inverse(), om(r, 11));
        if let Some(k) = om(r, 11) {
            assert_eq!(mx(r, 0).inverse(), k);
            assert_eq!(mx(r, 0).inverse_or_zero(), k);
            assert_eq!(mx(r, 0).mul_mat3(k), mx(r, 21));
            if bl(r, 30) {
                assert!(mx(r, 21).abs_diff_eq(Mat3Trait::IDENTITY, IDENTITY_EPS));
            }
        } else {
            assert_eq!(mx(r, 0).inverse_or_zero(), Mat3Trait::ZERO);
        }
    }
}
