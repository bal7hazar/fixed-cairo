#[test]
#[fuzzer(runs: 128, seed: 601)]
fn fuzz_layout_ops(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let y = mb(a, b, c, d);
    assert_eq!(x.transpose().transpose(), x);
    assert_eq!(Mat3Trait::from_cols_array(x.to_cols_array()), x);
    assert_eq!(Mat3Trait::from_rows_array(x.to_rows_array()), x);
    assert_eq!(Mat3Trait::from_cols_array_2d(x.to_cols_array_2d()), x);
    assert_eq!(Mat3Trait::from_rows(x.row(0), x.row(1), x.row(2)), x);
    assert_eq!(Mat3Trait::from_cols(x.col(0), x.col(1), x.col(2)), x);
    assert_eq!(x.col(0), x.transpose().row(0));
    assert_eq!((x + y) - y, x);
    assert_eq!(x + y, y + x);
    assert_eq!(x - y, x + (-y));
    assert_eq!(-(-x), x);
    assert_eq!(x.add_mat3(y), x + y);
    assert_eq!(x.sub_mat3(y), x - y);
    assert_eq!(x.mul_scalar(f(0x100000000)), x);
    assert_eq!(x.abs().abs(), x.abs());
    assert!(x.abs_diff_eq(x, f(0)));
}

#[test]
#[fuzzer(runs: 128, seed: 602)]
fn fuzz_mul_vec(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let v = va(a, b, c, d);
    let w = vb(a, b, c, d);
    assert_eq!(Mat3Trait::IDENTITY.mul_vec3(v), v);
    assert_eq!(x.mul_vec3(Vec3Trait::ZERO), Vec3Trait::ZERO);
    assert_eq!(x.mul_transpose_vec3(v), x.transpose().mul_vec3(v));
    // one floor rescale per component on each side: the two differ by at most 1 ULP
    assert!(x.mul_vec3(v + w).abs_diff_eq(x.mul_vec3(v) + x.mul_vec3(w), f(1)));
    assert_eq!(Mat3Trait::from_diagonal(v).mul_vec3(w), v * w);
    assert_eq!(Mat3Trait::from_diagonal(v).diagonal(), v);
}

#[test]
#[fuzzer(runs: 128, seed: 603)]
fn fuzz_mul_mat(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let y = mb(a, b, c, d);
    let v = va(a, b, c, d);
    assert_eq!(x * Mat3Trait::IDENTITY, x);
    assert_eq!(Mat3Trait::IDENTITY * x, x);
    assert_eq!(x * Mat3Trait::ZERO, Mat3Trait::ZERO);
    assert_eq!(x.mul_mat3(y), x * y);
    assert_eq!((x * y).transpose(), y.transpose() * x.transpose());
    let mut p = x;
    p *= y;
    assert_eq!(p, x * y);
    // (x * y) * v and x * (y * v) floor twice each, with factors of at most 8:
    // |diff| <= 2 * (8 * 3 + 1) ULP
    assert!((x * y).mul_vec3(v).abs_diff_eq(x.mul_vec3(y.mul_vec3(v)), f(50)));
}

#[test]
#[fuzzer(runs: 128, seed: 604)]
fn fuzz_determinant(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let v = va(a, b, c, d);
    let w = vb(a, b, c, d);
    assert_eq!(Mat3Trait::IDENTITY.determinant(), f(0x100000000));
    assert_eq!(Mat3Trait::ZERO.determinant(), f(0));
    // the determinant of the transpose is the same sum of products, in the same order of
    // accumulation: it is bit-identical
    assert_eq!(x.transpose().determinant(), x.determinant());
    // two equal columns make the matrix singular
    let s = Mat3Trait::from_cols(v, v, w);
    assert_eq!(s.determinant(), f(0));
    assert_eq!(s.try_inverse(), None);
}

#[test]
#[fuzzer(runs: 128, seed: 605)]
fn fuzz_inverse(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let d = x.determinant();
    if d.abs() >= f(0x100000000) {
        let inv = x.inverse();
        assert_eq!(x.try_inverse(), Some(inv));
        assert_eq!(x.inverse_or_zero(), inv);
        // each element of the inverse is the floored adjugate element (1 ULP) divided
        // once (< 1 ULP), plus the propagated error of the floored determinant
        // (|inverse| <= 128 ULP for |det| >= 1); the product multiplies that by
        // |element| <= 8 and floors once: |diff| <= 8 * 3 * (128 + 2) + 1
        assert!(x.mul_mat3(inv).abs_diff_eq(Mat3Trait::IDENTITY, f(3121)));
    } else if d == f(0) {
        assert_eq!(x.try_inverse(), None);
        assert_eq!(x.inverse_or_zero(), Mat3Trait::ZERO);
    }
}

#[test]
#[fuzzer(runs: 128, seed: 606)]
fn fuzz_transform(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let v = va(a, b, c, d);
    // `transform_point2` is `transform_vector2` plus the translation column, added
    // exactly inside the same rescale
    let p = Vec2Trait::new(v.x, v.y);
    assert_eq!(x.transform_point2(p), x.transform_vector2(p) + Vec3Trait::truncate(x.z_axis));
    assert_eq!(Mat3Trait::from_translation(p).transform_point2(p), p + p);
    assert_eq!(Mat3Trait::IDENTITY.transform_vector2(p), p);
}
