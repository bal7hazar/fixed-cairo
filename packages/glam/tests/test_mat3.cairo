#[test]
fn test_arith() {
    for row in ARITH.span() {
        let r = row.span();
        assert_eq!(mx(r, 0) + mx(r, 9), mx(r, 19));
        assert_eq!(mx(r, 0).add_mat3(mx(r, 9)), mx(r, 19));
        assert_eq!(mx(r, 0) - mx(r, 9), mx(r, 28));
        assert_eq!(mx(r, 0).sub_mat3(mx(r, 9)), mx(r, 28));
        assert_eq!(-mx(r, 0), mx(r, 37));
        assert_eq!(mx(r, 0).mul_scalar(fx(r, 18)), mx(r, 46));
        assert_eq!(mx(r, 0).div_scalar(fx(r, 18)), mx(r, 55));
        assert_eq!(mx(r, 0).abs(), mx(r, 64));
        assert_eq!(mx(r, 0).mul_diagonal_scale(vc(r, 73)), mx(r, 76));
        assert_eq!(
            mx(r, 0).mul_diagonal_scale(vc(r, 73)),
            mx(r, 0).mul_mat3(Mat3Trait::from_diagonal(vc(r, 73))),
        );
        let mut p = mx(r, 0);
        p += mx(r, 9);
        assert_eq!(p, mx(r, 19));
        let mut p = mx(r, 0);
        p -= mx(r, 9);
        assert_eq!(p, mx(r, 28));
        let mut p = mx(r, 0);
        p *= fx(r, 18);
        assert_eq!(p, mx(r, 46));
        let mut p = mx(r, 0);
        p /= fx(r, 18);
        assert_eq!(p, mx(r, 55));
        assert!(mx(r, 0).abs_diff_eq(mx(r, 0), f(0)));
    }
}
