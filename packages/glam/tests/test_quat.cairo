#[cairofmt::skip]
const SCALED_AXIS: [[i64; 10]; 7] = [
    [0, 0, 0, 0, 0, 0, 4294967296, 0, 0, 0],
    [6746518852, 0, 0, 3037000500, 0, 0, 3037000500, 6746518852, 0, 0],
    [0, -13493037705, 0, 0, -4294967296, 0, 0, 0, -13493037704, 0],
    [1288490189, -1717986918, 5153960755, 599828266, -799771022, 2399313065, 3419153880, 1288490188, -1717986920, 5153960755],
    [1, 0, 0, 0, 0, 0, 4294967296, 0, 0, 0],
    [42949672960, 0, 0, -4118548399, 0, 0, 1218319809, -11022477860, 0, 0],
    [-3006477107, 3006477107, -3006477107, -1412842313, 1412842312, -1412842313, 3529642175, -3006477110, 3006477106, -3006477110],
];

#[test]
fn test_scaled_axis() {
    for row in SCALED_AXIS.span() {
        let r = row.span();
        assert_eq!(QuatTrait::from_scaled_axis(vc(r, 0)), qt(r, 3));
        assert_eq!(qt(r, 3).to_scaled_axis(), vc(r, 7));
    }
    // The axis is normalized before the sine is applied, so a scaled cardinal axis gives
    // exactly the matching `from_rotation_*` (the `benches::alt::quat` variant that folds the
    // sine into the shared division is 1 ULP off here).
    let a = f(3006477107);
    assert_eq!(
        QuatTrait::from_scaled_axis(Vec3Trait::X.mul_scalar(a)), QuatTrait::from_rotation_x(a),
    );
    assert_eq!(
        QuatTrait::from_scaled_axis(Vec3Trait::Y.mul_scalar(a)), QuatTrait::from_rotation_y(a),
    );
    assert_eq!(
        QuatTrait::from_scaled_axis(Vec3Trait::Z.mul_scalar(a)), QuatTrait::from_rotation_z(a),
    );
    // The axis comes back exactly; the angle carries the 3.22 ULP of `atan2` plus the floor of
    // the halving.
    let (axis, angle) = QuatTrait::from_rotation_x(a).to_axis_angle();
    assert_eq!(axis, Vec3Trait::X);
    assert!(angle.abs_diff_eq(a, f(8)));
    assert!(
        QuatTrait::from_rotation_x(a)
            .to_scaled_axis()
            .abs_diff_eq(Vec3Trait::X.mul_scalar(a), f(8)),
    );
}
