#[test]
fn test_mul() {
    for row in MUL.span() {
        let r = row.span();
        assert_eq!(qt(r, 0).mul_quat(qt(r, 4)), qt(r, 8));
        assert_eq!(qt(r, 0) * qt(r, 4), qt(r, 8));
        assert_eq!(qt(r, 4) * qt(r, 0), qt(r, 12));
        // `conjugate(a * b) = conjugate(b) * conjugate(a)`, up to the floor of each rescale.
        assert!(
            (qt(r, 4).conjugate() * qt(r, 0).conjugate()).abs_diff_eq(qt(r, 8).conjugate(), f(2)),
        );
    }
}

#[test]
fn test_mul_exact() {
    // The identity is neutral, exactly.
    let q = quat(f(393604950), f(787209899), f(1180814849), f(4034575081));
    assert_eq!(QuatTrait::IDENTITY * q, q);
    assert_eq!(q * QuatTrait::IDENTITY, q);
    // A quarter turn around x, squared, is a half turn around x.
    let qx = QuatTrait::from_rotation_x(f(6746518852));
    assert_eq!(qx * qx, quat(f(0x100000000), f(0), f(0), f(0)));
    // `q * conjugate(q)` is the identity, exactly for a quaternion whose components are exact,
    // within 1 ULP otherwise.
    assert_eq!(qx * qx.conjugate(), QuatTrait::IDENTITY);
    assert!((q * q.conjugate()).abs_diff_eq(QuatTrait::IDENTITY, f(1)));
    assert!((q * q.inverse()).abs_diff_eq(QuatTrait::IDENTITY, f(1)));
}
