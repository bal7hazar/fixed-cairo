// Seeded fuzz properties. The inputs are unit quaternions built by `from_axis_angle`, i.e. the
// quaternions the module itself produces.

#[test]
#[fuzzer(runs: 128, seed: 401)]
fn fuzz_mul_quat(a: i64, b: i64, c: i64, d: i64) {
    let p = unit_q(a, b, c, d);
    let q = unit_q(d, c, b, a);
    let r = unit_q(b, a, d, c);
    assert_eq!(QuatTrait::IDENTITY * p, p);
    assert_eq!(p * QuatTrait::IDENTITY, p);
    // Associativity, up to the floor rescale of each of the two products (4 terms each, every
    // factor of magnitude at most 1).
    assert!(((p * q) * r).abs_diff_eq(p * (q * r), f(8)));
    // `conjugate(p q) = conjugate(q) conjugate(p)`.
    assert!((p * q).conjugate().abs_diff_eq(q.conjugate() * p.conjugate(), f(2)));
    // The product of two unit quaternions is a unit quaternion.
    assert!((p * q).is_normalized());
    // `p conjugate(p) = (0, 0, 0, |p|^2)`: the identity up to the drift of `p` (at most 4 ULP
    // on the squared length) and the floor of the four rescales.
    assert!((p * p.inverse()).abs_diff_eq(QuatTrait::IDENTITY, f(8)));
}

#[test]
#[fuzzer(runs: 128, seed: 402)]
fn fuzz_mul_vec3(a: i64, b: i64, c: i64, d: i64) {
    let q = unit_q(a, b, c, d);
    let v = vec3(f(a % 0x400000000), f(b % 0x400000000), f(c % 0x400000000));
    let r = q.mul_vec3(v);
    // A rotation preserves the length. `|v|^2 <= 48` and `q` is unit to within 4 ULP, which
    // scales the squared length by up to 4 * 48 = 192 ULP; each of the four rescales floors.
    assert!(r.length_squared().abs_diff_eq(v.length_squared(), f(256)));
    // The inverse rotation brings the vector back (two rotations of a vector of length 7).
    assert!(q.inverse().mul_vec3(r).abs_diff_eq(v, f(64)));
    // Composing two rotations is multiplying the quaternions: the product drifts by up to
    // 9 ULP on the squared length, which scales a vector of length 7 by up to 64 ULP.
    let p = unit_q(d, c, b, a);
    assert!((p * q).mul_vec3(v).abs_diff_eq(p.mul_vec3(q.mul_vec3(v)), f(128)));
    // The rotation axis is fixed by the rotation.
    let (axis, _) = q.to_axis_angle();
    assert!(q.mul_vec3(axis).abs_diff_eq(axis, f(64)));
}

#[test]
#[fuzzer(runs: 128, seed: 403)]
fn fuzz_axis_angle(a: i64, b: i64, c: i64, d: i64) {
    let q = unit_q(a, b, c, d);
    let (axis, angle) = q.to_axis_angle();
    // The axis is a unit vector as long as the vector part is not tiny, and the angle is in
    // `[0, tau]` (`2 atan2(|xyz|, w)` with a non-negative first argument).
    assert!(angle >= f(0) && angle <= f(26986075409));
    assert!(axis.length_squared().abs_diff_eq(f(0x100000000), f(0x10000)));
    assert_eq!(q.to_scaled_axis(), axis.mul_scalar(angle));
    // Rebuilding the quaternion gives back the same rotation (`q` or `-q`).
    let back = QuatTrait::from_axis_angle(axis, angle);
    assert!(back.abs_diff_eq(q, f(0x10000)) || back.abs_diff_eq(-q, f(0x10000)));
    // `from_scaled_axis` is the same rotation as `from_axis_angle`.
    assert!(
        QuatTrait::from_scaled_axis(q.to_scaled_axis()).abs_diff_eq(back, f(0x10000))
            || QuatTrait::from_scaled_axis(q.to_scaled_axis()).abs_diff_eq(-back, f(0x10000)),
    );
    // The matrix round trip: `q` and `-q` are the same rotation; measured at most 4 raw ULP
    // per component over 50 000 random unit quaternions of the Python mirror, 16 on the
    // matrix. The 4x4 constructors agree with the 3x3 one.
    let m = Mat3Trait::from_quat(q);
    let r = QuatTrait::from_mat3(m);
    assert!(r.abs_diff_eq(q, f(8)) || (-r).abs_diff_eq(q, f(8)));
    assert!(Mat3Trait::from_quat(r).abs_diff_eq(m, f(16)));
    assert_eq!(QuatTrait::from_mat4(Mat4Trait::from_quat(q)), r);
}

#[test]
#[fuzzer(runs: 128, seed: 404)]
fn fuzz_normalize_dot(a: i64, b: i64, c: i64, d: i64) {
    let q = quat(f(a % 0x400000000), f(b % 0x400000000), f(c % 0x400000000), f(d % 0x400000000));
    let p = unit_q(a, b, c, d);
    assert_eq!(q.dot(p), p.dot(q));
    assert_eq!(q.dot(q), q.length_squared());
    // The length is the floor of the exact root.
    let len = q.length();
    assert!(len >= f(0));
    if q != QuatTrait::ZERO {
        let u = q.normalize();
        assert!(u.is_normalized());
        assert!(u.normalize().abs_diff_eq(u, f(2)));
        assert_eq!(q.length_recip(), len.recip());
    }
    // A quaternion and its negation are the same rotation (zero angle apart, up to the
    // conditioning of `acos` near one: see `test_angle_between`).
    assert!((-p).angle_between(p) <= f(400000));
    assert!(p.is_normalized());
}

#[test]
#[fuzzer(runs: 128, seed: 405)]
fn fuzz_lerp_slerp(a: i64, b: i64, c: i64, d: i64) {
    let p = unit_q(a, b, c, d);
    let q = unit_q(d, c, b, a);
    let half = f(0x80000000);
    assert!(p.lerp(q, f(0)).abs_diff_eq(p, f(2)));
    assert!(p.lerp(q, f(0x100000000)).abs_diff_eq(q, f(2)) || p.dot(q) < f(0));
    // `slerp` at `s = 0` is `p sin(theta) / sin(theta)`: the floor of the numerator is
    // amplified by `1 / sin(theta)`, which reaches 512 at the `NEAR_ONE` threshold.
    assert!(p.slerp(q, f(0)).abs_diff_eq(p, f(2048)));
    assert!(p.lerp(q, half).is_normalized());
    // The two interpolations agree on the midpoint up to the accuracy of the `NEAR_ONE` band.
    assert!(p.lerp(q, half).abs_diff_eq(p.slerp(q, half), f(4096)));
    // `rotate_towards` with a large budget lands on the target.
    assert!(p.rotate_towards(q, f(0x600000000)).abs_diff_eq(q, f(4096)) || p.dot(q) < f(0));
}

#[test]
#[fuzzer(runs: 128, seed: 406)]
fn fuzz_mul_quat_drift(a: i64, b: i64, c: i64, d: i64) {
    // Unit-quaternion drift: how far 100 successive products move the squared length away from
    // one (docs of `Quat`). Measured over the fuzz corpus and over 200 random chains of the
    // Python mirror: at most 271 ULP, i.e. about 2.5 ULP per product, so a quaternion stays
    // inside the `is_normalized` band (1024 ULP) for about 400 products.
    let step = unit_q(a, b, c, d % 0x20000000);
    let mut q = unit_q(d, c, b, a);
    assert!(drift(q) <= 4);
    for _ in 0_u32..100 {
        q = q * step;
    }
    assert!(drift(q) <= 1024);
    assert!(q.is_normalized());
}

/// All `Fixed::MAX`.
const MAXQ: Quat = Quat {
    x: Fixed { raw: 0x7fffffffffffffff },
    y: Fixed { raw: 0x7fffffffffffffff },
    z: Fixed { raw: 0x7fffffffffffffff },
    w: Fixed { raw: 0x7fffffffffffffff },
};

/// All `Fixed::MIN`.
const MINQ: Quat = Quat {
    x: Fixed { raw: -0x8000000000000000 },
    y: Fixed { raw: -0x8000000000000000 },
    z: Fixed { raw: -0x8000000000000000 },
    w: Fixed { raw: -0x8000000000000000 },
};
