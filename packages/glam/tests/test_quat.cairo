    [0, 0, -2147483649, 3719550786, 4294967296, 0, 0, 2147483645, -3719550788, 0, 2147483645, -3719550788, 0],
    [393604950, 787209899, 1180814849, 4034575081, 4294967296, 8589934592, 12884901888, 4294967295, 8589934589, 12884901889, 4294967294, 8589934589, 12884901889],
    [-1747086207, 873543103, 3494172412, 1556314705, -12884901888, 2147483648, 8589934592, -803488923, -1495735525, 15541445870, -803488923, -1495735525, 15541445870],
    [0, 0, 0, 4294967296, 4294967296, 8589934592, 12884901888, 4294967296, 8589934592, 12884901888, 4294967296, 8589934592, 12884901888],
    [3037000500, 0, 0, 3037000500, 0, 0, 0, 0, 0, 0, 0, 0, 0],
];

#[test]
fn test_mul_vec3() {
    for row in ROTATE.span() {
        let r = row.span();
        assert_eq!(qt(r, 0).mul_vec3(vc(r, 4)), vc(r, 7));
        // The rotation is the sandwich product `q v q*` written out: same value within the
        // rounding of the two products.
        let s = qt(r, 0) * quat(fx(r, 4), fx(r, 5), fx(r, 6), f(0)) * qt(r, 0).conjugate();
        assert!(vc(r, 7).abs_diff_eq(s.xyz(), f(4)));
        // The `t = 2 b x v; v + w t + b x t` formulation of `benches::alt::quat` rounds three
        // times where this one rounds once: the two agree within 4 ULP.
        assert!(vc(r, 7).abs_diff_eq(vc(r, 10), f(4)));
    }
}

#[test]
fn test_mul_vec3_axes() {
    let h = f(6746518852); // pi / 2
    let (qx, qy, qz) = (
        QuatTrait::from_rotation_x(h), QuatTrait::from_rotation_y(h), QuatTrait::from_rotation_z(h),
    );
    // A quarter turn maps the axes onto each other; the negative directions land 1 ULP low
    // (the floor of the final rescale).
    assert_eq!(qx.mul_vec3(Vec3Trait::Y), Vec3Trait::Z);
    assert!(qx.mul_vec3(Vec3Trait::Z).abs_diff_eq(Vec3Trait::NEG_Y, f(1)));
    assert_eq!(qy.mul_vec3(Vec3Trait::Z), Vec3Trait::X);
    assert!(qy.mul_vec3(Vec3Trait::X).abs_diff_eq(Vec3Trait::NEG_Z, f(1)));
    assert_eq!(qz.mul_vec3(Vec3Trait::X), Vec3Trait::Y);
    assert!(qz.mul_vec3(Vec3Trait::Y).abs_diff_eq(Vec3Trait::NEG_X, f(1)));
    // The rotation axis is fixed.
    assert_eq!(qx.mul_vec3(Vec3Trait::X), Vec3Trait::X);
    assert_eq!(QuatTrait::IDENTITY.mul_vec3(Vec3Trait::Y), Vec3Trait::Y);
}
