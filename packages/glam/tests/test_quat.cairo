    assert_eq!(QuatTrait::from_mat3(Mat3Trait::IDENTITY), QuatTrait::IDENTITY);
    assert_eq!(QuatTrait::from_mat4(Mat4Trait::IDENTITY), QuatTrait::IDENTITY);
