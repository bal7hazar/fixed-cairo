//! Tests of `glam::quat`: tables over curated inputs (expected values computed by a Q32.32
//! Python oracle that mirrors the module and `fixed::trig` bit for bit), exact rotations of the
//! axes, seeded fuzz properties and one test per panic path.
//!
//! The glam-rs results themselves are checked by `golden_quat.cairo` (generated by `tools/refgen`
//! with `DQuat` as the oracle); this file pins the bit-exact fixed-point semantics: the floor
//! rescale of the fused kernels, the round-to-nearest shared reciprocal and the re-derived
//! thresholds of the singular branches.

use core::hash::{HashStateExTrait, HashStateTrait};
use core::poseidon::PoseidonTrait;
use fixed::fixed::{Fixed, FixedTrait};
use glam::mat3::{Mat3Trait, mat3};
use glam::mat4::Mat4Trait;
use glam::quat::{Quat, QuatTrait, quat};
use glam::vec2::{Vec2, Vec2Trait, vec2};
use glam::vec3::{Vec3, Vec3Trait, vec3};
use glam::vec4::vec4;

/// A `Fixed` from its raw Q32.32 value (every table cell is a raw value).
fn f(raw: i64) -> Fixed {
    FixedTrait::from_raw(raw)
}

fn hash(q: Quat) -> felt252 {
    PoseidonTrait::new().update_with(q).finalize()
}

// Readers of the table rows (`[i64; W]`): the value of a column at an offset.

fn fx(r: Span<i64>, o: u32) -> Fixed {
    f(*r[o])
}

fn bl(r: Span<i64>, o: u32) -> bool {
    *r[o] != 0
}

fn qt(r: Span<i64>, o: u32) -> Quat {
    quat(fx(r, o), fx(r, o + 1), fx(r, o + 2), fx(r, o + 3))
}

fn vc(r: Span<i64>, o: u32) -> Vec3 {
    vec3(fx(r, o), fx(r, o + 1), fx(r, o + 2))
}

fn v2(r: Span<i64>, o: u32) -> Vec2 {
    vec2(fx(r, o), fx(r, o + 1))
}

// Fuzz helpers.

/// A unit quaternion from four raw fuzz inputs: a rotation of `|d| mod tau` around the
/// normalized `(a, b, c)` (the X axis when it is zero).
fn unit_q(a: i64, b: i64, c: i64, d: i64) -> Quat {
    let axis = vec3(f(a % 0x400000000), f(b % 0x400000000), f(c % 0x400000000))
        .normalize_or(Vec3Trait::X);
    QuatTrait::from_axis_angle(axis, f(d % 26986075409))
}

/// `|q.length_squared() - 1|`, in raw ULP.
fn drift(q: Quat) -> i64 {
    let d = q.length_squared().to_raw() - 0x100000000;
    if d < 0 {
        -d
    } else {
        d
    }
}

#[test]
fn test_new_array_tuple() {
    let q = QuatTrait::from_xyzw(f(1), f(2), f(3), f(4));
    assert_eq!(q.x, f(1));
    assert_eq!(q.y, f(2));
    assert_eq!(q.z, f(3));
    assert_eq!(q.w, f(4));
    assert_eq!(q, quat(f(1), f(2), f(3), f(4)));
    let a = [f(1), f(2), f(3), f(4)];
    assert_eq!(QuatTrait::from_array(a), q);
    let from_array: Quat = a.into();
    assert_eq!(from_array, q);
    let to_array: [Fixed; 4] = q.into();
    assert_eq!(to_array, a);
    assert_eq!(q.to_array(), a);
    let tu = (f(1), f(2), f(3), f(4));
    let from_tuple: Quat = tu.into();
    assert_eq!(from_tuple, q);
    let to_tuple: (Fixed, Fixed, Fixed, Fixed) = q.into();
    assert_eq!(to_tuple, tu);
    let v = vec4(f(1), f(2), f(3), f(4));
    assert_eq!(QuatTrait::from_vec4(v), q);
    let from_vec4: Quat = v.into();
    assert_eq!(from_vec4, q);
    let to_vec4: glam::vec4::Vec4 = q.into();
    assert_eq!(to_vec4, v);
    assert_eq!(q.xyz(), vec3(f(1), f(2), f(3)));
}

#[test]
fn test_consts() {
    assert_eq!(QuatTrait::ZERO, quat(f(0), f(0), f(0), f(0)));
    assert_eq!(QuatTrait::IDENTITY, quat(f(0), f(0), f(0), f(0x100000000)));
    // `Default` is the identity, not the zero quaternion.
    assert_eq!(Default::<Quat>::default(), QuatTrait::IDENTITY);
    assert!(QuatTrait::IDENTITY.is_normalized());
    assert!(QuatTrait::IDENTITY.is_near_identity());
    assert_eq!(QuatTrait::IDENTITY.length(), f(0x100000000));
    assert_eq!(QuatTrait::ZERO.length(), f(0));
}
