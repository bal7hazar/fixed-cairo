#[test]
fn test_lerp_slerp_ends() {
    let a = quat(f(393604950), f(787209899), f(1180814849), f(4034575081));
    let b = quat(f(-1747086207), f(873543103), f(3494172412), f(1556314705));
    // `s = 0` and `s = 1` reproduce the ends within the normalization of the result (both are
    // unit quaternions already, so only their own drift shows).
    assert!(a.lerp(b, f(0)).abs_diff_eq(a, f(1)));
    assert!(a.lerp(b, f(0x100000000)).abs_diff_eq(b, f(1)));
    assert!(a.slerp(b, f(0)).abs_diff_eq(a, f(2)));
    assert!(a.slerp(b, f(0x100000000)).abs_diff_eq(b, f(2)));
    // Halfway, both interpolations agree to 1.6e3 ULP (the accuracy the `NEAR_ONE` band is
    // derived for), and slerp keeps the length.
    let h = f(0x80000000);
    assert!(a.lerp(b, h).abs_diff_eq(a.slerp(b, h), f(1600)));
    assert!(a.slerp(b, h).is_normalized());
    // The identity is the neutral end of an interpolation towards itself.
    assert!(a.slerp(a, h).abs_diff_eq(a, f(2)));
}
