#[test]
fn test_from_angle() {
    let a = f(0x59999999);
    let (s, c) = a.sin_cos();
    assert_eq!(Mat2Trait::from_angle(a), mat2(vec2(c, s), vec2(-s, c)));
    let scale = vec2(f(0x200000000), f(0x300000000));
    assert_eq!(
        Mat2Trait::from_scale_angle(scale, a),
        mat2(vec2(c * scale.x, s * scale.x), vec2((-s) * scale.y, c * scale.y)),
    );
    // a quarter turn is exact up to the 1 ULP of `sin_cos` at `FRAC_PI_2`
    let q = Mat2Trait::from_angle(fixed::fixed::FRAC_PI_2);
    assert!(q.abs_diff_eq(mat2(vec2(f(0), f(0x100000000)), vec2(f(-0x100000000), f(0))), f(2)));
    assert!(q.mul_vec2(vec2(f(0x100000000), f(0))).abs_diff_eq(vec2(f(0), f(0x100000000)), f(2)));
    assert!(Mat2Trait::from_angle(f(0)).abs_diff_eq(Mat2Trait::IDENTITY, f(0)));
}

