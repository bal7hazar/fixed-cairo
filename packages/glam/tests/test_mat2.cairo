#[test]
fn test_arith() {
    for row in ARITH.span() {
        let r = row.span();
        assert_eq!(mx(r, 0) + mx(r, 4), mx(r, 9));
        assert_eq!(mx(r, 0).add_mat2(mx(r, 4)), mx(r, 9));
        assert_eq!(mx(r, 0) - mx(r, 4), mx(r, 13));
        assert_eq!(mx(r, 0).sub_mat2(mx(r, 4)), mx(r, 13));
        assert_eq!(-mx(r, 0), mx(r, 17));
        assert_eq!(mx(r, 0).mul_scalar(fx(r, 8)), mx(r, 21));
        assert_eq!(mx(r, 0).div_scalar(fx(r, 8)), mx(r, 25));
        assert_eq!(mx(r, 0).abs(), mx(r, 29));
        assert_eq!(mx(r, 0).mul_diagonal_scale(vc(r, 33)), mx(r, 35));
        assert_eq!(
            mx(r, 0).mul_diagonal_scale(vc(r, 33)),
            mx(r, 0).mul_mat2(Mat2Trait::from_diagonal(vc(r, 33))),
        );
        let mut p = mx(r, 0);
        p += mx(r, 4);
        assert_eq!(p, mx(r, 9));
        let mut p = mx(r, 0);
        p -= mx(r, 4);
        assert_eq!(p, mx(r, 13));
        let mut p = mx(r, 0);
        p *= fx(r, 8);
        assert_eq!(p, mx(r, 21));
        let mut p = mx(r, 0);
        p /= fx(r, 8);
        assert_eq!(p, mx(r, 25));
        assert!(mx(r, 0).abs_diff_eq(mx(r, 0), f(0)));
    }
}
