#[test]
#[fuzzer(runs: 128, seed: 401)]
fn fuzz_layout_ops(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let y = mb(a, b, c, d);
    assert_eq!(x.transpose().transpose(), x);
    assert_eq!(Mat2Trait::from_cols_array(x.to_cols_array()), x);
    assert_eq!(Mat2Trait::from_rows_array(x.to_rows_array()), x);
    assert_eq!(Mat2Trait::from_cols_array_2d(x.to_cols_array_2d()), x);
    assert_eq!(Mat2Trait::from_rows(x.row(0), x.row(1)), x);
    assert_eq!(Mat2Trait::from_cols(x.col(0), x.col(1)), x);
    assert_eq!(x.col(0), x.transpose().row(0));
    assert_eq!((x + y) - y, x);
    assert_eq!(x + y, y + x);
    assert_eq!(x - y, x + (-y));
    assert_eq!(-(-x), x);
    assert_eq!(x.add_mat2(y), x + y);
    assert_eq!(x.sub_mat2(y), x - y);
    assert_eq!(x.mul_scalar(f(0x100000000)), x);
    assert_eq!(x.abs().abs(), x.abs());
    assert!(x.abs_diff_eq(x, f(0)));
}

#[test]
#[fuzzer(runs: 128, seed: 402)]
fn fuzz_mul_vec(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let v = va(a, b, c, d);
    let w = vb(a, b, c, d);
    assert_eq!(Mat2Trait::IDENTITY.mul_vec2(v), v);
    assert_eq!(x.mul_vec2(Vec2Trait::ZERO), Vec2Trait::ZERO);
    assert_eq!(x.mul_transpose_vec2(v), x.transpose().mul_vec2(v));
    // one floor rescale per component on each side: the two differ by at most 1 ULP
    assert!(x.mul_vec2(v + w).abs_diff_eq(x.mul_vec2(v) + x.mul_vec2(w), f(1)));
    assert_eq!(Mat2Trait::from_diagonal(v).mul_vec2(w), v * w);
    assert_eq!(Mat2Trait::from_diagonal(v).diagonal(), v);
}

#[test]
#[fuzzer(runs: 128, seed: 403)]
fn fuzz_mul_mat(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let y = mb(a, b, c, d);
    let v = va(a, b, c, d);
    assert_eq!(x * Mat2Trait::IDENTITY, x);
    assert_eq!(Mat2Trait::IDENTITY * x, x);
    assert_eq!(x * Mat2Trait::ZERO, Mat2Trait::ZERO);
    assert_eq!(x.mul_mat2(y), x * y);
    assert_eq!((x * y).transpose(), y.transpose() * x.transpose());
    let mut p = x;
    p *= y;
    assert_eq!(p, x * y);
    // (x * y) * v and x * (y * v) floor twice each, with factors of at most 8:
    // |diff| <= 2 * (8 * 2 + 1) ULP
    assert!((x * y).mul_vec2(v).abs_diff_eq(x.mul_vec2(y.mul_vec2(v)), f(34)));
}

#[test]
#[fuzzer(runs: 128, seed: 404)]
fn fuzz_determinant(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let v = va(a, b, c, d);
    assert_eq!(Mat2Trait::IDENTITY.determinant(), f(0x100000000));
    assert_eq!(Mat2Trait::ZERO.determinant(), f(0));
    // the determinant of the transpose is the same sum of products, in the same order of
    // accumulation: it is bit-identical
    assert_eq!(x.transpose().determinant(), x.determinant());
    // two equal columns make the matrix singular
    let s = Mat2Trait::from_cols(v, v);
    assert_eq!(s.determinant(), f(0));
    assert_eq!(s.try_inverse(), None);
}

#[test]
#[fuzzer(runs: 128, seed: 405)]
fn fuzz_inverse(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let d = x.determinant();
    if d.abs() >= f(0x100000000) {
        let inv = x.inverse();
        assert_eq!(x.try_inverse(), Some(inv));
        assert_eq!(x.inverse_or_zero(), inv);
        // each element of the inverse is the floored adjugate element (1 ULP) divided
        // once (< 1 ULP), plus the propagated error of the floored determinant
        // (|inverse| <= 8 ULP for |det| >= 1); the product multiplies that by
        // |element| <= 8 and floors once: |diff| <= 8 * 2 * (8 + 2) + 1
        assert!(x.mul_mat2(inv).abs_diff_eq(Mat2Trait::IDENTITY, f(161)));
    } else if d == f(0) {
        assert_eq!(x.try_inverse(), None);
        assert_eq!(x.inverse_or_zero(), Mat2Trait::ZERO);
    }
}

#[test]
#[fuzzer(runs: 128, seed: 406)]
fn fuzz_transform(a: i64, b: i64, c: i64, d: i64) {
    let x = ma(a, b, c, d);
    let v = va(a, b, c, d);
    let r = Mat2Trait::from_angle(f(0x59999999));
    // a rotation preserves the determinant (1) and the length, up to `sin_cos`
    assert!(r.determinant().abs_diff_eq(f(0x100000000), f(4)));
    assert!(r.mul_vec2(v).length().abs_diff_eq(v.length(), f(8)));
    assert_eq!(Mat2Trait::from_scale_angle(Vec2Trait::ONE, f(0x59999999)), r);
    // det(x * r) = det(x) * det(r): the product floors each element (<= 2 * 8 * 8
    // ULP on the determinant) and det(r) is 1 within 4 ULP (|det(x)| <= 128)
    assert!((x * r).determinant().abs_diff_eq(x.determinant(), f(1024)));
}
