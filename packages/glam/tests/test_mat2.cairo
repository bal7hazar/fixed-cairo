    for row in DET_INVERSE.span() {
        let r = row.span();
        assert_eq!(mx(r, 0).determinant(), fx(r, 4));
        assert_eq!(mx(r, 0).transpose().determinant(), fx(r, 5));
        assert_eq!(mx(r, 0).try_inverse(), om(r, 6));
        if let Some(k) = om(r, 6) {
            assert_eq!(mx(r, 0).inverse(), k);
            assert_eq!(mx(r, 0).inverse_or_zero(), k);
            assert_eq!(mx(r, 0).mul_mat2(k), mx(r, 11));
            if bl(r, 15) {
                assert!(mx(r, 11).abs_diff_eq(Mat2Trait::IDENTITY, IDENTITY_EPS));
            }
        } else {
            assert_eq!(mx(r, 0).inverse_or_zero(), Mat2Trait::ZERO);
        }
    }
}
