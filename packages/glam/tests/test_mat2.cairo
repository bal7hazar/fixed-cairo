#[test]
fn test_consts_and_layout() {
    let m = Mat2Trait::from_cols_array(
        [f(6442450944), f(-2147483648), f(536870912), f(8589934592)],
    );
    assert_eq!(Mat2Trait::ZERO, Mat2Trait::from_cols_array([f(0), f(0), f(0), f(0)]));
    assert_eq!(
        Mat2Trait::IDENTITY, Mat2Trait::from_cols_array([f(4294967296), f(0), f(0), f(4294967296)]),
    );
    assert_eq!(Default::<Mat2>::default(), Mat2Trait::IDENTITY);
    let cols = m.to_cols_array();
    assert_eq!(Mat2Trait::from_cols_array(cols), m);
    assert_eq!(Mat2Trait::from_cols_array_2d(m.to_cols_array_2d()), m);
    assert_eq!(Mat2Trait::from_rows_array(m.to_rows_array()), m);
    assert_eq!(m.to_rows_array(), m.transpose().to_cols_array());
    let into: [Fixed; 4] = m.into();
    assert_eq!(into, cols);
    let back: Mat2 = into.into();
    assert_eq!(back, m);
    let into2: [[Fixed; 2]; 2] = m.into();
    let back2: Mat2 = into2.into();
    assert_eq!(back2, m);
    assert_eq!(mat2(m.x_axis, m.y_axis), m);
    assert_eq!(Mat2Trait::from_cols(m.x_axis, m.y_axis), m);
    assert_eq!(Mat2Trait::from_rows(m.row(0), m.row(1)), m);
    assert_eq!(m.col(0), m.x_axis);
    assert_eq!(m.col(1), m.y_axis);
    assert_eq!(m.row(0), m.transpose().col(0));
    assert_eq!(m.row(1), m.transpose().col(1));
    assert_eq!(
        Mat2Trait::from_diagonal(m.diagonal()),
        Mat2Trait::from_cols_array([f(6442450944), f(0), f(0), f(8589934592)]),
    );
}

