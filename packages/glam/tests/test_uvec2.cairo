#[test]
#[fuzzer(runs: 256, seed: 2501)]
fn fuzz_wrapping_checked_saturating(a: u32, b: u32, c: u32, d: u32) {
    let va = uvec2(a, b);
    let vb = uvec2(c, d);
    let exact = [wide(a) + wide(c), wide(b) + wide(d)];
    assert_eq!(va.wrapping_add(vb).to_array(), map_wrap(exact));
    assert_eq!(va.saturating_add(vb).to_array(), map_sat(exact));
    assert_eq!(va.checked_add(vb), map_checked(exact));
    let exact = [wide(a) - wide(c), wide(b) - wide(d)];
    assert_eq!(va.wrapping_sub(vb).to_array(), map_wrap(exact));
    assert_eq!(va.saturating_sub(vb).to_array(), map_sat(exact));
    assert_eq!(va.checked_sub(vb), map_checked(exact));
    let exact = [wide(a) * wide(c), wide(b) * wide(d)];
    assert_eq!(va.wrapping_mul(vb).to_array(), map_wrap(exact));
    assert_eq!(va.saturating_mul(vb).to_array(), map_sat(exact));
    assert_eq!(va.checked_mul(vb), map_checked(exact));
    // mixed signedness: the other-signedness operand is `vb` reinterpreted
    let ub = vb.as_ivec2();
    let [ux, uy] = ub.to_array();
    let exact = [wide(a) + wide_o(ux), wide(b) + wide_o(uy)];
    assert_eq!(va.wrapping_add_signed(ub).to_array(), map_wrap(exact));
    assert_eq!(va.saturating_add_signed(ub).to_array(), map_sat(exact));
    assert_eq!(va.checked_add_signed(ub), map_checked(exact));
}

#[test]
#[fuzzer(runs: 256, seed: 2502)]
fn fuzz_min_max_clamp_select_cmp_distances(a: u32, b: u32, c: u32, d: u32) {
    let va = uvec2(a, b);
    let vb = uvec2(c, d);
    let lo = va.min(vb);
    let hi = va.max(vb);
    assert!(lo.cmple(hi).all());
    assert!(lo.cmple(va).all() && lo.cmple(vb).all());
    assert!(hi.cmpge(va).all() && hi.cmpge(vb).all());
    assert_eq!(UVec2Trait::select(va.cmplt(vb), va, vb), lo);
    assert_eq!(UVec2Trait::select(va.cmpgt(vb), va, vb), hi);
    assert_eq!(va.cmpeq(vb), !va.cmpne(vb));
    assert_eq!(va.cmpge(vb), !va.cmplt(vb));
    assert_eq!(va.cmple(vb), !va.cmpgt(vb));
    let vc = uvec2(d, a);
    assert_eq!(vc.clamp(lo, hi), vc.max(lo).min(hi));
    assert!(lo.min_element() <= lo.max_element());
    assert_eq!(va[va.min_position()], va.min_element());
    assert_eq!(va[va.max_position()], va.max_element());
    let d = [abs_wide(wide(a) - wide(c)), abs_wide(wide(b) - wide(d))];
    let [dx, dy] = d;
    let sum = dx + dy;
    let expected: Option<u32> = sum.try_into();
    assert_eq!(va.checked_manhattan_distance(vb), expected);
    assert_eq!(vb.checked_manhattan_distance(va), expected);
    let mut m = dx;
    if dy > m {
        m = dy;
    }
    assert_eq!(wide_u(va.chebyshev_distance(vb)), m);
}

#[test]
#[fuzzer(runs: 256, seed: 2504)]
fn fuzz_dot_casts_bits_shifts(a: u32, b: u32, c: u32, d: u32, k: u32) {
    // 14-bit operands: nothing overflows
    let va = uvec2(a / 0x40000, b / 0x40000);
    let vb = uvec2(c / 0x40000, d / 0x40000);
    let expected = wide(a / 0x40000) * wide(c / 0x40000) + wide(b / 0x40000) * wide(d / 0x40000);
    assert_eq!(wide(va.dot(vb)), expected);
    assert_eq!(va.dot(vb), vb.dot(va));
    assert_eq!(va.length_squared(), va.dot(va));
    assert_eq!(wide(va.element_sum()), wide(a / 0x40000) + wide(b / 0x40000));
    let tiny = uvec2(a / 0x1000000, b / 0x1000000);
    assert_eq!(wide(tiny.element_product()), wide(a / 0x1000000) * wide(b / 0x1000000));
    let va = uvec2(a, b);
    let vb = uvec2(b, a);
    assert_eq!(va.as_ivec2().as_uvec2(), va);
    assert_eq!(wide_o(va.as_ivec2().x), wrap_o(wide(a)));
    // (a & b) + (a | b) == a + b and (a ^ b) + 2 * (a & b) == a + b
    assert_eq!(wide((va & vb).x) + wide((va | vb).x), wide(a) + wide(b));
    assert_eq!(wide((va ^ vb).x) + 2 * wide((va & vb).x), wide(a) + wide(b));
    assert_eq!((va ^ vb) ^ vb, va);
    assert_eq!(~(va & vb), ~va | ~vb);
    assert_eq!(wide((~va).x), -1 - wide(a) + 0x100000000);
    let k = k % 32;
    let p = pow2(k);
    assert_eq!(wide(va.shl(k).x), wrap(wide(a) * p));
    assert_eq!(wide(va.shr(k).x), floor_div(wide(a), p));
}

#[test]
#[fuzzer(runs: 256, seed: 2506)]
fn fuzz_div_rem(a: u32, b: u32, c: u32, d: u32) {
    let va = uvec2(a, b);
    let vb = uvec2(nz(c), nz(d));
    let q = va / vb;
    let r = va % vb;
    assert!(r.cmplt(vb).all());
    for i in 0..2_usize {
        assert_eq!(wide(q[i]) * wide(vb[i]) + wide(r[i]), wide(va[i]));
    }
    assert_eq!(va.wrapping_div(vb), q);
    assert_eq!(va.saturating_div(vb), q);
    assert_eq!(va.checked_div(vb), Some(q));
}
