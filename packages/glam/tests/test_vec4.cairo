fn test_consts() {
    assert_eq!(Vec4Trait::ZERO, vec4(f(0), f(0), f(0), f(0)));
    assert_eq!(Vec4Trait::ONE, vec4(f(4294967296), f(4294967296), f(4294967296), f(4294967296)));
    assert_eq!(
        Vec4Trait::NEG_ONE, vec4(f(-4294967296), f(-4294967296), f(-4294967296), f(-4294967296)),
    );
    assert_eq!(
        Vec4Trait::MIN,
        vec4(
            f(-9223372036854775808),
            f(-9223372036854775808),
            f(-9223372036854775808),
            f(-9223372036854775808),
        ),
    );
    assert_eq!(
        Vec4Trait::MAX,
        vec4(
            f(9223372036854775807),
            f(9223372036854775807),
            f(9223372036854775807),
            f(9223372036854775807),
        ),
    );
    assert_eq!(Vec4Trait::X, vec4(f(4294967296), f(0), f(0), f(0)));
    assert_eq!(Vec4Trait::Y, vec4(f(0), f(4294967296), f(0), f(0)));
    assert_eq!(Vec4Trait::Z, vec4(f(0), f(0), f(4294967296), f(0)));
    assert_eq!(Vec4Trait::W, vec4(f(0), f(0), f(0), f(4294967296)));
    assert_eq!(Vec4Trait::NEG_X, vec4(f(-4294967296), f(0), f(0), f(0)));
    assert_eq!(Vec4Trait::NEG_Y, vec4(f(0), f(-4294967296), f(0), f(0)));
    assert_eq!(Vec4Trait::NEG_Z, vec4(f(0), f(0), f(-4294967296), f(0)));
    assert_eq!(Vec4Trait::NEG_W, vec4(f(0), f(0), f(0), f(-4294967296)));
    let [ax, ay, az, aw] = Vec4Trait::AXES;
    assert_eq!(ax, Vec4Trait::X);
    assert_eq!(ay, Vec4Trait::Y);
    assert_eq!(az, Vec4Trait::Z);
    assert_eq!(aw, Vec4Trait::W);
}

