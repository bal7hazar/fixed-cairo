    let a = vec4(f(4294967296), f(4294967296), f(4294967296), f(4294967296));
    let b = vec4(f(8589934592), f(8589934592), f(8589934592), f(8589934592));
    assert!(a.cmplt(b).all() && a.cmple(b).all() && b.cmpgt(a).all() && b.cmpge(a).all());
    assert!(a.cmpne(b).all() && a.cmpeq(a).all() && !a.cmpeq(b).any() && !a.cmplt(a).any());
    assert!(a == a && a != b);
}
