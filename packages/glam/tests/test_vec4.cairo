#[test]
fn test_normalize_axes() {
    assert_eq!(Vec4Trait::X.normalize(), Vec4Trait::X);
    assert_eq!(Vec4Trait::Y.normalize(), Vec4Trait::Y);
    assert_eq!(Vec4Trait::Z.normalize(), Vec4Trait::Z);
    assert_eq!(Vec4Trait::W.normalize(), Vec4Trait::W);
    assert_eq!(Vec4Trait::NEG_X.normalize(), Vec4Trait::NEG_X);
    assert_eq!(Vec4Trait::NEG_Y.normalize(), Vec4Trait::NEG_Y);
    assert_eq!(Vec4Trait::NEG_Z.normalize(), Vec4Trait::NEG_Z);
    assert_eq!(Vec4Trait::NEG_W.normalize(), Vec4Trait::NEG_W);
    assert!(Vec4Trait::X.is_normalized());
    assert!(Vec4Trait::Y.is_normalized());
    assert!(Vec4Trait::Z.is_normalized());
    assert!(Vec4Trait::W.is_normalized());
    assert!(!Vec4Trait::ONE.is_normalized());
    assert!(!Vec4Trait::ZERO.is_normalized());
    assert!(Vec4Trait::ONE.normalize().is_normalized());
}

#[test]
fn test_is_normalized_threshold_and_long_vectors() {
    // The floored squared lengths are 1 - 1025, 1 - 1024, 1 + 1024 and 1 + 1025 ULP.
    assert!(!vec4(f(4294966783), f(65536), f(0), f(0)).is_normalized());
    assert!(vec4(f(4294966784), f(0), f(0), f(0)).is_normalized());
    assert!(vec4(f(4294967808), f(0), f(0), f(0)).is_normalized());
    assert!(!vec4(f(4294967808), f(65536), f(0), f(0)).is_normalized());
    assert!(!Vec4Trait::MAX.is_normalized());
    assert!(!Vec4Trait::MIN.is_normalized());
}
