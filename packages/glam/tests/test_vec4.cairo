#[test]
fn test_ops() {
    for row in OPS.span() {
        let r = row.span();
        assert_eq!(vc(r, 0) + vc(r, 4), vc(r, 13));
        assert_eq!(vc(r, 0) - vc(r, 4), vc(r, 17));
        assert_eq!(vc(r, 0) * vc(r, 4), vc(r, 21));
        assert_eq!(vc(r, 0) / vc(r, 4), vc(r, 25));
        assert_eq!(vc(r, 0) % vc(r, 4), vc(r, 29));
        assert_eq!(vc(r, 0).add_scalar(fx(r, 8)), vc(r, 33));
        assert_eq!(vc(r, 0).sub_scalar(fx(r, 8)), vc(r, 37));
        assert_eq!(vc(r, 0).mul_scalar(fx(r, 8)), vc(r, 41));
        assert_eq!(vc(r, 0).div_scalar(fx(r, 8)), vc(r, 45));
        assert_eq!(vc(r, 0).rem_scalar(fx(r, 8)), vc(r, 49));
        assert_eq!(-vc(r, 0), vc(r, 9));
        assert_eq!(-(-vc(r, 0)), vc(r, 0));
        let mut v = vc(r, 0);
        v += vc(r, 4);
        assert_eq!(v, vc(r, 13));
        let mut v = vc(r, 0);
        v += fx(r, 8);
        assert_eq!(v, vc(r, 33));
        let mut v = vc(r, 0);
        v -= vc(r, 4);
        assert_eq!(v, vc(r, 17));
        let mut v = vc(r, 0);
        v -= fx(r, 8);
        assert_eq!(v, vc(r, 37));
        let mut v = vc(r, 0);
        v *= vc(r, 4);
        assert_eq!(v, vc(r, 21));
        let mut v = vc(r, 0);
        v *= fx(r, 8);
        assert_eq!(v, vc(r, 41));
        let mut v = vc(r, 0);
        v /= vc(r, 4);
        assert_eq!(v, vc(r, 25));
        let mut v = vc(r, 0);
        v /= fx(r, 8);
        assert_eq!(v, vc(r, 45));
        let mut v = vc(r, 0);
        v %= vc(r, 4);
        assert_eq!(v, vc(r, 29));
        let mut v = vc(r, 0);
        v %= fx(r, 8);
        assert_eq!(v, vc(r, 49));
    }
}
