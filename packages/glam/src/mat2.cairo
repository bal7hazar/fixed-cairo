    fn abs_diff_eq(self: Mat2, rhs: Mat2, max_abs_diff: Fixed) -> bool {
        Vec2Trait::abs_diff_eq(self.x_axis, rhs.x_axis, max_abs_diff)
            && Vec2Trait::abs_diff_eq(self.y_axis, rhs.y_axis, max_abs_diff)
    }

    #[inline(always)]
    fn from_angle(angle: Fixed) -> Mat2 {
        let (sin, cos) = angle.sin_cos();
        Mat2 { x_axis: Vec2 { x: cos, y: sin }, y_axis: Vec2 { x: -sin, y: cos } }
    }

    #[inline(always)]
    fn from_scale_angle(scale: Vec2, angle: Fixed) -> Mat2 {
        let (sin, cos) = angle.sin_cos();
        Mat2 {
            x_axis: Vec2 { x: cos * scale.x, y: sin * scale.x },
            y_axis: Vec2 { x: (-sin) * scale.y, y: cos * scale.y },
        }
    }

    #[inline(always)]
    fn from_mat3(m: Mat3) -> Mat2 {
        Mat2 { x_axis: Vec3Trait::truncate(m.x_axis), y_axis: Vec3Trait::truncate(m.y_axis) }
    }

    #[inline(always)]
    fn from_mat3_minor(m: Mat3, i: usize, j: usize) -> Mat2 {
        match i {
            0 => match j {
                0 => Mat2 {
                    x_axis: Vec2 { x: m.y_axis.y, y: m.y_axis.z },
                    y_axis: Vec2 { x: m.z_axis.y, y: m.z_axis.z },
                },
                1 => Mat2 {
                    x_axis: Vec2 { x: m.y_axis.x, y: m.y_axis.z },
                    y_axis: Vec2 { x: m.z_axis.x, y: m.z_axis.z },
                },
                2 => Mat2 {
                    x_axis: Vec2 { x: m.y_axis.x, y: m.y_axis.y },
                    y_axis: Vec2 { x: m.z_axis.x, y: m.z_axis.y },
                },
                _ => core::panic_with_felt252('Mat2: index out of bounds'),
            },
            1 => match j {
                0 => Mat2 {
                    x_axis: Vec2 { x: m.x_axis.y, y: m.x_axis.z },
                    y_axis: Vec2 { x: m.z_axis.y, y: m.z_axis.z },
                },
                1 => Mat2 {
                    x_axis: Vec2 { x: m.x_axis.x, y: m.x_axis.z },
                    y_axis: Vec2 { x: m.z_axis.x, y: m.z_axis.z },
                },
                2 => Mat2 {
                    x_axis: Vec2 { x: m.x_axis.x, y: m.x_axis.y },
                    y_axis: Vec2 { x: m.z_axis.x, y: m.z_axis.y },
                },
                _ => core::panic_with_felt252('Mat2: index out of bounds'),
            },
            2 => match j {
                0 => Mat2 {
                    x_axis: Vec2 { x: m.x_axis.y, y: m.x_axis.z },
                    y_axis: Vec2 { x: m.y_axis.y, y: m.y_axis.z },
                },
                1 => Mat2 {
                    x_axis: Vec2 { x: m.x_axis.x, y: m.x_axis.z },
                    y_axis: Vec2 { x: m.y_axis.x, y: m.y_axis.z },
                },
                2 => Mat2 {
                    x_axis: Vec2 { x: m.x_axis.x, y: m.x_axis.y },
                    y_axis: Vec2 { x: m.y_axis.x, y: m.y_axis.y },
                },
                _ => core::panic_with_felt252('Mat2: index out of bounds'),
            },
            _ => core::panic_with_felt252('Mat2: index out of bounds'),
        }
    }
}

