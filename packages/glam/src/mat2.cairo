/// The shared body of `inverse`, `try_inverse` and `inverse_or_zero`: the adjugate through the
/// fused kernels of `fixed::wide`, then ONE division (`Recip`) for the 4 elements. `None` when
/// the determinant is zero, which is the definition of singular here (docs/DESIGN.md section 3).
#[inline(always)]
fn inverse_checked(m: Mat2) -> Option<Mat2> {
    let det = mul_sub(m.x_axis.x, m.y_axis.y, m.x_axis.y, m.y_axis.x);
    if det == F_ZERO {
        return None;
    }
    let r = RecipTrait::new(det);
    Some(
        Mat2 {
            x_axis: Vec2 { x: r.mul(m.y_axis.y), y: r.mul(-m.x_axis.y) },
            y_axis: Vec2 { x: r.mul(-m.y_axis.x), y: r.mul(m.x_axis.x) },
        },
    )
}

/// `0`.
const F_ZERO: Fixed = Fixed { raw: 0 };
