            Self::ZERO
        } else {
            let f = mul_add(eta, n_dot_i, k.sqrt());
            Vec4 {
                x: mul_sub(eta, self.x, f, normal.x),
                y: mul_sub(eta, self.y, f, normal.y),
                z: mul_sub(eta, self.z, f, normal.z),
                w: mul_sub(eta, self.w, f, normal.w),
            }
        }
    }

    #[inline(always)]
    fn lerp(self: Vec4, rhs: Vec4, s: Fixed) -> Vec4 {
        Vec4 {
            x: self.x.lerp(rhs.x, s),
            y: self.y.lerp(rhs.y, s),
            z: self.z.lerp(rhs.z, s),
            w: self.w.lerp(rhs.w, s),
        }
    }

    #[inline(always)]
    fn move_towards(self: Vec4, rhs: Vec4, d: Fixed) -> Vec4 {
        let a = rhs - self;
        let n = norm4_wide(a.x, a.y, a.z, a.w);
        if n.is_zero() || n.to_fixed() <= d {
            rhs
        } else {
            let k = n.recip().mul(d);
            Vec4 {
                x: mul_add(a.x, k, self.x),
                y: mul_add(a.y, k, self.y),
                z: mul_add(a.z, k, self.z),
                w: mul_add(a.w, k, self.w),
            }
        }
    }

    #[inline(always)]
    fn midpoint(self: Vec4, rhs: Vec4) -> Vec4 {
        Vec4 {
            x: self.x.lerp(rhs.x, F_HALF),
            y: self.y.lerp(rhs.y, F_HALF),
            z: self.z.lerp(rhs.z, F_HALF),
            w: self.w.lerp(rhs.w, F_HALF),
        }
    }

    #[inline(always)]
    fn mul_add(self: Vec4, a: Vec4, b: Vec4) -> Vec4 {
        Vec4 {
            x: mul_add(self.x, a.x, b.x),
            y: mul_add(self.y, a.y, b.y),
            z: mul_add(self.z, a.z, b.z),
            w: mul_add(self.w, a.w, b.w),
        }
    }

    #[inline(always)]
    fn abs_diff_eq(self: Vec4, rhs: Vec4, max_abs_diff: Fixed) -> bool {
        self.x.abs_diff_eq(rhs.x, max_abs_diff)
            && self.y.abs_diff_eq(rhs.y, max_abs_diff)
            && self.z.abs_diff_eq(rhs.z, max_abs_diff)
            && self.w.abs_diff_eq(rhs.w, max_abs_diff)
    }

    #[inline(always)]
    fn clamp_length(self: Vec4, min: Fixed, max: Fixed) -> Vec4 {
        let n = norm4_wide(self.x, self.y, self.z, self.w);
        let len = n.to_fixed();
        if len < min {
            scaled(self, n, min)
        } else if len > max {
            scaled(self, n, max)
        } else {
            self
        }
    }

    #[inline(always)]
    fn clamp_length_max(self: Vec4, max: Fixed) -> Vec4 {
        let n = norm4_wide(self.x, self.y, self.z, self.w);
        if n.to_fixed() > max {
            scaled(self, n, max)
        } else {
            self
        }
    }

    #[inline(always)]
    fn clamp_length_min(self: Vec4, min: Fixed) -> Vec4 {
        let n = norm4_wide(self.x, self.y, self.z, self.w);
        if n.to_fixed() < min {
            scaled(self, n, min)
        } else {
            self
        }
    }

    #[inline(always)]
    fn add_scalar(self: Vec4, rhs: Fixed) -> Vec4 {
        Vec4 { x: self.x + rhs, y: self.y + rhs, z: self.z + rhs, w: self.w + rhs }
    }

    #[inline(always)]
    fn sub_scalar(self: Vec4, rhs: Fixed) -> Vec4 {
        Vec4 { x: self.x - rhs, y: self.y - rhs, z: self.z - rhs, w: self.w - rhs }
    }

    #[inline(always)]
    fn mul_scalar(self: Vec4, rhs: Fixed) -> Vec4 {
        Vec4 { x: self.x * rhs, y: self.y * rhs, z: self.z * rhs, w: self.w * rhs }
    }

    #[inline(always)]
    fn div_scalar(self: Vec4, rhs: Fixed) -> Vec4 {
        let r = RecipTrait::new(rhs);
        Vec4 { x: r.mul(self.x), y: r.mul(self.y), z: r.mul(self.z), w: r.mul(self.w) }
    }

    #[inline(always)]
    fn rem_scalar(self: Vec4, rhs: Fixed) -> Vec4 {
        Vec4 { x: self.x % rhs, y: self.y % rhs, z: self.z % rhs, w: self.w % rhs }
    }

    #[inline(always)]
    fn as_ivec4(self: Vec4) -> IVec4 {
        IVec4 {
            x: self.x.to_int_trunc(),
            y: self.y.to_int_trunc(),
            z: self.z.to_int_trunc(),
            w: self.w.to_int_trunc(),
        }
    }

    #[inline(always)]
    fn as_uvec4(self: Vec4) -> UVec4 {
        UVec4 { x: to_u32(self.x), y: to_u32(self.y), z: to_u32(self.z), w: to_u32(self.w) }
    }
}

