    ///   is within `1 / |self|` ULP of the exact value, and an axis-aligned vector
    ///   normalizes to exactly `+-1`.
    /// * Zero is returned only for the zero vector.
    fn normalize_or_zero(self: Vec2) -> Vec2;
    /// Returns `self` normalized to length 1 and the length of `self`.
    ///
    /// If `self` is zero length then `(Self::X, 0)` is returned.
    ///
    /// Mirrors `glam::Vec2::normalize_and_length`.
    /// #### Panics
    /// * `'Fixed: overflow'` if the length does not fit the scalar range.
    /// #### Deviations
    /// * One square root and one division shared by the components, then one fused
    ///   multiplication each (rounded to nearest, ties toward +infinity): every component
    ///   is within `1 / |self|` ULP of the exact value, and an axis-aligned vector
    ///   normalizes to exactly `+-1`.
    /// * One square root shared by the normalization and the returned length.
    fn normalize_and_length(self: Vec2) -> (Vec2, Fixed);
    /// Returns whether `self` is of length `1` or not.
    ///
    /// Uses a precision threshold of `1024` raw ULP (`2^-22`) on the squared length.
    ///
    /// Mirrors `glam::Vec2::is_normalized`.
    /// #### Panics
    /// * `'Fixed: overflow'` if the result does not fit the scalar range.
    /// #### Deviations
    /// * The threshold is re-derived for Q32.32: `|length_squared - 1| <= 1024` raw ULP,
    ///   about `2.4e-7`, where glam-rs uses `2e-4` (about 1700 f32 epsilons). The squared
    ///   length of the output of `normalize` is within 5 ULP of 1, so the margin is a
    ///   hundredfold.
    /// * `'Fixed: overflow'` for `|self| >= 2^31` (`length_squared` overflows) where glam-
    ///   rs returns `false`.
    fn is_normalized(self: Vec2) -> bool;
    /// Returns the vector projection of `self` onto `rhs`.
    ///
    /// `rhs` must be of non-zero length.
    ///
    /// Mirrors `glam::Vec2::project_onto`.
    /// #### Panics
    /// * `'Fixed: division by zero'` if `rhs.dot(rhs)` is zero, i.e. if `rhs` is zero or
    ///   shorter than `2^-16` (its squared length then rounds to zero).
    /// * `'Fixed: overflow'` if the result does not fit the scalar range.
    /// #### Deviations
    /// * A single division `dot(self, rhs) / dot(rhs, rhs)` (truncated toward zero), then
    ///   one floor rescale per component. A shared `Recip` is measurably more expensive
    ///   for one division: it is kept in `benches::alt`.
    fn project_onto(self: Vec2, rhs: Vec2) -> Vec2;
    /// Returns the vector rejection of `self` from `rhs`.
    ///
    /// The vector rejection is the vector perpendicular to the projection of `self` onto
    /// `rhs`, in other words the result of `self - self.project_onto(rhs)`.
    ///
    /// `rhs` must be of non-zero length.
    ///
    /// Mirrors `glam::Vec2::reject_from`.
    /// #### Panics
    /// * `'Fixed: division by zero'` if `rhs.dot(rhs)` is zero (see `project_onto`).
    /// * `'Fixed: overflow'` if the result does not fit the scalar range.
    /// #### Deviations
    /// * One rescale per component (`self - rhs * k` fused) instead of the two of `self -
    ///   self.project_onto(rhs)`: 1 ULP more accurate and cheaper, but the two forms can
    ///   differ by 1 ULP per component.
    fn reject_from(self: Vec2, rhs: Vec2) -> Vec2;
    /// Returns the vector projection of `self` onto `rhs`.
    ///
    /// `rhs` must be normalized.
    ///
    /// Mirrors `glam::Vec2::project_onto_normalized`.
    /// #### Panics
    /// * `'Fixed: overflow'` if the result does not fit the scalar range.
    /// #### Deviations
    /// * The `rhs.is_normalized()` precondition is not checked (`glam_assert!`).
    /// * One floor rescale per component.
    fn project_onto_normalized(self: Vec2, rhs: Vec2) -> Vec2;
    /// Returns the vector rejection of `self` from `rhs`.
    ///
    /// `rhs` must be normalized.
    ///
    /// Mirrors `glam::Vec2::reject_from_normalized`.
    /// #### Panics
    /// * `'Fixed: overflow'` if the result does not fit the scalar range.
    /// #### Deviations
    /// * The `rhs.is_normalized()` precondition is not checked (`glam_assert!`).
    /// * One rescale per component (`self - rhs * dot` fused) instead of the two of `self
    ///   - self.project_onto_normalized(rhs)`: the two forms can differ by 1 ULP per
    ///   component.
    fn reject_from_normalized(self: Vec2, rhs: Vec2) -> Vec2;
    /// Returns the reflection vector for a given incident vector `self` and surface normal
    /// `normal`.
    ///
    /// `normal` must be normalized.
    ///
    /// Mirrors `glam::Vec2::reflect`.
    /// #### Panics
    /// * `'Fixed: overflow'` if the result does not fit the scalar range.
    /// * `'i64_add Overflow'` / `'i64_neg Underflow'` if `2 * self.dot(normal)` leaves the
    ///   scalar range.
    /// #### Deviations
    /// * The `normal.is_normalized()` precondition is not checked (`glam_assert!`).
    /// * One `mul_add` fused kernel per component: `self - 2 * dot * normal` with a single
    ///   floor rescale each.
    fn reflect(self: Vec2, normal: Vec2) -> Vec2;
    /// Returns the refraction direction for a given incident vector `self`, surface normal
    /// `normal` and ratio of indices of refraction, `eta`. When total internal reflection
    /// occurs, a zero vector will be returned.
    ///
    /// `self` and `normal` must be normalized.
    ///
    /// Mirrors `glam::Vec2::refract`.
    /// #### Panics
    /// * `'Fixed: overflow'` if the result does not fit the scalar range.
    /// #### Deviations
    /// * The `is_normalized` preconditions are not checked (`glam_assert!`).
    /// * `k = 1 - eta^2 * (1 - n_dot_i^2)` is evaluated with two floor rescales and its
    ///   square root is floored; each output component is one `mul_sub` fused kernel.
    fn refract(self: Vec2, normal: Vec2, eta: Fixed) -> Vec2;
    /// Creates a 2D vector containing `[angle.cos(), angle.sin()]`. This can be used in
    /// conjunction with the [`rotate()`][Self::rotate()] method, e.g.
    /// `Vec2::from_angle(PI).rotate(Vec2::Y)` will create the vector `[-1, 0]` and rotate
    /// [`Vec2::Y`] around it returning `-Vec2::Y`.
    ///
    /// Mirrors `glam::Vec2::from_angle`.
    /// #### Panics
    /// * Never.
    /// #### Deviations
    /// * One shared `sin_cos` (1.4x the cost of `sin` alone) instead of two calls: each
    ///   component is within 1.02 ULP of the exact value. `from_angle(0) = X` exactly,
    ///   `from_angle(FRAC_PI_2)` is `Y` within 1 ULP and `from_angle(-a)` is the mirror
    ///   image of `from_angle(a)` exactly (`fixed::trig` symmetries).
    fn from_angle(angle: Fixed) -> Vec2;
    /// Returns the angle (in radians) of this vector in the range `[-π, +π]`.
    ///
    /// The input does not need to be a unit vector however it must be non-zero.
    ///
    /// Mirrors `glam::Vec2::to_angle`.
    /// #### Panics
    /// * Never.
    /// #### Deviations
    /// * `atan2` of `fixed::trig`: maximum error 3.22 ULP; the axes are exact
    ///   (`to_angle(X) = 0`, `to_angle(Y) = FRAC_PI_2`, `to_angle(NEG_X) = PI`).
    /// * The zero vector returns `0` (as `f32::atan2(0, 0)`); the non-zero precondition of
    ///   glam-rs is not checked.
    fn to_angle(self: Vec2) -> Fixed;
    /// Returns the angle of rotation (in radians) from `self` to `rhs` in the range `[-π,
    /// +π]`.
    ///
    /// The inputs do not need to be unit vectors however they must be non-zero.
    ///
    /// The returned angle can be used with `rotate_angle`, e.g.
    /// `self.rotate_angle(self.angle_to(rhs))` will be equal to `rhs`.
    ///
    /// Mirrors `glam::Vec2::angle_to`.
    /// #### Panics
    /// * `'Fixed: overflow'` if `perp_dot` or `dot` does not fit the scalar range, i.e.
    ///   for `|self| * |rhs| >= 2^31`.
    /// #### Deviations
    /// * `atan2(perp_dot, dot)` on the two fused products instead of the `acos_approx(dot
    ///   / sqrt(|self|^2 * |rhs|^2)) * signum(perp_dot)` of glam-rs: the same angle over
    ///   the same range, without a division, a square root or the ill-conditioning of
    ///   `acos` near `0` and `+-π` (the literal form is kept in `benches::alt`).
    /// * Each product is floored once (1 ULP), which moves the angle by at most `1.42 /
    ///   (|self| * |rhs|)` ULP: the total error is below `3.22 + 1.42 / (|self| * |rhs|)`
    ///   ULP, i.e. about 5 ULP for vectors whose lengths multiply to at least 1, and it
    ///   grows as the vectors shrink (normalize tiny inputs first).
    /// * Parallel vectors give `0` and anti-parallel ones `PI` exactly, as `signum(0) = 1`
    ///   in glam-rs; a zero input gives `0` (the non-zero precondition is not checked).
    fn angle_to(self: Vec2, rhs: Vec2) -> Fixed;
    /// Rotates `self` by `angle` (in radians), equivalent to
    /// `self.rotate(Vec2::from_angle(angle))`.
    ///
    /// Mirrors `glam::Vec2::rotate_angle`.
    /// #### Panics
    /// * `'Fixed: overflow'` if the result does not fit the scalar range.
    /// #### Deviations
    /// * `from_angle` (one `sin_cos`) followed by the two fused kernels of `rotate`: the
    ///   result is within `1.02 * |self| + 1` ULP per component of the exact rotation.
    fn rotate_angle(self: Vec2, angle: Fixed) -> Vec2;
    /// Rotates towards `rhs` up to `max_angle` (in radians).
    ///
    /// When `max_angle` is `0`, the result will be equal to `self`. When `max_angle` is
    /// equal to `self.angle_between(rhs)`, the result will be parallel to `rhs`. If
    /// `max_angle` is negative, rotates towards the exact opposite of `rhs`. Will not go
    /// past the target.
    ///
    /// Mirrors `glam::Vec2::rotate_towards`.
    /// #### Panics
    /// * `'Fixed: overflow'` if the result does not fit the scalar range.
    /// #### Deviations
    /// * One `atan2` (`angle_to`, error bound as there) and one `sin_cos`; the clamp is
    ///   exact and the sign is applied by a negation instead of the `signum` product.
    ///   `max_angle = 0` returns `self` exactly. Inlined: `#[inline(never)]` is 1.5 % more
    ///   expensive (`alt_rotate_towards_noinline`).
    /// * glam-rs names the target in its doc as `angle_between`, which `Vec2` does not
    ///   have in 0.33.8; the angle meant is `angle_to`.
    fn rotate_towards(self: Vec2, rhs: Vec2, max_angle: Fixed) -> Vec2;
    /// Performs a linear interpolation between `self` and `rhs` based on the value `s`.
    ///
    /// When `s` is `0`, the result will be equal to `self`. When `s` is `1`, the result
    /// will be equal to `rhs`. When `s` is outside of range `[0, 1]`, the result is
    /// linearly extrapolated.
    ///
    /// Mirrors `glam::Vec2::lerp`.
    /// #### Panics
    /// * `'Fixed: overflow'` if the result does not fit the scalar range.
    /// #### Deviations
    /// * `self + (rhs - self) * s` (the `FloatExt::lerp` form) with one floor rescale per
    ///   component, instead of the `self * (1 - s) + rhs * s` of glam-rs: exact at `s = 0`
    ///   and `s = 1`, and `rhs - self` cannot overflow.
    fn lerp(self: Vec2, rhs: Vec2, s: Fixed) -> Vec2;
    /// Moves towards `rhs` based on the value `d`.
    ///
    /// When `d` is `0`, the result will be equal to `self`. When `d` is equal to
    /// `self.distance(rhs)`, the result will be equal to `rhs`. Will not go past `rhs`.
    ///
    /// Mirrors `glam::Vec2::move_towards`.
    /// #### Panics
    /// * `'i64_sub Overflow'` / `'i64_sub Underflow'` if a component difference leaves the
    ///   scalar range.
    /// * `'Fixed: overflow'` if the distance or a component of the result does not fit the
    ///   scalar range.
    /// #### Deviations
    /// * `self + (rhs - self) * (d / len)`: one division shared by the components and one
    ///   fused `mul_add` each, instead of the two rescales per component of `self + a /
    ///   len * d`.
    /// * The `len <= 1e-4` guard of glam-rs is replaced by the exact `len == 0` test: the
    ///   division is exact enough at every non-zero length.
    fn move_towards(self: Vec2, rhs: Vec2, d: Fixed) -> Vec2;
    /// Calculates the midpoint between `self` and `rhs`.
    ///
    /// The midpoint is the average of, or halfway point between, two vectors.
    /// `a.midpoint(b)` should yield the same result as `a.lerp(b, 0.5)` while being
    /// slightly cheaper to compute.
    ///
    /// Mirrors `glam::Vec2::midpoint`.
    /// #### Panics
    /// * `'Fixed: overflow'` if the result does not fit the scalar range.
    /// #### Deviations
    /// * `self + (rhs - self) / 2` instead of `(self + rhs) * 0.5`: the sum of the two
    ///   vectors cannot overflow this way, and the result is the floor of the exact
    ///   midpoint.
    fn midpoint(self: Vec2, rhs: Vec2) -> Vec2;
    /// Fused multiply-add. Computes `(self * a) + b` element-wise with only one rounding
    /// error.
    ///
    /// Mirrors `glam::Vec2::mul_add`.
    /// #### Panics
    /// * `'Fixed: overflow'` if the result does not fit the scalar range.
    /// #### Deviations
    /// * The `mul_add` fused kernel: the exact `self * a + b` is rescaled once (floored).
    ///   Unlike f32 it is always at least as accurate as the unfused form, never slower,
    ///   and `b` is added exactly.
    fn mul_add(self: Vec2, a: Vec2, b: Vec2) -> Vec2;
    /// Returns true if the absolute difference of all elements between `self` and `rhs` is
    /// less than or equal to `max_abs_diff`.
    ///
    /// This can be used to compare if two vectors contain similar elements.
    ///
    /// Mirrors `glam::Vec2::abs_diff_eq`.
    /// #### Panics
    /// * Never.
    /// #### Deviations
    /// * The differences are computed exactly on 65 bits: unlike `(self - rhs).abs()` it
    ///   never overflows.
    fn abs_diff_eq(self: Vec2, rhs: Vec2, max_abs_diff: Fixed) -> bool;
    /// Returns a vector with a length no less than `min` and no more than `max`.
    ///
    /// `min` and `max` must be non-negative and `min` must not be greater than `max`.
    ///
    /// Mirrors `glam::Vec2::clamp_length`.
    /// #### Panics
    /// * `'Fixed: division by zero'` if `self` is zero and `min` is positive.
    /// * `'Fixed: overflow'` if the length or a scaled component does not fit the scalar
    ///   range.
    /// #### Deviations
    /// * The `0 <= min <= max` precondition is not checked (`glam_assert!`).
    /// * The comparison is on the length (floored) instead of the squared length: it
    ///   cannot overflow, and it is the same test up to 1 ULP. Scaling is one division
    ///   shared by the components and one floor rescale each.
    fn clamp_length(self: Vec2, min: Fixed, max: Fixed) -> Vec2;
    /// Returns a vector with a length no more than `max`.
    ///
    /// `max` must be non-negative.
    ///
    /// Mirrors `glam::Vec2::clamp_length_max`.
    /// #### Panics
    /// * `'Fixed: overflow'` if the length or a scaled component does not fit the scalar
    ///   range.
    /// #### Deviations
    /// * The `0 <= max` precondition is not checked (`glam_assert!`).
    /// * The comparison is on the length (floored) instead of the squared length: it
    ///   cannot overflow, and it is the same test up to 1 ULP. Scaling is one division
    ///   shared by the components and one floor rescale each.
    fn clamp_length_max(self: Vec2, max: Fixed) -> Vec2;
    /// Returns a vector with a length no less than `min`.
    ///
    /// `min` must be non-negative.
    ///
    /// Mirrors `glam::Vec2::clamp_length_min`.
    /// #### Panics
    /// * `'Fixed: division by zero'` if `self` is zero and `min` is positive.
    /// * `'Fixed: overflow'` if the length or a scaled component does not fit the scalar
    ///   range.
    /// #### Deviations
    /// * The `0 <= min` precondition is not checked (`glam_assert!`).
    /// * The comparison is on the length (floored) instead of the squared length: it
    ///   cannot overflow, and it is the same test up to 1 ULP. Scaling is one division
    ///   shared by the components and one floor rescale each.
    fn clamp_length_min(self: Vec2, min: Fixed) -> Vec2;
    /// Returns `[self.x + rhs, self.y + rhs, ..]`.
    ///
    /// Mirrors `glam::Vec2::splat`.
    /// #### Panics
    /// * `'i64_add Overflow'` / `'i64_add Underflow'` if a component sum leaves the scalar
    ///   range.
    /// #### Deviations
    /// * glam-rs has no scalar `+` on vectors: it spells this `v + Vec2::splat(s)`, and
    ///   the core operator traits of Cairo are homogeneous anyway (docs/DESIGN.md section
    ///   3).
    fn add_scalar(self: Vec2, rhs: Fixed) -> Vec2;
    /// Returns `[self.x - rhs, self.y - rhs, ..]`.
    ///
    /// Mirrors `glam::Vec2::splat`.
    /// #### Panics
    /// * `'i64_sub Overflow'` / `'i64_sub Underflow'` if a component difference leaves the
    ///   scalar range.
    /// #### Deviations
    /// * glam-rs has no scalar `-` on vectors: it spells this `v - Vec2::splat(s)`, and
    ///   the core operator traits of Cairo are homogeneous anyway (docs/DESIGN.md section
    ///   3).
    fn sub_scalar(self: Vec2, rhs: Fixed) -> Vec2;
    /// Returns `[self.x * rhs, self.y * rhs, ..]`.
    ///
    /// Mirrors `impl Mul<f32> for glam::Vec2`.
    /// #### Panics
    /// * `'Fixed: overflow'` if the result does not fit the scalar range.
    /// #### Deviations
    /// * glam-rs spells this with an operator (`impl Mul<f32> for Vec2`); the core
    ///   operator traits of Cairo are homogeneous (docs/DESIGN.md section 3).
    /// * The product is floored (one rescale per component), not rounded to nearest: at
    ///   most 1 ULP below the exact result.
    fn mul_scalar(self: Vec2, rhs: Fixed) -> Vec2;
    /// Returns `[self.x / rhs, self.y / rhs, ..]`.
    ///
    /// Mirrors `impl Div<f32> for glam::Vec2`.
    /// #### Panics
    /// * `'Fixed: division by zero'` if `rhs` is zero.
    /// * `'Fixed: overflow'` if the result does not fit the scalar range.
    /// #### Deviations
    /// * glam-rs spells this with an operator (`impl Div<f32> for Vec2`); the core
    ///   operator traits of Cairo are homogeneous (docs/DESIGN.md section 3).
    /// * One division shared by the components (`Recip`) and one fused multiplication
    ///   each, rounded to nearest: cheaper than, and up to 1 ULP away from, the component-
    ///   wise truncated `Fixed / Fixed` kept in `benches::alt`.
    fn div_scalar(self: Vec2, rhs: Fixed) -> Vec2;
    /// Returns `[self.x % rhs, self.y % rhs, ..]` (the remainder has the sign of `self`).
    ///
    /// Mirrors `impl Rem<f32> for glam::Vec2`.
    /// #### Panics
    /// * `'Fixed: division by zero'` if `rhs` is zero.
    /// #### Deviations
    /// * glam-rs spells this with an operator (`impl Rem<f32> for Vec2`); the core
    ///   operator traits of Cairo are homogeneous (docs/DESIGN.md section 3).
    /// * Exact.
    fn rem_scalar(self: Vec2, rhs: Fixed) -> Vec2;
    /// Casts all elements of `self` to `i32`, truncating toward zero.
    ///
    /// Mirrors `glam::Vec2::as_ivec2`.
    /// #### Panics
    /// * Never.
    /// #### Deviations
    /// * Never fails: the integer part of a `Fixed` always fits an `i32`.
    fn as_ivec2(self: Vec2) -> IVec2;
    /// Casts all elements of `self` to `u32`, truncating toward zero.
    ///
    /// Mirrors `glam::Vec2::as_uvec2`.
    /// #### Panics
    /// * `'Vec2: cast out of range'` if an element is negative.
    /// #### Deviations
    /// * The Rust `as` cast saturates (a negative float becomes `0`); this one panics
    ///   (docs/DESIGN.md section 3).
    fn as_uvec2(self: Vec2) -> UVec2;
}

pub impl Vec2Impl of Vec2Trait {
    const ZERO: Vec2 = Vec2 { x: Fixed { raw: 0 }, y: Fixed { raw: 0 } };
    const ONE: Vec2 = Vec2 { x: Fixed { raw: 0x100000000 }, y: Fixed { raw: 0x100000000 } };
    const NEG_ONE: Vec2 = Vec2 { x: Fixed { raw: -0x100000000 }, y: Fixed { raw: -0x100000000 } };
    const MIN: Vec2 = Vec2 {
        x: Fixed { raw: -0x8000000000000000 }, y: Fixed { raw: -0x8000000000000000 },
    };
    const MAX: Vec2 = Vec2 {
        x: Fixed { raw: 0x7fffffffffffffff }, y: Fixed { raw: 0x7fffffffffffffff },
    };
    const X: Vec2 = Vec2 { x: Fixed { raw: 0x100000000 }, y: Fixed { raw: 0 } };
    const Y: Vec2 = Vec2 { x: Fixed { raw: 0 }, y: Fixed { raw: 0x100000000 } };
    const NEG_X: Vec2 = Vec2 { x: Fixed { raw: -0x100000000 }, y: Fixed { raw: 0 } };
    const NEG_Y: Vec2 = Vec2 { x: Fixed { raw: 0 }, y: Fixed { raw: -0x100000000 } };
    const AXES: [Vec2; 2] = [
        Vec2 { x: Fixed { raw: 0x100000000 }, y: Fixed { raw: 0 } },
        Vec2 { x: Fixed { raw: 0 }, y: Fixed { raw: 0x100000000 } },
    ];

    #[inline(always)]
    fn new(x: Fixed, y: Fixed) -> Vec2 {
        Vec2 { x, y }
    }

    #[inline(always)]
    fn splat(v: Fixed) -> Vec2 {
        Vec2 { x: v, y: v }
    }

    #[inline(always)]
    fn select(mask: BVec2, if_true: Vec2, if_false: Vec2) -> Vec2 {
        Vec2 {
            x: if mask.x {
                if_true.x
            } else {
                if_false.x
            },
            y: if mask.y {
                if_true.y
            } else {
                if_false.y
            },
        }
    }

    #[inline(always)]
    fn from_array(a: [Fixed; 2]) -> Vec2 {
        let [x, y] = a;
        Vec2 { x, y }
    }

    #[inline(always)]
    fn to_array(self: Vec2) -> [Fixed; 2] {
        [self.x, self.y]
    }

    #[inline(always)]
    fn extend(self: Vec2, z: Fixed) -> Vec3 {
        Vec3 { x: self.x, y: self.y, z }
    }

    #[inline(always)]
    fn with_x(self: Vec2, x: Fixed) -> Vec2 {
        Vec2 { x: x, y: self.y }
    }

    #[inline(always)]
    fn with_y(self: Vec2, y: Fixed) -> Vec2 {
        Vec2 { x: self.x, y: y }
    }

    #[inline(always)]
    fn dot(self: Vec2, rhs: Vec2) -> Fixed {
        dot2(self.x, rhs.x, self.y, rhs.y)
    }

    #[inline(always)]
    fn dot_into_vec(self: Vec2, rhs: Vec2) -> Vec2 {
        let d = Self::dot(self, rhs);
        Vec2 { x: d, y: d }
    }

    #[inline(always)]
    fn perp(self: Vec2) -> Vec2 {
        Vec2 { x: -self.y, y: self.x }
    }

    #[inline(always)]
    fn perp_dot(self: Vec2, rhs: Vec2) -> Fixed {
        mul_sub(self.x, rhs.y, self.y, rhs.x)
    }

    #[inline(always)]
    fn rotate(self: Vec2, rhs: Vec2) -> Vec2 {
        Vec2 { x: mul_sub(self.x, rhs.x, self.y, rhs.y), y: dot2(self.y, rhs.x, self.x, rhs.y) }
    }

    #[inline(always)]
    fn min(self: Vec2, rhs: Vec2) -> Vec2 {
        Vec2 {
            x: if self.x < rhs.x {
                self.x
            } else {
                rhs.x
            },
            y: if self.y < rhs.y {
                self.y
            } else {
                rhs.y
            },
        }
    }

    #[inline(always)]
    fn max(self: Vec2, rhs: Vec2) -> Vec2 {
        Vec2 {
            x: if self.x > rhs.x {
                self.x
            } else {
                rhs.x
            },
            y: if self.y > rhs.y {
                self.y
            } else {
                rhs.y
            },
        }
    }

    #[inline(always)]
    fn clamp(self: Vec2, min: Vec2, max: Vec2) -> Vec2 {
        Vec2 {
            x: if self.x < min.x {
                min.x
            } else if self.x > max.x {
                max.x
            } else {
                self.x
            },
            y: if self.y < min.y {
                min.y
            } else if self.y > max.y {
                max.y
            } else {
                self.y
            },
        }
    }

    #[inline(always)]
    fn min_element(self: Vec2) -> Fixed {
        let m = if self.x < self.y {
            self.x
        } else {
            self.y
        };
        m
    }

    #[inline(always)]
    fn max_element(self: Vec2) -> Fixed {
        let m = if self.x > self.y {
            self.x
        } else {
            self.y
        };
        m
    }

    #[inline(always)]
    fn min_position(self: Vec2) -> usize {
        let m = self.x;
        let mut index = 0;
        if self.y < m {
            index = 1;
        }
        index
    }

    #[inline(always)]
    fn max_position(self: Vec2) -> usize {
        let m = self.x;
        let mut index = 0;
        if self.y > m {
            index = 1;
        }
