    #[inline(always)]
    fn normalize(self: Vec2) -> Vec2 {
        let n = norm2_wide(self.x, self.y);
        match n.try_recip() {
            Some(r) => Vec2 { x: r.mul(self.x), y: r.mul(self.y) },
            None => core::panic_with_felt252('Vec2: normalize zero'),
        }
    }

    #[inline(always)]
    fn try_normalize(self: Vec2) -> Option<Vec2> {
        let n = norm2_wide(self.x, self.y);
        match n.try_recip() {
            Some(r) => Some(Vec2 { x: r.mul(self.x), y: r.mul(self.y) }),
            None => None,
        }
    }

    #[allow(manual_unwrap_or)]
    #[inline(always)]
    fn normalize_or(self: Vec2, fallback: Vec2) -> Vec2 {
        let n = norm2_wide(self.x, self.y);
        match n.try_recip() {
            Some(r) => Vec2 { x: r.mul(self.x), y: r.mul(self.y) },
            None => fallback,
        }
    }

    #[inline(always)]
    fn normalize_or_zero(self: Vec2) -> Vec2 {
        Self::normalize_or(self, Self::ZERO)
    }

    #[inline(always)]
    fn normalize_and_length(self: Vec2) -> (Vec2, Fixed) {
        let n = norm2_wide(self.x, self.y);
        match n.try_recip() {
            Some(r) => (Vec2 { x: r.mul(self.x), y: r.mul(self.y) }, n.to_fixed()),
            None => (Self::X, F_ZERO),
        }
    }

    #[inline(always)]
    fn is_normalized(self: Vec2) -> bool {
        Self::length_squared(self).abs_diff_eq(F_ONE, NORMALIZED_EPS)
    }

    #[inline(always)]
    fn project_onto(self: Vec2, rhs: Vec2) -> Vec2 {
        let k = Self::dot(self, rhs) / Self::dot(rhs, rhs);
        Vec2 { x: rhs.x * k, y: rhs.y * k }
    }

    #[inline(always)]
    fn reject_from(self: Vec2, rhs: Vec2) -> Vec2 {
        let k = Self::dot(self, rhs) / Self::dot(rhs, rhs);
        Vec2 {
            x: wide_from(self.x).sub(wide_mul(rhs.x, k)).narrow(),
            y: wide_from(self.y).sub(wide_mul(rhs.y, k)).narrow(),
        }
    }

    #[inline(always)]
    fn project_onto_normalized(self: Vec2, rhs: Vec2) -> Vec2 {
        let d = Self::dot(self, rhs);
        Vec2 { x: rhs.x * d, y: rhs.y * d }
    }

    #[inline(always)]
    fn reject_from_normalized(self: Vec2, rhs: Vec2) -> Vec2 {
        let d = Self::dot(self, rhs);
        Vec2 {
            x: wide_from(self.x).sub(wide_mul(rhs.x, d)).narrow(),
            y: wide_from(self.y).sub(wide_mul(rhs.y, d)).narrow(),
        }
    }

    #[inline(always)]
    fn reflect(self: Vec2, normal: Vec2) -> Vec2 {
        let d = Self::dot(self, normal);
        let t = -(d + d);
        Vec2 { x: mul_add(t, normal.x, self.x), y: mul_add(t, normal.y, self.y) }
    }

    #[inline(always)]
    fn refract(self: Vec2, normal: Vec2, eta: Fixed) -> Vec2 {
        let n_dot_i = Self::dot(normal, self);
        let s = wide_from(F_ONE).sub(wide_mul(n_dot_i, n_dot_i)).narrow();
        let k = wide_from(F_ONE).lift().sub(wide_mul(eta, eta).mul(s)).narrow();
        if k.is_negative() {
            Self::ZERO
        } else {
            let f = mul_add(eta, n_dot_i, k.sqrt());
            Vec2 { x: mul_sub(eta, self.x, f, normal.x), y: mul_sub(eta, self.y, f, normal.y) }
        }
    }

    #[inline(always)]
    fn from_angle(angle: Fixed) -> Vec2 {
        let (s, c) = angle.sin_cos();
        Vec2 { x: c, y: s }
    }

    #[inline(always)]
    fn to_angle(self: Vec2) -> Fixed {
        self.y.atan2(self.x)
    }

    #[inline(always)]
    fn angle_to(self: Vec2, rhs: Vec2) -> Fixed {
        let p = mul_sub(self.x, rhs.y, self.y, rhs.x);
        let d = dot2(self.x, rhs.x, self.y, rhs.y);
        p.atan2(d)
    }

    #[inline(always)]
    fn rotate_angle(self: Vec2, angle: Fixed) -> Vec2 {
        Self::rotate(self, Self::from_angle(angle))
    }

    #[inline(always)]
    fn rotate_towards(self: Vec2, rhs: Vec2, max_angle: Fixed) -> Vec2 {
        let a = Self::angle_to(self, rhs);
        let abs_a = a.abs();
        // When `max_angle < 0`, rotate no further than `PI` radians away
        let angle = max_angle.clamp(abs_a - PI, abs_a);
        let angle = if a.is_negative() {
            -angle
        } else {
            angle
        };
        Self::rotate(Self::from_angle(angle), self)
    }

    #[inline(always)]
    fn lerp(self: Vec2, rhs: Vec2, s: Fixed) -> Vec2 {
        Vec2 { x: self.x.lerp(rhs.x, s), y: self.y.lerp(rhs.y, s) }
    }

    #[inline(always)]
    fn move_towards(self: Vec2, rhs: Vec2, d: Fixed) -> Vec2 {
        let a = rhs - self;
        let n = norm2_wide(a.x, a.y);
        if n.is_zero() || n.to_fixed() <= d {
            rhs
        } else {
            let k = n.recip().mul(d);
            Vec2 { x: mul_add(a.x, k, self.x), y: mul_add(a.y, k, self.y) }
        }
    }

    #[inline(always)]
    fn midpoint(self: Vec2, rhs: Vec2) -> Vec2 {
        Vec2 { x: self.x.lerp(rhs.x, F_HALF), y: self.y.lerp(rhs.y, F_HALF) }
    }

    #[inline(always)]
    fn mul_add(self: Vec2, a: Vec2, b: Vec2) -> Vec2 {
        Vec2 { x: mul_add(self.x, a.x, b.x), y: mul_add(self.y, a.y, b.y) }
    }

    #[inline(always)]
    fn abs_diff_eq(self: Vec2, rhs: Vec2, max_abs_diff: Fixed) -> bool {
        self.x.abs_diff_eq(rhs.x, max_abs_diff) && self.y.abs_diff_eq(rhs.y, max_abs_diff)
    }

    #[inline(always)]
    fn clamp_length(self: Vec2, min: Fixed, max: Fixed) -> Vec2 {
        let n = norm2_wide(self.x, self.y);
        let len = n.to_fixed();
        if len < min {
            scaled(self, n, min)
        } else if len > max {
            scaled(self, n, max)
        } else {
            self
        }
    }

    #[inline(always)]
    fn clamp_length_max(self: Vec2, max: Fixed) -> Vec2 {
        let n = norm2_wide(self.x, self.y);
        if n.to_fixed() > max {
            scaled(self, n, max)
        } else {
            self
        }
    }

    #[inline(always)]
    fn clamp_length_min(self: Vec2, min: Fixed) -> Vec2 {
        let n = norm2_wide(self.x, self.y);
        if n.to_fixed() < min {
            scaled(self, n, min)
        } else {
            self
        }
    }

    #[inline(always)]
    fn add_scalar(self: Vec2, rhs: Fixed) -> Vec2 {
        Vec2 { x: self.x + rhs, y: self.y + rhs }
    }

    #[inline(always)]
    fn sub_scalar(self: Vec2, rhs: Fixed) -> Vec2 {
        Vec2 { x: self.x - rhs, y: self.y - rhs }
    }

    #[inline(always)]
    fn mul_scalar(self: Vec2, rhs: Fixed) -> Vec2 {
        Vec2 { x: self.x * rhs, y: self.y * rhs }
    }

    #[inline(always)]
    fn div_scalar(self: Vec2, rhs: Fixed) -> Vec2 {
        let r = RecipTrait::new(rhs);
        Vec2 { x: r.mul(self.x), y: r.mul(self.y) }
    }

    #[inline(always)]
    fn rem_scalar(self: Vec2, rhs: Fixed) -> Vec2 {
        Vec2 { x: self.x % rhs, y: self.y % rhs }
    }

    #[inline(always)]
    fn as_ivec2(self: Vec2) -> IVec2 {
        IVec2 { x: self.x.to_int_trunc(), y: self.y.to_int_trunc() }
    }

    #[inline(always)]
    fn as_uvec2(self: Vec2) -> UVec2 {
        UVec2 { x: to_u32(self.x), y: to_u32(self.y) }
    }
