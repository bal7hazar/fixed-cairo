    ///
    /// In particular, if the input is zero the result of this operation will be the
    /// fallback value.
    ///
    /// Mirrors `glam::Vec3::normalize_or`.
    /// #### Panics
    /// * `'Fixed: overflow'` if the result does not fit the scalar range.
    /// #### Deviations
    /// * One square root and one division shared by the components, then one fused
    ///   multiplication each (rounded to nearest, ties toward +infinity): every component
    ///   is within `1 / |self|` ULP of the exact value, and an axis-aligned vector
    ///   normalizes to exactly `+-1`.
    /// * The fallback is returned only for the zero vector.
    fn normalize_or(self: Vec3, fallback: Vec3) -> Vec3;
    /// Returns `self` normalized to length 1 if possible, else returns zero.
    ///
    /// Mirrors `glam::Vec3::normalize_or_zero`.
    /// #### Panics
    /// * `'Fixed: overflow'` if the result does not fit the scalar range.
    /// #### Deviations
    /// * One square root and one division shared by the components, then one fused
    ///   multiplication each (rounded to nearest, ties toward +infinity): every component
    ///   is within `1 / |self|` ULP of the exact value, and an axis-aligned vector
    ///   normalizes to exactly `+-1`.
    /// * Zero is returned only for the zero vector.
    fn normalize_or_zero(self: Vec3) -> Vec3;
