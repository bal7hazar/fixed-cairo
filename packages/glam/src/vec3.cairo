        }
    }

    #[inline(always)]
    fn normalize(self: Vec3) -> Vec3 {
        let n = norm3_wide(self.x, self.y, self.z);
        match n.try_recip() {
            Some(r) => Vec3 { x: r.mul(self.x), y: r.mul(self.y), z: r.mul(self.z) },
            None => core::panic_with_felt252('Vec3: normalize zero'),
        }
    }

    #[inline(always)]
    fn try_normalize(self: Vec3) -> Option<Vec3> {
        let n = norm3_wide(self.x, self.y, self.z);
        match n.try_recip() {
            Some(r) => Some(Vec3 { x: r.mul(self.x), y: r.mul(self.y), z: r.mul(self.z) }),
            None => None,
        }
    }

    #[allow(manual_unwrap_or)]
    #[inline(always)]
    fn normalize_or(self: Vec3, fallback: Vec3) -> Vec3 {
        let n = norm3_wide(self.x, self.y, self.z);
        match n.try_recip() {
            Some(r) => Vec3 { x: r.mul(self.x), y: r.mul(self.y), z: r.mul(self.z) },
            None => fallback,
        }
    }

    #[inline(always)]
    fn normalize_or_zero(self: Vec3) -> Vec3 {
        Self::normalize_or(self, Self::ZERO)
    }

    #[inline(always)]
    fn normalize_and_length(self: Vec3) -> (Vec3, Fixed) {
        let n = norm3_wide(self.x, self.y, self.z);
        match n.try_recip() {
            Some(r) => (
                Vec3 { x: r.mul(self.x), y: r.mul(self.y), z: r.mul(self.z) }, n.to_fixed(),
            ),
            None => (Self::X, F_ZERO),
        }
    }

    #[inline(always)]
    fn is_normalized(self: Vec3) -> bool {
        is_unit3(self.x, self.y, self.z, NORMALIZED_EPS_RAW)
    }

    #[inline(always)]
    fn project_onto(self: Vec3, rhs: Vec3) -> Vec3 {
        let k = Self::dot(self, rhs) / Self::dot(rhs, rhs);
        Vec3 { x: rhs.x * k, y: rhs.y * k, z: rhs.z * k }
    }

    #[inline(always)]
    fn reject_from(self: Vec3, rhs: Vec3) -> Vec3 {
        let k = Self::dot(self, rhs) / Self::dot(rhs, rhs);
        Vec3 {
            x: wide_from(self.x).sub(wide_mul(rhs.x, k)).narrow(),
            y: wide_from(self.y).sub(wide_mul(rhs.y, k)).narrow(),
            z: wide_from(self.z).sub(wide_mul(rhs.z, k)).narrow(),
        }
    }

    #[inline(always)]
    fn project_onto_normalized(self: Vec3, rhs: Vec3) -> Vec3 {
        let d = Self::dot(self, rhs);
        Vec3 { x: rhs.x * d, y: rhs.y * d, z: rhs.z * d }
    }

    #[inline(always)]
    fn reject_from_normalized(self: Vec3, rhs: Vec3) -> Vec3 {
        let d = Self::dot(self, rhs);
        Vec3 {
            x: wide_from(self.x).sub(wide_mul(rhs.x, d)).narrow(),
            y: wide_from(self.y).sub(wide_mul(rhs.y, d)).narrow(),
            z: wide_from(self.z).sub(wide_mul(rhs.z, d)).narrow(),
        }
    }

    #[inline(always)]
    fn reflect(self: Vec3, normal: Vec3) -> Vec3 {
        let d = Self::dot(self, normal);
        let t = -(d + d);
        Vec3 {
            x: mul_add(t, normal.x, self.x),
            y: mul_add(t, normal.y, self.y),
            z: mul_add(t, normal.z, self.z),
        }
    }

    #[inline(always)]
    fn refract(self: Vec3, normal: Vec3, eta: Fixed) -> Vec3 {
        let n_dot_i = Self::dot(normal, self);
        let s = wide_from(F_ONE).sub(wide_mul(n_dot_i, n_dot_i)).narrow();
        let k = wide_from(F_ONE).lift().sub(wide_mul(eta, eta).mul(s)).narrow();
        if k.is_negative() {
            Self::ZERO
        } else {
            let f = mul_add(eta, n_dot_i, k.sqrt());
            Vec3 {
                x: mul_sub(eta, self.x, f, normal.x),
                y: mul_sub(eta, self.y, f, normal.y),
                z: mul_sub(eta, self.z, f, normal.z),
            }
        }
    }

    #[inline(always)]
    fn angle_between(self: Vec3, rhs: Vec3) -> Fixed {
        let c = Self::cross(self, rhs);
        norm3(c.x, c.y, c.z).atan2(Self::dot(self, rhs))
    }

    #[inline(always)]
    fn angle_to(self: Vec3, rhs: Vec3, axis: Vec3) -> Fixed {
        let s = det3(axis.x, axis.y, axis.z, self.x, self.y, self.z, rhs.x, rhs.y, rhs.z);
        s.atan2(Self::dot(self, rhs))
    }

    #[inline(always)]
    fn rotate_x(self: Vec3, angle: Fixed) -> Vec3 {
        let (s, c) = angle.sin_cos();
        Vec3 { x: self.x, y: mul_sub(self.y, c, self.z, s), z: dot2(self.y, s, self.z, c) }
    }

    #[inline(always)]
    fn rotate_y(self: Vec3, angle: Fixed) -> Vec3 {
        let (s, c) = angle.sin_cos();
        Vec3 { x: dot2(self.x, c, self.z, s), y: self.y, z: mul_sub(self.z, c, self.x, s) }
    }

    #[inline(always)]
    fn rotate_z(self: Vec3, angle: Fixed) -> Vec3 {
        let (s, c) = angle.sin_cos();
        Vec3 { x: mul_sub(self.x, c, self.y, s), y: dot2(self.x, s, self.y, c), z: self.z }
    }

    fn rotate_axis(self: Vec3, axis: Vec3, angle: Fixed) -> Vec3 {
        QuatTrait::mul_vec3(QuatTrait::from_axis_angle(axis, angle), self)
    }

    fn rotate_towards(self: Vec3, rhs: Vec3, max_angle: Fixed) -> Vec3 {
        let c = Self::cross(self, rhs);
        let cn = norm3_wide(c.x, c.y, c.z);
        let angle_between = cn.to_fixed().atan2(Self::dot(self, rhs));
        // When `max_angle < 0`, rotate no further than `PI` radians away
        let angle = max_angle.clamp(angle_between - PI, angle_between);
        // The rotation axis: the normalized cross product, or an arbitrary orthogonal
        // direction when the two vectors are parallel.
        let axis = match cn.try_recip() {
            Some(r) => Vec3 { x: r.mul(c.x), y: r.mul(c.y), z: r.mul(c.z) },
            None => Self::normalize(Self::any_orthogonal_vector(self)),
        };
        QuatTrait::mul_vec3(QuatTrait::from_axis_angle(axis, angle), self)
    }

    #[inline(always)]
    fn any_orthogonal_vector(self: Vec3) -> Vec3 {
        if self.x.abs() > self.y.abs() {
            // `self.cross(Vec3::Y)`
            Vec3 { x: -self.z, y: F_ZERO, z: self.x }
        } else {
            // `self.cross(Vec3::X)`
            Vec3 { x: F_ZERO, y: self.z, z: -self.y }
        }
    }

    #[inline(always)]
    fn any_orthonormal_vector(self: Vec3) -> Vec3 {
        let sign = self.z.signum();
        let a = -(sign + self.z).recip();
        Vec3 {
            x: wide_mul(self.x, self.y).mul(a).narrow(),
            y: wide_from(sign).lift().add(wide_mul(self.y, self.y).mul(a)).narrow(),
            z: -self.y,
        }
    }

    #[inline(always)]
    fn any_orthonormal_pair(self: Vec3) -> (Vec3, Vec3) {
        let neg = self.z.is_negative();
        let sign = if neg {
            F_NEG_ONE
        } else {
            F_ONE
        };
        // `sign * self.x`, so that the products below stay triple products.
        let sx = if neg {
            -self.x
        } else {
            self.x
        };
        let a = -(sign + self.z).recip();
        let b = wide_mul(self.x, self.y).mul(a).narrow();
        (
            Vec3 {
                x: wide_from(F_ONE).lift().add(wide_mul(sx, self.x).mul(a)).narrow(),
                y: if neg {
                    -b
                } else {
                    b
                },
                z: -sx,
            },
            Vec3 {
                x: b,
                y: wide_from(sign).lift().add(wide_mul(self.y, self.y).mul(a)).narrow(),
                z: -self.y,
            },
        )
    }

    fn slerp(self: Vec3, rhs: Vec3, s: Fixed) -> Vec3 {
        let la = norm3_wide(self.x, self.y, self.z);
        let lb = norm3_wide(rhs.x, rhs.y, rhs.z);
        let self_length = la.to_fixed();
        let rhs_length = lb.to_fixed();
        // The cosine of the angle between the two directions.
        let d = RecipTrait::new(self_length * rhs_length).mul(Self::dot(self, rhs));
        if d.abs() < NEAR_ONE {
            let theta = d.acos_clamped();
            let r = RecipTrait::new(theta.sin());
            let t1 = r.mul((theta * (F_ONE - s)).sin());
            let t2 = r.mul((theta * s).sin());
            // The interpolated length, then one shared division per operand.
            let len = self_length.lerp(rhs_length, s);
            let k1 = la.recip().mul(len * t1);
            let k2 = lb.recip().mul(len * t2);
            Vec3 {
                x: wide_mul(self.x, k1).add(wide_mul(rhs.x, k2)).narrow(),
                y: wide_mul(self.y, k1).add(wide_mul(rhs.y, k2)).narrow(),
                z: wide_mul(self.z, k1).add(wide_mul(rhs.z, k2)).narrow(),
            }
        } else if d.is_negative() {
            // Almost anti-parallel: turn by `PI * s` around an arbitrary orthogonal axis.
            let q = QuatTrait::from_axis_angle(
                Self::normalize(Self::any_orthogonal_vector(self)), PI * s,
            );
            let k = la.recip().mul(self_length.lerp(rhs_length, s));
            Self::mul_scalar(QuatTrait::mul_vec3(q, self), k)
        } else {
            // Almost parallel: the linear interpolation is the spherical one to within
            // `theta^2 / 8`.
            Self::lerp(self, rhs, s)
        }
    }

    #[inline(always)]
    fn lerp(self: Vec3, rhs: Vec3, s: Fixed) -> Vec3 {
        Vec3 { x: self.x.lerp(rhs.x, s), y: self.y.lerp(rhs.y, s), z: self.z.lerp(rhs.z, s) }
    }

    #[inline(always)]
    fn move_towards(self: Vec3, rhs: Vec3, d: Fixed) -> Vec3 {
        let a = rhs - self;
        let n = norm3_wide(a.x, a.y, a.z);
        if n.is_zero() || n.to_fixed() <= d {
            rhs
        } else {
            let k = n.recip().mul(d);
            Vec3 {
                x: mul_add(a.x, k, self.x), y: mul_add(a.y, k, self.y), z: mul_add(a.z, k, self.z),
            }
        }
    }

    #[inline(always)]
    fn midpoint(self: Vec3, rhs: Vec3) -> Vec3 {
        Vec3 {
            x: self.x.lerp(rhs.x, F_HALF),
            y: self.y.lerp(rhs.y, F_HALF),
            z: self.z.lerp(rhs.z, F_HALF),
        }
    }

    #[inline(always)]
    fn mul_add(self: Vec3, a: Vec3, b: Vec3) -> Vec3 {
        Vec3 {
            x: mul_add(self.x, a.x, b.x),
            y: mul_add(self.y, a.y, b.y),
            z: mul_add(self.z, a.z, b.z),
        }
    }

    #[inline(always)]
    fn abs_diff_eq(self: Vec3, rhs: Vec3, max_abs_diff: Fixed) -> bool {
        self.x.abs_diff_eq(rhs.x, max_abs_diff)
            && self.y.abs_diff_eq(rhs.y, max_abs_diff)
            && self.z.abs_diff_eq(rhs.z, max_abs_diff)
    }

    #[inline(always)]
    fn clamp_length(self: Vec3, min: Fixed, max: Fixed) -> Vec3 {
        let n = norm3_wide(self.x, self.y, self.z);
        let len = n.to_fixed();
        if len < min {
            scaled(self, n, min)
        } else if len > max {
            scaled(self, n, max)
        } else {
            self
        }
    }

    #[inline(always)]
    fn clamp_length_max(self: Vec3, max: Fixed) -> Vec3 {
        let n = norm3_wide(self.x, self.y, self.z);
        if n.to_fixed() > max {
            scaled(self, n, max)
        } else {
            self
        }
    }

    #[inline(always)]
    fn clamp_length_min(self: Vec3, min: Fixed) -> Vec3 {
        let n = norm3_wide(self.x, self.y, self.z);
        if n.to_fixed() < min {
            scaled(self, n, min)
        } else {
            self
        }
    }

    #[inline(always)]
    fn add_scalar(self: Vec3, rhs: Fixed) -> Vec3 {
        Vec3 { x: self.x + rhs, y: self.y + rhs, z: self.z + rhs }
    }

    #[inline(always)]
    fn sub_scalar(self: Vec3, rhs: Fixed) -> Vec3 {
        Vec3 { x: self.x - rhs, y: self.y - rhs, z: self.z - rhs }
    }

    #[inline(always)]
    fn mul_scalar(self: Vec3, rhs: Fixed) -> Vec3 {
        Vec3 { x: self.x * rhs, y: self.y * rhs, z: self.z * rhs }
    }

    #[inline(always)]
    fn div_scalar(self: Vec3, rhs: Fixed) -> Vec3 {
        let r = RecipTrait::new(rhs);
        Vec3 { x: r.mul(self.x), y: r.mul(self.y), z: r.mul(self.z) }
    }

    #[inline(always)]
    fn rem_scalar(self: Vec3, rhs: Fixed) -> Vec3 {
        Vec3 { x: self.x % rhs, y: self.y % rhs, z: self.z % rhs }
    }

    #[inline(always)]
    fn as_ivec3(self: Vec3) -> IVec3 {
        IVec3 { x: self.x.to_int_trunc(), y: self.y.to_int_trunc(), z: self.z.to_int_trunc() }
    }

    #[inline(always)]
    fn as_uvec3(self: Vec3) -> UVec3 {
        UVec3 { x: to_u32(self.x), y: to_u32(self.y), z: to_u32(self.z) }
    }
}

