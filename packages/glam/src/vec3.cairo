pub impl Vec2FixedIntoVec3 of Into<(Vec2, Fixed), Vec3> {
    #[inline(always)]
    fn into(self: (Vec2, Fixed)) -> Vec3 {
        let (v, z) = self;
        Vec3 { x: v.x, y: v.y, z }
    }
}

/// `true` becomes `1` and `false` becomes `0`.
///
/// Mirrors `impl From<glam::BVec3> for glam::Vec3`.
pub impl BVec3IntoVec3 of Into<BVec3, Vec3> {
    #[inline(always)]
    fn into(self: BVec3) -> Vec3 {
        Vec3 {
            x: if self.x {
                F_ONE
            } else {
                F_ZERO
            },
            y: if self.y {
                F_ONE
            } else {
                F_ZERO
            },
            z: if self.z {
                F_ONE
            } else {
                F_ZERO
            },
        }
    }
}

/// The `IVec3 -> Vec3` cast (exact: every `i32` is representable).
///
/// Mirrors `glam::IVec3::as_vec3` and `impl From<glam::IVec3> for glam::Vec3`.
pub impl IVec3IntoVec3 of Into<IVec3, Vec3> {
    #[inline(always)]
    fn into(self: IVec3) -> Vec3 {
        Vec3 {
            x: FixedTrait::from_int(self.x),
            y: FixedTrait::from_int(self.y),
            z: FixedTrait::from_int(self.z),
        }
    }
}

/// The `UVec3 -> Vec3` cast. Panics with `'Vec3: cast out of range'` above `2^31 - 1`, where the
/// Rust `as` cast is lossy but total.
///
/// Mirrors `glam::UVec3::as_vec3` and `impl From<glam::UVec3> for glam::Vec3`.
pub impl UVec3IntoVec3 of Into<UVec3, Vec3> {
    #[inline(always)]
    fn into(self: UVec3) -> Vec3 {
        Vec3 {
            x: self.x.try_into().expect('Vec3: cast out of range'),
            y: self.y.try_into().expect('Vec3: cast out of range'),
            z: self.z.try_into().expect('Vec3: cast out of range'),
        }
    }
}

/// `0`.
const F_ZERO: Fixed = Fixed { raw: 0 };

/// `1`.
const F_ONE: Fixed = Fixed { raw: 0x100000000 };

/// `-1`.
const F_NEG_ONE: Fixed = Fixed { raw: -0x100000000 };

/// `1 / 2`.
const F_HALF: Fixed = Fixed { raw: 0x80000000 };

/// The `is_normalized` threshold: 1024 raw ULP (`2^-22`) on the squared length.
/// The squared length of a vector normalized by this module is within a few ULP of 1; glam-rs
/// uses `2e-4`, which is ~1700 f32 epsilons, while this is ~1000 Q32.32 epsilons.
const NORMALIZED_EPS_RAW: u16 = 1024;

/// `1 - 2^-20`, the cosine band in which [`Vec3Trait::slerp`] falls back to a linear
/// interpolation, where glam-rs uses `1 - 3e-7`.
///
/// Below `theta = acos(NEAR_ONE) = 1.38e-3` rad the slerp branch divides the two sine weights
/// by `sin(theta)`, which costs `2 ULP / sin(theta) = 3.4e-7` relative on the result, while the
/// linear fallback differs from the exact slerp by `theta^2 / 8 = 2.4e-7`: the two branches
/// meet with the same accuracy, which is what fixes the threshold. It is the same value as
/// `quat::NEAR_ONE`, whose derivation is the same one on the half angle.
pub const NEAR_ONE: Fixed = Fixed { raw: 0xfffff000 };

/// `v * (target / len)`: one division shared by the components, one fused product each.
#[inline(always)]
fn scaled(v: Vec3, n: Norm, target: Fixed) -> Vec3 {
    let k = n.recip().mul(target);
    Vec3 { x: v.x * k, y: v.y * k, z: v.z * k }
}

/// Truncation toward zero to `u32`. The integer part always fits an `i32`, so only a negative
/// value can fail.
#[inline(always)]
fn to_u32(v: Fixed) -> u32 {
    v.to_int_trunc().try_into().expect('Vec3: cast out of range')
}
