/// `2^n`. Shifts are a multiplication / division by a power of two taken from a jump table
/// (a runtime `pow(2, n)` costs ~10 000 gas more, a `const` array lookup ~200 more).
#[inline(always)]
fn pow2(n: u32) -> u32 {
    match n {
        0 => 0x1,
        1 => 0x2,
        2 => 0x4,
        3 => 0x8,
        4 => 0x10,
        5 => 0x20,
        6 => 0x40,
        7 => 0x80,
        8 => 0x100,
        9 => 0x200,
        10 => 0x400,
        11 => 0x800,
        12 => 0x1000,
        13 => 0x2000,
        14 => 0x4000,
        15 => 0x8000,
        16 => 0x10000,
        17 => 0x20000,
        18 => 0x40000,
        19 => 0x80000,
        20 => 0x100000,
        21 => 0x200000,
        22 => 0x400000,
        23 => 0x800000,
        24 => 0x1000000,
        25 => 0x2000000,
        26 => 0x4000000,
        27 => 0x8000000,
        28 => 0x10000000,
        29 => 0x20000000,
        30 => 0x40000000,
        31 => 0x80000000,
        _ => core::panic_with_felt252('IVec2: shift overflow'),
    }
}

/// `(a << n) mod 2^32` with `p = 2^n`: widening multiplication, then the low 32 bits.
#[inline(always)]
fn shl_u32(a: u32, p: u32) -> u32 {
    let (_, lo) = DivRem::div_rem(a.wide_mul(p), 0x100000000);
    lo.try_into().unwrap()
}

/// Two's complement reinterpretation. `i32_diff(a, 0)` is `Ok(a)` when `a >= 0` and
/// `Err(2^32 + a)` otherwise: exactly the wrapped value in both cases, in one libfunc.
#[allow(manual_unwrap_or)]
#[inline(always)]
fn i32_as_u32(a: i32) -> u32 {
    match i32_diff(a, 0) {
        Ok(v) | Err(v) => v,
    }
}

/// Two's complement reinterpretation: `a - 2^32` when `a >= 2^31`.
#[allow(manual_unwrap_or)]
#[inline(always)]
fn u32_as_i32(a: u32) -> i32 {
    match a.try_into() {
        Some(v) => v,
        None => {
            let f: felt252 = a.into();
            (f - 0x100000000).try_into().unwrap()
        },
    }
}

/// `|a - b|` as a `u32` (never overflows). `i32_diff` yields `a - b` directly when `a >= b`.
#[allow(manual_unwrap_or)]
#[inline(always)]
fn abs_diff_i32(a: i32, b: i32) -> u32 {
    match i32_diff(a, b) {
        Ok(d) => d,
        Err(_) => match i32_diff(b, a) {
            Ok(d) | Err(d) => d,
        },
    }
}

/// The `i32 -> u32` downcast is the cheapest sign test (one range check, against a full
/// `i32_diff` for `a < 0`).
#[allow(manual_unwrap_or)]
#[inline(always)]
fn abs_i32(a: i32) -> i32 {
    match TryInto::<i32, u32>::try_into(a) {
        Some(_) => a,
        None => -a,
    }
}

/// Zero first (an equality costs no range check), then the downcast sign test of `abs_i32`.
#[allow(manual_unwrap_or)]
#[inline(always)]
fn signum_i32(a: i32) -> i32 {
    if a == 0 {
        0
    } else {
        match TryInto::<i32, u32>::try_into(a) {
            Some(_) => 1,
            None => -1,
        }
    }
}

/// Euclidean quotient: `a = q * b + r` with `0 <= r < |b|`. Own sign / magnitude split
/// (`i32_diff`), one unsigned `DivRem` on `|a| = Q * |b| + R`, signed rebuild: cheaper than the
/// corelib signed `DivRem` followed by the fix-up of Rust's `i32::div_euclid`.
#[allow(manual_unwrap_or)]
#[inline(always)]
fn div_euclid_i32(a: i32, b: i32) -> i32 {
    let (mb, nb) = match i32_diff(b, 0) {
        Ok(m) => (m, false),
        Err(_) => (abs_diff_i32(0, b), true),
    };
    let d: NonZero<u32> = mb.try_into().expect('Division by 0');
    match i32_diff(a, 0) {
        Ok(ma) => {
            let (q, _) = DivRem::div_rem(ma, d);
            let q: i32 = q.try_into().unwrap();
            if nb {
                -q
            } else {
                q
            }
        },
        Err(_) => {
            let (q, r) = DivRem::div_rem(abs_diff_i32(0, a), d);
            let q: felt252 = if r == 0 {
                q.into()
            } else {
                q.into() + 1
            };
            if nb {
                q.try_into().expect('attempt to divide with overflow')
            } else {
                (-q).try_into().unwrap()
            }
        },
    }
}

/// Euclidean remainder, `0 <= r < |b|`: `R` when `a >= 0`, else `|b| - R` (or 0), with
/// `|a| = Q * |b| + R` from one unsigned `DivRem`.
#[allow(manual_unwrap_or)]
#[inline(always)]
fn rem_euclid_i32(a: i32, b: i32) -> i32 {
    let mb = abs_diff_i32(b, 0);
    let d: NonZero<u32> = mb.try_into().expect('Division by 0');
    match i32_diff(a, 0) {
        Ok(ma) => {
            let (_, r) = DivRem::div_rem(ma, d);
            r.try_into().unwrap()
        },
        Err(_) => {
            let (_, r) = DivRem::div_rem(abs_diff_i32(0, a), d);
            if r == 0 {
                0
            } else {
                (mb - r).try_into().unwrap()
            }
        },
    }
}

#[inline(always)]
fn checked_mul_i32(a: i32, b: i32) -> Option<i32> {
    a.wide_mul(b).try_into()
}

/// `None` for a zero divisor and for `i32::MIN / -1`.
#[allow(manual_unwrap_or)]
#[inline(always)]
fn checked_div_i32(a: i32, b: i32) -> Option<i32> {
    match TryInto::<i32, NonZero<i32>>::try_into(b) {
        Some(d) => {
            if b == -1 && a == -0x80000000 {
                None
            } else {
                let (q, _) = DivRem::div_rem(a, d);
                Some(q)
            }
        },
        None => None,
    }
}

/// In range: one downcast. Otherwise the low 32 bits of the 64-bit product, reinterpreted as an
/// `i32`: adding `2^63` (a multiple of `2^32`) makes the product non-negative without changing
/// its low half.
#[allow(manual_unwrap_or)]
#[inline(always)]
fn wrapping_mul_i32(a: i32, b: i32) -> i32 {
    let p = a.wide_mul(b);
    match p.try_into() {
        Some(v) => v,
        None => {
            let p: felt252 = p.into();
            let p: u64 = (p + 0x8000000000000000).try_into().unwrap();
            let (_, lo) = DivRem::div_rem(p, 0x100000000);
            u32_as_i32(lo.try_into().unwrap())
        },
    }
}

#[allow(manual_unwrap_or)]
#[inline(always)]
fn saturating_mul_i32(a: i32, b: i32) -> i32 {
    let p = a.wide_mul(b);
    match p.try_into() {
        Some(v) => v,
        None => if p < 0 {
            -0x80000000
        } else {
            0x7fffffff
        },
    }
}

/// `i32::MIN / -1` wraps to `i32::MIN`.
#[inline(always)]
fn wrapping_div_i32(a: i32, b: i32) -> i32 {
    if b == -1 && a == -0x80000000 {
        a
    } else {
        a / b
    }
}

/// `i32::MIN / -1` saturates to `i32::MAX`.
#[inline(always)]
fn saturating_div_i32(a: i32, b: i32) -> i32 {
    if b == -1 && a == -0x80000000 {
        0x7fffffff
    } else {
        a / b
    }
}

#[inline(always)]
fn checked_add_unsigned(a: i32, b: u32) -> Option<i32> {
    let s: felt252 = a.into() + b.into();
    s.try_into()
}

#[inline(always)]
fn checked_sub_unsigned(a: i32, b: u32) -> Option<i32> {
    let s: felt252 = a.into() - b.into();
    s.try_into()
}

/// `a + b < 2^31 + 2^32`: at most one wrap, downward.
#[allow(manual_unwrap_or)]
#[inline(always)]
fn wrapping_add_unsigned(a: i32, b: u32) -> i32 {
    let s: felt252 = a.into() + b.into();
    match s.try_into() {
        Some(v) => v,
        None => (s - 0x100000000).try_into().unwrap(),
    }
}

/// `a - b >= -2^31 - 2^32 + 1`: at most one wrap, upward.
#[allow(manual_unwrap_or)]
#[inline(always)]
fn wrapping_sub_unsigned(a: i32, b: u32) -> i32 {
    let s: felt252 = a.into() - b.into();
    match s.try_into() {
        Some(v) => v,
        None => (s + 0x100000000).try_into().unwrap(),
    }
}

#[allow(manual_unwrap_or)]
#[inline(always)]
fn saturating_add_unsigned(a: i32, b: u32) -> i32 {
    let s: felt252 = a.into() + b.into();
    match s.try_into() {
        Some(v) => v,
        None => 0x7fffffff,
    }
}

#[allow(manual_unwrap_or)]
#[inline(always)]
fn saturating_sub_unsigned(a: i32, b: u32) -> i32 {
    let s: felt252 = a.into() - b.into();
    match s.try_into() {
        Some(v) => v,
        None => -0x80000000,
    }
}

/// Two's complement left shift: reinterpret, shift the `u32`, reinterpret back.
#[inline(always)]
fn shl_i32(a: i32, p: u32) -> i32 {
    u32_as_i32(shl_u32(i32_as_u32(a), p))
}

/// Arithmetic right shift, `floor(a / p)`: bias `a` by `2^31` to make it unsigned
/// (`i32_diff(a, MIN)` is always `Ok(a + 2^31)`), divide, remove the bias `2^31 / p`.
#[allow(manual_unwrap_or)]
#[inline(always)]
fn shr_i32(a: i32, p: NonZero<u32>, bias: felt252) -> i32 {
    let u = match i32_diff(a, -0x80000000) {
        Ok(v) | Err(v) => v,
    };
    let (q, _) = DivRem::div_rem(u, p);
    (q.into() - bias).try_into().unwrap()
}

/// Bitwise `&` of the two's complement representations (one bitwise builtin cell).
#[inline(always)]
fn bitand_i32(a: i32, b: i32) -> i32 {
    u32_as_i32(i32_as_u32(a) & i32_as_u32(b))
}

/// Bitwise `|` of the two's complement representations (one bitwise builtin cell).
#[inline(always)]
fn bitor_i32(a: i32, b: i32) -> i32 {
    u32_as_i32(i32_as_u32(a) | i32_as_u32(b))
}

/// Bitwise `^` of the two's complement representations (one bitwise builtin cell).
#[inline(always)]
fn bitxor_i32(a: i32, b: i32) -> i32 {
    u32_as_i32(i32_as_u32(a) ^ i32_as_u32(b))
}
