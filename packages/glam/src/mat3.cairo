    #[inline(always)]
    fn div_scalar(self: Mat3, rhs: Fixed) -> Mat3 {
        let r = RecipTrait::new(rhs);
        Mat3 {
            x_axis: Vec3 {
                x: r.mul(self.x_axis.x), y: r.mul(self.x_axis.y), z: r.mul(self.x_axis.z),
            },
            y_axis: Vec3 {
                x: r.mul(self.y_axis.x), y: r.mul(self.y_axis.y), z: r.mul(self.y_axis.z),
