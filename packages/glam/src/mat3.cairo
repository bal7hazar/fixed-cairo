/// The shared body of `inverse`, `try_inverse` and `inverse_or_zero`: the adjugate through the
/// fused kernels of `fixed::wide`, then ONE division (`Recip`) for the 9 elements. `None` when
/// the determinant is zero, which is the definition of singular here (docs/DESIGN.md section 3).
#[inline(always)]
fn inverse_checked(m: Mat3) -> Option<Mat3> {
    let det = det3(
        m.x_axis.x,
        m.x_axis.y,
        m.x_axis.z,
        m.y_axis.x,
        m.y_axis.y,
        m.y_axis.z,
        m.z_axis.x,
        m.z_axis.y,
        m.z_axis.z,
    );
    if det == F_ZERO {
        return None;
    }
    let t0 = Vec3 {
        x: mul_sub(m.y_axis.y, m.z_axis.z, m.y_axis.z, m.z_axis.y),
        y: mul_sub(m.y_axis.z, m.z_axis.x, m.y_axis.x, m.z_axis.z),
        z: mul_sub(m.y_axis.x, m.z_axis.y, m.y_axis.y, m.z_axis.x),
    };
    let t1 = Vec3 {
        x: mul_sub(m.z_axis.y, m.x_axis.z, m.z_axis.z, m.x_axis.y),
        y: mul_sub(m.z_axis.z, m.x_axis.x, m.z_axis.x, m.x_axis.z),
        z: mul_sub(m.z_axis.x, m.x_axis.y, m.z_axis.y, m.x_axis.x),
    };
    let t2 = Vec3 {
        x: mul_sub(m.x_axis.y, m.y_axis.z, m.x_axis.z, m.y_axis.y),
        y: mul_sub(m.x_axis.z, m.y_axis.x, m.x_axis.x, m.y_axis.z),
        z: mul_sub(m.x_axis.x, m.y_axis.y, m.x_axis.y, m.y_axis.x),
    };
    let r = RecipTrait::new(det);
    Some(
        Mat3 {
            x_axis: Vec3 { x: r.mul(t0.x), y: r.mul(t1.x), z: r.mul(t2.x) },
            y_axis: Vec3 { x: r.mul(t0.y), y: r.mul(t1.y), z: r.mul(t2.y) },
            z_axis: Vec3 { x: r.mul(t0.z), y: r.mul(t1.z), z: r.mul(t2.z) },
        },
    )
}

/// `0`.
const F_ZERO: Fixed = Fixed { raw: 0 };

/// `1`.
const F_ONE: Fixed = Fixed { raw: 0x100000000 };
