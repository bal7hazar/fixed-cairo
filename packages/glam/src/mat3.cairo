        Mat3 {
            x_axis: lhs.x_axis + rhs.x_axis,
            y_axis: lhs.y_axis + rhs.y_axis,
            z_axis: lhs.z_axis + rhs.z_axis,
        }
    }
}

/// Element-wise `-`. Exact. Panics with the `i64_sub` overflow messages.
///
/// Mirrors `impl Sub for glam::Mat3`.
pub impl Mat3Sub of Sub<Mat3> {
    #[inline(always)]
