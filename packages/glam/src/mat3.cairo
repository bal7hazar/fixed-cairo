    #[inline(always)]
    fn diagonal(self: Mat3) -> Vec3 {
        Vec3 { x: self.x_axis.x, y: self.y_axis.y, z: self.z_axis.z }
    }

    #[inline(always)]
    fn col(self: Mat3, index: usize) -> Vec3 {
        match index {
            0 => self.x_axis,
            1 => self.y_axis,
            2 => self.z_axis,
            _ => core::panic_with_felt252('Mat3: index out of bounds'),
        }
    }

    #[inline(always)]
    fn row(self: Mat3, index: usize) -> Vec3 {
        match index {
            0 => Vec3 { x: self.x_axis.x, y: self.y_axis.x, z: self.z_axis.x },
            1 => Vec3 { x: self.x_axis.y, y: self.y_axis.y, z: self.z_axis.y },
            2 => Vec3 { x: self.x_axis.z, y: self.y_axis.z, z: self.z_axis.z },
            _ => core::panic_with_felt252('Mat3: index out of bounds'),
        }
    }

    #[inline(always)]
    fn transpose(self: Mat3) -> Mat3 {
        Mat3 {
            x_axis: Vec3 { x: self.x_axis.x, y: self.y_axis.x, z: self.z_axis.x },
            y_axis: Vec3 { x: self.x_axis.y, y: self.y_axis.y, z: self.z_axis.y },
            z_axis: Vec3 { x: self.x_axis.z, y: self.y_axis.z, z: self.z_axis.z },
        }
    }

    #[inline(always)]
    fn determinant(self: Mat3) -> Fixed {
        det3(
            self.x_axis.x,
            self.x_axis.y,
            self.x_axis.z,
            self.y_axis.x,
            self.y_axis.y,
            self.y_axis.z,
            self.z_axis.x,
            self.z_axis.y,
            self.z_axis.z,
        )
    }

    #[inline(always)]
    fn mul_vec3(self: Mat3, rhs: Vec3) -> Vec3 {
        Vec3 {
            x: dot3(self.x_axis.x, rhs.x, self.y_axis.x, rhs.y, self.z_axis.x, rhs.z),
            y: dot3(self.x_axis.y, rhs.x, self.y_axis.y, rhs.y, self.z_axis.y, rhs.z),
            z: dot3(self.x_axis.z, rhs.x, self.y_axis.z, rhs.y, self.z_axis.z, rhs.z),
        }
    }

    #[inline(always)]
    fn mul_transpose_vec3(self: Mat3, rhs: Vec3) -> Vec3 {
        Vec3 {
            x: dot3(self.x_axis.x, rhs.x, self.x_axis.y, rhs.y, self.x_axis.z, rhs.z),
            y: dot3(self.y_axis.x, rhs.x, self.y_axis.y, rhs.y, self.y_axis.z, rhs.z),
            z: dot3(self.z_axis.x, rhs.x, self.z_axis.y, rhs.y, self.z_axis.z, rhs.z),
        }
    }

    #[inline(always)]
    fn mul_mat3(self: Mat3, rhs: Mat3) -> Mat3 {
        Mat3 {
            x_axis: Self::mul_vec3(self, rhs.x_axis),
            y_axis: Self::mul_vec3(self, rhs.y_axis),
            z_axis: Self::mul_vec3(self, rhs.z_axis),
