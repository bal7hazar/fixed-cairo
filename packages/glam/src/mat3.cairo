    #[inline(always)]
    fn from_quat(rotation: Quat) -> Mat3 {
        let x2 = rotation.x + rotation.x;
        let y2 = rotation.y + rotation.y;
        let z2 = rotation.z + rotation.z;
        Mat3 {
            x_axis: Vec3 {
                x: wide_from(F_ONE)
                    .sub(wide_mul(rotation.y, y2))
                    .sub(wide_mul(rotation.z, z2))
                    .narrow(),
                y: wide_mul(rotation.x, y2).add(wide_mul(rotation.w, z2)).narrow(),
                z: wide_mul(rotation.x, z2).sub(wide_mul(rotation.w, y2)).narrow(),
            },
            y_axis: Vec3 {
                x: wide_mul(rotation.x, y2).sub(wide_mul(rotation.w, z2)).narrow(),
                y: wide_from(F_ONE)
                    .sub(wide_mul(rotation.x, x2))
                    .sub(wide_mul(rotation.z, z2))
                    .narrow(),
                z: wide_mul(rotation.y, z2).add(wide_mul(rotation.w, x2)).narrow(),
            },
            z_axis: Vec3 {
                x: wide_mul(rotation.x, z2).add(wide_mul(rotation.w, y2)).narrow(),
                y: wide_mul(rotation.y, z2).sub(wide_mul(rotation.w, x2)).narrow(),
                z: wide_from(F_ONE)
                    .sub(wide_mul(rotation.x, x2))
                    .sub(wide_mul(rotation.y, y2))
                    .narrow(),
            },
        }
    }

    #[inline(always)]
    fn from_axis_angle(axis: Vec3, angle: Fixed) -> Mat3 {
        let (sin, cos) = angle.sin_cos();
        let omc = F_ONE - cos;
        Mat3 {
            x_axis: Vec3 {
                x: wide_mul(axis.x, axis.x).mul(omc).add(wide_from(cos).lift()).narrow(),
                y: wide_mul(axis.x, axis.y).mul(omc).add(wide_mul(axis.z, sin).lift()).narrow(),
                z: wide_mul(axis.x, axis.z).mul(omc).sub(wide_mul(axis.y, sin).lift()).narrow(),
            },
            y_axis: Vec3 {
                x: wide_mul(axis.x, axis.y).mul(omc).sub(wide_mul(axis.z, sin).lift()).narrow(),
                y: wide_mul(axis.y, axis.y).mul(omc).add(wide_from(cos).lift()).narrow(),
                z: wide_mul(axis.y, axis.z).mul(omc).add(wide_mul(axis.x, sin).lift()).narrow(),
            },
            z_axis: Vec3 {
                x: wide_mul(axis.x, axis.z).mul(omc).add(wide_mul(axis.y, sin).lift()).narrow(),
                y: wide_mul(axis.y, axis.z).mul(omc).sub(wide_mul(axis.x, sin).lift()).narrow(),
                z: wide_mul(axis.z, axis.z).mul(omc).add(wide_from(cos).lift()).narrow(),
            },
        }
    }

    #[inline(always)]
    fn from_rotation_x(angle: Fixed) -> Mat3 {
        let (sin, cos) = angle.sin_cos();
        Mat3 {
            x_axis: Vec3 {
                x: Fixed { raw: 0x100000000 }, y: Fixed { raw: 0 }, z: Fixed { raw: 0 },
            },
            y_axis: Vec3 { x: Fixed { raw: 0 }, y: cos, z: sin },
            z_axis: Vec3 { x: Fixed { raw: 0 }, y: -sin, z: cos },
        }
    }

    #[inline(always)]
    fn from_rotation_y(angle: Fixed) -> Mat3 {
        let (sin, cos) = angle.sin_cos();
        Mat3 {
            x_axis: Vec3 { x: cos, y: Fixed { raw: 0 }, z: -sin },
            y_axis: Vec3 {
                x: Fixed { raw: 0 }, y: Fixed { raw: 0x100000000 }, z: Fixed { raw: 0 },
            },
            z_axis: Vec3 { x: sin, y: Fixed { raw: 0 }, z: cos },
        }
    }

    #[inline(always)]
    fn from_rotation_z(angle: Fixed) -> Mat3 {
        let (sin, cos) = angle.sin_cos();
        Mat3 {
            x_axis: Vec3 { x: cos, y: sin, z: Fixed { raw: 0 } },
            y_axis: Vec3 { x: -sin, y: cos, z: Fixed { raw: 0 } },
            z_axis: Vec3 {
                x: Fixed { raw: 0 }, y: Fixed { raw: 0 }, z: Fixed { raw: 0x100000000 },
            },
        }
    }

    #[inline(always)]
    fn from_angle(angle: Fixed) -> Mat3 {
        let (sin, cos) = angle.sin_cos();
        Mat3 {
            x_axis: Vec3 { x: cos, y: sin, z: Fixed { raw: 0 } },
            y_axis: Vec3 { x: -sin, y: cos, z: Fixed { raw: 0 } },
            z_axis: Vec3 {
                x: Fixed { raw: 0 }, y: Fixed { raw: 0 }, z: Fixed { raw: 0x100000000 },
            },
        }
    }

    #[inline(always)]
    fn from_translation(translation: Vec2) -> Mat3 {
        Mat3 {
            x_axis: Vec3 {
                x: Fixed { raw: 0x100000000 }, y: Fixed { raw: 0 }, z: Fixed { raw: 0 },
            },
            y_axis: Vec3 {
                x: Fixed { raw: 0 }, y: Fixed { raw: 0x100000000 }, z: Fixed { raw: 0 },
            },
            z_axis: Vec3 { x: translation.x, y: translation.y, z: Fixed { raw: 0x100000000 } },
        }
    }

    #[inline(always)]
    fn from_scale(scale: Vec2) -> Mat3 {
        Mat3 {
            x_axis: Vec3 { x: scale.x, y: Fixed { raw: 0 }, z: Fixed { raw: 0 } },
            y_axis: Vec3 { x: Fixed { raw: 0 }, y: scale.y, z: Fixed { raw: 0 } },
            z_axis: Vec3 {
                x: Fixed { raw: 0 }, y: Fixed { raw: 0 }, z: Fixed { raw: 0x100000000 },
            },
        }
    }

    #[inline(always)]
    fn from_scale_angle_translation(scale: Vec2, angle: Fixed, translation: Vec2) -> Mat3 {
        let (sin, cos) = angle.sin_cos();
        Mat3 {
            x_axis: Vec3 { x: cos * scale.x, y: sin * scale.x, z: Fixed { raw: 0 } },
            y_axis: Vec3 { x: (-sin) * scale.y, y: cos * scale.y, z: Fixed { raw: 0 } },
            z_axis: Vec3 { x: translation.x, y: translation.y, z: Fixed { raw: 0x100000000 } },
        }
    }

    #[inline(always)]
    fn transform_point2(self: Mat3, rhs: Vec2) -> Vec2 {
        Vec2 {
            x: dot2_add(self.x_axis.x, rhs.x, self.y_axis.x, rhs.y, self.z_axis.x),
            y: dot2_add(self.x_axis.y, rhs.x, self.y_axis.y, rhs.y, self.z_axis.y),
        }
    }

    #[inline(always)]
    fn transform_vector2(self: Mat3, rhs: Vec2) -> Vec2 {
        Vec2 {
            x: dot2(self.x_axis.x, rhs.x, self.y_axis.x, rhs.y),
            y: dot2(self.x_axis.y, rhs.x, self.y_axis.y, rhs.y),
        }
    }
}

