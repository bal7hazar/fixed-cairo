#[allow(manual_unwrap_or)]
#[inline(always)]
fn u32_as_i32(a: u32) -> i32 {
    match a.try_into() {
        Some(v) => v,
        None => {
            let f: felt252 = a.into();
            (f - 0x100000000).try_into().unwrap()
        },
    }
}

/// `|a - b|` (never overflows): `checked_sub` is the comparison and the subtraction at once.
#[allow(manual_unwrap_or)]
#[inline(always)]
fn abs_diff_u32(a: u32, b: u32) -> u32 {
    match a.checked_sub(b) {
        Some(d) => d,
        None => b - a,
    }
}

/// `wide_mul` (1 step) and a downcast: cheaper than the corelib `CheckedMul`.
#[inline(always)]
fn checked_mul_u32(a: u32, b: u32) -> Option<u32> {
    a.wide_mul(b).try_into()
}

/// `wide_mul` (1 step) and a downcast: cheaper than the corelib `SaturatingMul`.
#[inline(always)]
fn saturating_mul_u32(a: u32, b: u32) -> u32 {
    a.wide_mul(b).try_into().unwrap_or(0xffffffff)
}

#[allow(manual_unwrap_or)]
#[inline(always)]
fn checked_div_u32(a: u32, b: u32) -> Option<u32> {
    match TryInto::<u32, NonZero<u32>>::try_into(b) {
        Some(d) => {
            let (q, _) = DivRem::div_rem(a, d);
            Some(q)
        },
        None => None,
    }
}

#[inline(always)]
fn checked_add_signed(a: u32, b: i32) -> Option<u32> {
    let s: felt252 = a.into() + b.into();
    s.try_into()
}

/// `-2^31 <= a + b < 2^32 + 2^31`: at most one wrap, in the direction of the sign of `b`.
#[allow(manual_unwrap_or)]
#[inline(always)]
fn wrapping_add_signed(a: u32, b: i32) -> u32 {
    let s: felt252 = a.into() + b.into();
    match s.try_into() {
        Some(v) => v,
        None => if b < 0 {
            (s + 0x100000000).try_into().unwrap()
        } else {
            (s - 0x100000000).try_into().unwrap()
        },
    }
}

#[allow(manual_unwrap_or)]
#[inline(always)]
fn saturating_add_signed(a: u32, b: i32) -> u32 {
    let s: felt252 = a.into() + b.into();
    match s.try_into() {
        Some(v) => v,
        None => if b < 0 {
            0
        } else {
            0xffffffff
        },
    }
}
