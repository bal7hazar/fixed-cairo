    fn to_scale_rotation_translation(self: Mat4) -> (Vec3, Quat, Vec3) {
        let r = Mat3Trait::from_mat4(self);
        // The length of each column, the sign of the determinant carried by the first.
        let len_x = Vec3Trait::length(r.x_axis);
        let scale = Vec3 {
            x: if Mat3Trait::determinant(r).is_negative() {
                -len_x
            } else {
                len_x
            },
            y: Vec3Trait::length(r.y_axis),
            z: Vec3Trait::length(r.z_axis),
        };
        // One shared reciprocal per column: three divisions instead of nine.
        let rx = RecipTrait::new(scale.x);
        let ry = RecipTrait::new(scale.y);
        let rz = RecipTrait::new(scale.z);
        let rotation = QuatTrait::from_rotation_axes(
            Vec3 { x: rx.mul(r.x_axis.x), y: rx.mul(r.x_axis.y), z: rx.mul(r.x_axis.z) },
            Vec3 { x: ry.mul(r.y_axis.x), y: ry.mul(r.y_axis.y), z: ry.mul(r.y_axis.z) },
            Vec3 { x: rz.mul(r.z_axis.x), y: rz.mul(r.z_axis.y), z: rz.mul(r.z_axis.z) },
        );
        (scale, rotation, Vec4Trait::truncate(self.w_axis))
    }

    #[inline(always)]
    fn from_axis_angle(axis: Vec3, angle: Fixed) -> Mat4 {
        let (sin, cos) = angle.sin_cos();
        let omc = F_ONE - cos;
        Mat4 {
            x_axis: Vec4 {
                x: wide_mul(axis.x, axis.x).mul(omc).add(wide_from(cos).lift()).narrow(),
                y: wide_mul(axis.x, axis.y).mul(omc).add(wide_mul(axis.z, sin).lift()).narrow(),
                z: wide_mul(axis.x, axis.z).mul(omc).sub(wide_mul(axis.y, sin).lift()).narrow(),
                w: Fixed { raw: 0 },
            },
            y_axis: Vec4 {
                x: wide_mul(axis.x, axis.y).mul(omc).sub(wide_mul(axis.z, sin).lift()).narrow(),
                y: wide_mul(axis.y, axis.y).mul(omc).add(wide_from(cos).lift()).narrow(),
                z: wide_mul(axis.y, axis.z).mul(omc).add(wide_mul(axis.x, sin).lift()).narrow(),
                w: Fixed { raw: 0 },
            },
            z_axis: Vec4 {
                x: wide_mul(axis.x, axis.z).mul(omc).add(wide_mul(axis.y, sin).lift()).narrow(),
                y: wide_mul(axis.y, axis.z).mul(omc).sub(wide_mul(axis.x, sin).lift()).narrow(),
                z: wide_mul(axis.z, axis.z).mul(omc).add(wide_from(cos).lift()).narrow(),
                w: Fixed { raw: 0 },
            },
            w_axis: Vec4 {
                x: Fixed { raw: 0 },
                y: Fixed { raw: 0 },
                z: Fixed { raw: 0 },
                w: Fixed { raw: 0x100000000 },
            },
        }
    }

