/// The shared body of `inverse`, `try_inverse` and `inverse_or_zero`: the adjugate through the
/// fused kernels of `fixed::wide`, then ONE division (`Recip`) for the 16 elements. `None` when
/// the determinant is zero, which is the definition of singular here (docs/DESIGN.md section 3).
#[inline(never)]
fn inverse_checked(m: Mat4) -> Option<Mat4> {
    let coef00 = mul_sub(m.z_axis.z, m.w_axis.w, m.w_axis.z, m.z_axis.w);
    let coef02 = mul_sub(m.y_axis.z, m.w_axis.w, m.w_axis.z, m.y_axis.w);
    let coef03 = mul_sub(m.y_axis.z, m.z_axis.w, m.z_axis.z, m.y_axis.w);
    let coef04 = mul_sub(m.z_axis.y, m.w_axis.w, m.w_axis.y, m.z_axis.w);
    let coef06 = mul_sub(m.y_axis.y, m.w_axis.w, m.w_axis.y, m.y_axis.w);
    let coef07 = mul_sub(m.y_axis.y, m.z_axis.w, m.z_axis.y, m.y_axis.w);
    let coef08 = mul_sub(m.z_axis.y, m.w_axis.z, m.w_axis.y, m.z_axis.z);
    let coef10 = mul_sub(m.y_axis.y, m.w_axis.z, m.w_axis.y, m.y_axis.z);
    let coef11 = mul_sub(m.y_axis.y, m.z_axis.z, m.z_axis.y, m.y_axis.z);
    let coef12 = mul_sub(m.z_axis.x, m.w_axis.w, m.w_axis.x, m.z_axis.w);
    let coef14 = mul_sub(m.y_axis.x, m.w_axis.w, m.w_axis.x, m.y_axis.w);
    let coef15 = mul_sub(m.y_axis.x, m.z_axis.w, m.z_axis.x, m.y_axis.w);
    let coef16 = mul_sub(m.z_axis.x, m.w_axis.z, m.w_axis.x, m.z_axis.z);
    let coef18 = mul_sub(m.y_axis.x, m.w_axis.z, m.w_axis.x, m.y_axis.z);
    let coef19 = mul_sub(m.y_axis.x, m.z_axis.z, m.z_axis.x, m.y_axis.z);
    let coef20 = mul_sub(m.z_axis.x, m.w_axis.y, m.w_axis.x, m.z_axis.y);
    let coef22 = mul_sub(m.y_axis.x, m.w_axis.y, m.w_axis.x, m.y_axis.y);
    let coef23 = mul_sub(m.y_axis.x, m.z_axis.y, m.z_axis.x, m.y_axis.y);
    let q0 = wide_mul(m.y_axis.y, coef00)
        .sub(wide_mul(m.y_axis.z, coef04))
        .add(wide_mul(m.y_axis.w, coef08));
    let q1 = wide_mul(m.y_axis.z, coef12)
        .sub(wide_mul(m.y_axis.x, coef00))
        .sub(wide_mul(m.y_axis.w, coef16));
    let q2 = wide_mul(m.y_axis.x, coef04)
        .sub(wide_mul(m.y_axis.y, coef12))
        .add(wide_mul(m.y_axis.w, coef20));
    let q3 = wide_mul(m.y_axis.y, coef16)
        .sub(wide_mul(m.y_axis.x, coef08))
        .sub(wide_mul(m.y_axis.z, coef20));
    let det = q0
        .mul(m.x_axis.x)
        .add(q1.mul(m.x_axis.y))
        .add(q2.mul(m.x_axis.z))
        .add(q3.mul(m.x_axis.w))
        .narrow();
    if det == F_ZERO {
        return None;
    }
    let q00 = q0.narrow();
    let q10 = q1.narrow();
    let q20 = q2.narrow();
    let q30 = q3.narrow();
    let q01 = wide_mul(m.x_axis.z, coef04)
        .sub(wide_mul(m.x_axis.y, coef00))
        .sub(wide_mul(m.x_axis.w, coef08))
        .narrow();
    let q02 = wide_mul(m.x_axis.y, coef02)
        .sub(wide_mul(m.x_axis.z, coef06))
        .add(wide_mul(m.x_axis.w, coef10))
        .narrow();
    let q03 = wide_mul(m.x_axis.z, coef07)
        .sub(wide_mul(m.x_axis.y, coef03))
        .sub(wide_mul(m.x_axis.w, coef11))
        .narrow();
    let q11 = wide_mul(m.x_axis.x, coef00)
        .sub(wide_mul(m.x_axis.z, coef12))
        .add(wide_mul(m.x_axis.w, coef16))
        .narrow();
    let q12 = wide_mul(m.x_axis.z, coef14)
        .sub(wide_mul(m.x_axis.x, coef02))
        .sub(wide_mul(m.x_axis.w, coef18))
        .narrow();
    let q13 = wide_mul(m.x_axis.x, coef03)
        .sub(wide_mul(m.x_axis.z, coef15))
        .add(wide_mul(m.x_axis.w, coef19))
        .narrow();
    let q21 = wide_mul(m.x_axis.y, coef12)
        .sub(wide_mul(m.x_axis.x, coef04))
        .sub(wide_mul(m.x_axis.w, coef20))
        .narrow();
    let q22 = wide_mul(m.x_axis.x, coef06)
        .sub(wide_mul(m.x_axis.y, coef14))
        .add(wide_mul(m.x_axis.w, coef22))
        .narrow();
    let q23 = wide_mul(m.x_axis.y, coef15)
        .sub(wide_mul(m.x_axis.x, coef07))
        .sub(wide_mul(m.x_axis.w, coef23))
        .narrow();
    let q31 = wide_mul(m.x_axis.x, coef08)
        .sub(wide_mul(m.x_axis.y, coef16))
        .add(wide_mul(m.x_axis.z, coef20))
        .narrow();
    let q32 = wide_mul(m.x_axis.y, coef18)
        .sub(wide_mul(m.x_axis.x, coef10))
        .sub(wide_mul(m.x_axis.z, coef22))
        .narrow();
    let q33 = wide_mul(m.x_axis.x, coef11)
        .sub(wide_mul(m.x_axis.y, coef19))
        .add(wide_mul(m.x_axis.z, coef23))
        .narrow();
    let r = RecipTrait::new(det);
    Some(
        Mat4 {
            x_axis: Vec4 { x: r.mul(q00), y: r.mul(q01), z: r.mul(q02), w: r.mul(q03) },
            y_axis: Vec4 { x: r.mul(q10), y: r.mul(q11), z: r.mul(q12), w: r.mul(q13) },
            z_axis: Vec4 { x: r.mul(q20), y: r.mul(q21), z: r.mul(q22), w: r.mul(q23) },
            w_axis: Vec4 { x: r.mul(q30), y: r.mul(q31), z: r.mul(q32), w: r.mul(q33) },
        },
    )
}

/// `0`.
const F_ZERO: Fixed = Fixed { raw: 0 };

/// `1`.
const F_ONE: Fixed = Fixed { raw: 0x100000000 };
