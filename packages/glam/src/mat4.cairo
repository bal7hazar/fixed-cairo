    #[inline(always)]
    fn transform_point3(self: Mat4, rhs: Vec3) -> Vec3 {
        Vec3 {
            x: dot3_add(
                self.x_axis.x, rhs.x, self.y_axis.x, rhs.y, self.z_axis.x, rhs.z, self.w_axis.x,
            ),
            y: dot3_add(
                self.x_axis.y, rhs.x, self.y_axis.y, rhs.y, self.z_axis.y, rhs.z, self.w_axis.y,
            ),
            z: dot3_add(
                self.x_axis.z, rhs.x, self.y_axis.z, rhs.y, self.z_axis.z, rhs.z, self.w_axis.z,
            ),
        }
    }

    #[inline(always)]
    fn transform_vector3(self: Mat4, rhs: Vec3) -> Vec3 {
        Vec3 {
            x: dot3(self.x_axis.x, rhs.x, self.y_axis.x, rhs.y, self.z_axis.x, rhs.z),
            y: dot3(self.x_axis.y, rhs.x, self.y_axis.y, rhs.y, self.z_axis.y, rhs.z),
            z: dot3(self.x_axis.z, rhs.x, self.y_axis.z, rhs.y, self.z_axis.z, rhs.z),
        }
    }

    fn project_point3(self: Mat4, rhs: Vec3) -> Vec3 {
        let w = dot3_add(
            self.x_axis.w, rhs.x, self.y_axis.w, rhs.y, self.z_axis.w, rhs.z, self.w_axis.w,
        );
        let r = RecipTrait::new(w);
        Vec3 {
            x: r
                .mul(
                    dot3_add(
                        self.x_axis.x,
                        rhs.x,
                        self.y_axis.x,
                        rhs.y,
                        self.z_axis.x,
                        rhs.z,
                        self.w_axis.x,
                    ),
                ),
            y: r
                .mul(
                    dot3_add(
                        self.x_axis.y,
                        rhs.x,
                        self.y_axis.y,
                        rhs.y,
                        self.z_axis.y,
                        rhs.z,
                        self.w_axis.y,
                    ),
                ),
            z: r
                .mul(
                    dot3_add(
                        self.x_axis.z,
                        rhs.x,
                        self.y_axis.z,
                        rhs.y,
                        self.z_axis.z,
                        rhs.z,
                        self.w_axis.z,
                    ),
                ),
        }
    }

    fn look_to_rh(eye: Vec3, dir: Vec3, up: Vec3) -> Mat4 {
        let s = Vec3Trait::normalize(Vec3Trait::cross(dir, up));
        let u = Vec3Trait::cross(s, dir);
        Mat4 {
            x_axis: Vec4 { x: s.x, y: u.x, z: -dir.x, w: F_ZERO },
            y_axis: Vec4 { x: s.y, y: u.y, z: -dir.y, w: F_ZERO },
            z_axis: Vec4 { x: s.z, y: u.z, z: -dir.z, w: F_ZERO },
            w_axis: Vec4 {
                x: -Vec3Trait::dot(eye, s),
                y: -Vec3Trait::dot(eye, u),
                z: Vec3Trait::dot(eye, dir),
                w: F_ONE,
            },
        }
    }

    fn look_to_lh(eye: Vec3, dir: Vec3, up: Vec3) -> Mat4 {
        Self::look_to_rh(eye, -dir, up)
    }

    fn look_at_rh(eye: Vec3, center: Vec3, up: Vec3) -> Mat4 {
        Self::look_to_rh(eye, Vec3Trait::normalize(center - eye), up)
    }

    fn look_at_lh(eye: Vec3, center: Vec3, up: Vec3) -> Mat4 {
        Self::look_to_lh(eye, Vec3Trait::normalize(center - eye), up)
    }
}

