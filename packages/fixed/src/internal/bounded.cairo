pub fn div_euclid(a: i64, b: i64) -> i64 {
    let b_nz: NonZero<i64> = or_division_by_zero(b.try_into());
    match bounded_int::constrain::<NonZero<i64>, 0>(b_nz) {
        Ok(bn) => {
            let dn = bn.negate();
            match bounded_int::constrain::<i64, 0>(a) {
                Ok(n) => {
                    let m1 = bounded_int::sub::<_, UnitInt<0x1>>(n.negate(), 0x1);
                    let (q, _r) = bounded_int::div_rem(m1, dn);
                    or_overflow(
                        downcast(
                            bounded_int::mul::<
                                _, UnitInt<0x100000000>,
                            >(bounded_int::add::<_, UnitInt<0x1>>(q, 0x1), 0x100000000),
                        ),
                    )
                },
                Err(p) => {
                    let (q, _r) = bounded_int::div_rem(p, dn);
                    or_overflow(
                        downcast(
                            bounded_int::mul::<_, UnitInt<0x100000000>>(q.negate(), 0x100000000),
                        ),
                    )
                },
            }
        },
        Err(dp) => {
            match bounded_int::constrain::<i64, 0>(a) {
                Ok(n) => {
                    let m1 = bounded_int::sub::<_, UnitInt<0x1>>(n.negate(), 0x1);
                    let (q, _r) = bounded_int::div_rem(m1, dp);
                    or_overflow(
                        downcast(
                            bounded_int::mul::<
                                _, UnitInt<0x100000000>,
                            >(bounded_int::add::<_, UnitInt<0x1>>(q, 0x1).negate(), 0x100000000),
                        ),
                    )
                },
                Err(p) => {
                    let (q, _r) = bounded_int::div_rem(p, dp);
                    or_overflow(
                        downcast(bounded_int::mul::<_, UnitInt<0x100000000>>(q, 0x100000000)),
                    )
                },
            }
        },
    }
}
