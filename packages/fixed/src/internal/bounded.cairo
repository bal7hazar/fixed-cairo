/// Least non-negative remainder of `a` modulo `|b|`.
#[inline(always)]
pub fn rem_euclid(a: i64, b: i64) -> i64 {
    let b_nz: NonZero<i64> = or_division_by_zero(b.try_into());
    match bounded_int::constrain::<NonZero<i64>, 0>(b_nz) {
        Ok(bn) => {
            let dn = bn.negate();
            match bounded_int::constrain::<i64, 0>(a) {
                Ok(n) => {
                    let m1 = bounded_int::sub::<_, UnitInt<0x1>>(n.negate(), 0x1);
                    let (_q, r) = bounded_int::div_rem(m1, dn);
                    let dv: BoundedInt<0x1, 0x8000000000000000> = dn.into();
                    upcast(bounded_int::sub(bounded_int::sub::<_, UnitInt<0x1>>(dv, 0x1), r))
                },
                Err(p) => {
                    let (_q, r) = bounded_int::div_rem(p, dn);
                    upcast(r)
                },
            }
        },
        Err(dp) => {
            match bounded_int::constrain::<i64, 0>(a) {
                Ok(n) => {
                    let m1 = bounded_int::sub::<_, UnitInt<0x1>>(n.negate(), 0x1);
                    let (_q, r) = bounded_int::div_rem(m1, dp);
                    let dv: BoundedInt<0x0, 0x7fffffffffffffff> = dp.into();
                    upcast(bounded_int::sub(bounded_int::sub::<_, UnitInt<0x1>>(dv, 0x1), r))
                },
                Err(p) => {
                    let (_q, r) = bounded_int::div_rem(p, dp);
                    upcast(r)
                },
            }
        },
    }
}
/// Integer quotient `n` (as `n * 2^32`) such that `a = n * b + rem_euclid(a, b)`.
