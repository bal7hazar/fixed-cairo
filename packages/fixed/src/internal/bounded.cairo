/// Unwraps `o` or panics with `Fixed: overflow` (out-of-line `panic_with_const_felt252`).
#[inline(always)]
pub fn or_overflow<T>(o: Option<T>) -> T {
    match o {
        Some(v) => v,
        None => core::panic_with_const_felt252::<'Fixed: overflow'>(),
    }
}
/// Unwraps `o` or panics with `Fixed: division by zero` (out-of-line `panic_with_const_felt252`).
#[inline(always)]
pub fn or_division_by_zero<T>(o: Option<T>) -> T {
    match o {
        Some(v) => v,
        None => core::panic_with_const_felt252::<'Fixed: division by zero'>(),
    }
}
/// Unwraps `o` or panics with `Fixed: sqrt negative` (out-of-line `panic_with_const_felt252`).
#[inline(always)]
pub fn or_sqrt_negative<T>(o: Option<T>) -> T {
    match o {
        Some(v) => v,
        None => core::panic_with_const_felt252::<'Fixed: sqrt negative'>(),
    }
}
/// `floor(f / 2^32)` of a Q64.64 accumulator held in a felt252 (`|f| << P`), range-checked into
/// `i64` by a single `felt252 -> u128` conversion: the result fits iff
/// `0 <= (f + 2^95) * 2^32 < 2^128`; the biased result is then the high 64 bits.
#[inline(always)]
pub fn narrow32(f: felt252) -> i64 {
    let u: u128 = or_overflow(((f + 0x800000000000000000000000) * 0x100000000).try_into());
    let (q, _r) = bounded_int::div_rem::<_, UnitInt<0x10000000000000000>>(u, 0x10000000000000000);
    upcast(bounded_int::sub::<_, UnitInt<0x8000000000000000>>(q, 0x8000000000000000))
}
/// `floor(f / 2^64)` of a Q96.96 accumulator held in a felt252 (`|f| << P`): the result fits
/// `i64` iff `0 <= f + 2^127 < 2^128`.
#[inline(always)]
pub fn narrow64(f: felt252) -> i64 {
    let u: u128 = or_overflow((f + 0x80000000000000000000000000000000).try_into());
    let (q, _r) = bounded_int::div_rem::<_, UnitInt<0x10000000000000000>>(u, 0x10000000000000000);
    upcast(bounded_int::sub::<_, UnitInt<0x8000000000000000>>(q, 0x8000000000000000))
}
/// `floor(f / 2^64 + 1/2)` (round to nearest, ties toward +infinity) of a felt252 (`|f| << P`).
#[inline(always)]
pub fn narrow64_round(f: felt252) -> i64 {
    let u: u128 = or_overflow((f + 0x80000000000000008000000000000000).try_into());
    let (q, _r) = bounded_int::div_rem::<_, UnitInt<0x10000000000000000>>(u, 0x10000000000000000);
    upcast(bounded_int::sub::<_, UnitInt<0x8000000000000000>>(q, 0x8000000000000000))
}
/// Raw Q64.64 product of two raw Q32.32 values: one step, no range check.
#[inline(always)]
pub fn wide(a: i64, b: i64) -> BW1 {
    upcast(bounded_int::mul(a, b))
}
/// Lifts a raw Q32.32 value to the Q64.64 scale (`x * 2^32`, exact).
#[inline(always)]
pub fn lift(x: i64) -> BW1 {
    upcast(bounded_int::mul::<_, UnitInt<0x100000000>>(x, 0x100000000))
}
/// `floor(sqrt(x))` of a Q64.64 sum of 1 product(s): the integer square root of the raw
/// sum is the raw Q32.32 result (no rescale).
#[inline(always)]
pub fn sqrt_w1(x: BW1) -> i64 {
    match bounded_int::constrain::<BW1, 0>(x) {
        Ok(_) => core::panic_with_const_felt252::<'Fixed: sqrt negative'>(),
        Err(v) => {
            let s: u128 = upcast(v);
            let r: u64 = Sqrt::sqrt(s);
            or_overflow(downcast(r))
        },
    }
}
/// `floor(sqrt(x))` of a Q64.64 sum of 2 product(s): the integer square root of the raw
/// sum is the raw Q32.32 result (no rescale).
#[inline(always)]
pub fn sqrt_w2(x: BW2) -> i64 {
    match bounded_int::constrain::<BW2, 0>(x) {
        Ok(_) => core::panic_with_const_felt252::<'Fixed: sqrt negative'>(),
        Err(v) => {
            let s: u128 = upcast(v);
            let r: u64 = Sqrt::sqrt(s);
            or_overflow(downcast(r))
        },
    }
}
/// `floor(sqrt(x))` of a Q64.64 sum of 3 product(s): the integer square root of the raw
/// sum is the raw Q32.32 result (no rescale).
#[inline(always)]
pub fn sqrt_w3(x: BW3) -> i64 {
    match bounded_int::constrain::<BW3, 0>(x) {
        Ok(_) => core::panic_with_const_felt252::<'Fixed: sqrt negative'>(),
        Err(v) => {
            let s: u128 = upcast(v);
            let r: u64 = Sqrt::sqrt(s);
