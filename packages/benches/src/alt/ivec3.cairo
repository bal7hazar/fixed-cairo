#[inline(always)]
fn lt_felt(a: i32, b: i32) -> bool {
    let d: felt252 = a.into() - b.into();
    TryInto::<felt252, u32>::try_into(d).is_none()
}

#[allow(manual_unwrap_or)]
#[inline(always)]
