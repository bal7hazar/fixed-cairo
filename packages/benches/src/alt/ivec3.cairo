    match i32_diff(a, b) {
        Ok(d) => d,
        Err(e) => {
            let e: felt252 = e.into();
            (0x100000000 - e).try_into().unwrap()
        },
    }
}

#[inline(always)]
fn as_u32_felt(a: i32) -> u32 {
    if a < 0 {
        let f: felt252 = a.into();
        (f + 0x100000000).try_into().unwrap()
    } else {
        a.try_into().unwrap()
    }
}

