/// `2^f` on `[0, 1)`, degree 12, scale `2^60`.
#[inline(always)]
fn exp2_poly_single(u: W1) -> Fixed {
    let acc = Fixed { raw: 0x201e5ba };
    let acc = step(u, acc, Fixed { raw: 0x1f30c2e3 });
    let acc = step(u, acc, Fixed { raw: 0x1e1712c00 });
    let acc = step(u, acc, Fixed { raw: 0x1b58358630 });
    let acc = step(u, acc, Fixed { raw: 0x162baa31948 });
    let acc = step(u, acc, Fixed { raw: 0xffe62dd70cd });
    let acc = step(u, acc, Fixed { raw: 0xa1848893ef5f });
    let acc = step(u, acc, Fixed { raw: 0x5761ffa02f9f0 });
    let acc = step(u, acc, Fixed { raw: 0x276556df7511a0 });
    let acc = step(u, acc, Fixed { raw: 0xe35846b8246a80 });
    let acc = step(u, acc, Fixed { raw: 0x3d7f7bff058bdc0 });
    let acc = step(u, acc, Fixed { raw: 0xb17217f7d1cf600 });
    step(u, acc, Fixed { raw: 0x1000000000000000 })
}

/// `e^r` on `[0, ln(2) / 16)`, degree 6, scale `2^60`.
#[inline(always)]
fn exp_poly_cw(u: W2) -> Fixed {
    let acc = Fixed { raw: 0x5cbc5c9fd4594 };
    let acc = step2(u, acc, Fixed { raw: 0x2220c951be599e });
    let acc = step2(u, acc, Fixed { raw: 0xaaaab27a207390 });
    let acc = step2(u, acc, Fixed { raw: 0x2aaaaaa961f2400 });
    let acc = step2(u, acc, Fixed { raw: 0x80000000013de80 });
    let acc = step2(u, acc, Fixed { raw: 0xffffffffffffc80 });
    step2(u, acc, Fixed { raw: 0x1000000000000000 })
}

/// `2 / ln(2) * atanh(s) / s` in `u = s^2` on `[0, 1/9]`, degree 7, scale
/// `2^56`.
#[inline(always)]
fn atanh_poly(u: W1) -> Fixed {
    let acc = Fixed { raw: 0x4a3837a57cec08 };
    let acc = step(u, acc, Fixed { raw: 0x33ed8f11411fbc });
    let acc = step(u, acc, Fixed { raw: 0x43a168b8545154 });
    let acc = step(u, acc, Fixed { raw: 0x520c33d745cdf8 });
    let acc = step(u, acc, Fixed { raw: 0x69860921c31b04 });
    let acc = step(u, acc, Fixed { raw: 0x93bb61d87e0b60 });
    let acc = step(u, acc, Fixed { raw: 0xf6384ee2c05ca0 });
    step(u, acc, Fixed { raw: 0x2e2a8eca57029c0 })
}

