        x: lhs.x_axis.x * rhs.x
            + lhs.y_axis.x * rhs.y
            + lhs.z_axis.x * rhs.z
            + lhs.w_axis.x * rhs.w,
        y: lhs.x_axis.y * rhs.x
            + lhs.y_axis.y * rhs.y
            + lhs.z_axis.y * rhs.z
            + lhs.w_axis.y * rhs.w,
        z: lhs.x_axis.z * rhs.x
            + lhs.y_axis.z * rhs.y
            + lhs.z_axis.z * rhs.z
            + lhs.w_axis.z * rhs.w,
        w: lhs.x_axis.w * rhs.x
            + lhs.y_axis.w * rhs.y
            + lhs.z_axis.w * rhs.z
            + lhs.w_axis.w * rhs.w,
    }
