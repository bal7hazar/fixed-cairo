        Mat4 {
            x_axis: Vec4 { x: q00 / det, y: q01 / det, z: q02 / det, w: q03 / det },
            y_axis: Vec4 { x: q10 / det, y: q11 / det, z: q12 / det, w: q13 / det },
            z_axis: Vec4 { x: q20 / det, y: q21 / det, z: q22 / det, w: q23 / det },
