    Mat4 {
        x_axis: Vec4 {
            x: lhs.x_axis.x / rhs,
            y: lhs.x_axis.y / rhs,
            z: lhs.x_axis.z / rhs,
            w: lhs.x_axis.w / rhs,
        },
        y_axis: Vec4 {
            x: lhs.y_axis.x / rhs,
            y: lhs.y_axis.y / rhs,
            z: lhs.y_axis.z / rhs,
            w: lhs.y_axis.w / rhs,
        },
        z_axis: Vec4 {
            x: lhs.z_axis.x / rhs,
            y: lhs.z_axis.y / rhs,
