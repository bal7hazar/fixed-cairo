/// `floor(a * b / 2^32)`: bias, `div_rem`, un-bias, `downcast` (research prototype, 2 050 gas).
#[inline(always)]
fn mul_bias_downcast_raw(a: i64, b: i64) -> i64 {
    let biased = bounded_int::add::<
        _, UnitInt<0x40000000000000000000000000000000>,
    >(bounded_int::mul(a, b), 0x40000000000000000000000000000000);
    let (q, _r) = bounded_int::div_rem::<_, UnitInt<0x100000000>>(biased, 0x100000000);
    or_overflow(
        downcast(
            bounded_int::sub::<
                _, UnitInt<0x400000000000000000000000>,
            >(q, 0x400000000000000000000000),
        ),
    )
}
/// `floor((a * b - c * d) * e / 2^64)`: single `div_rem` by 2^64 then `downcast`. Only possible
/// for up to 3 triple products (the biased quotient must stay below 2^128).
#[inline(always)]
fn triple_single_downcast_raw(a: i64, b: i64, c: i64, d: i64, e: i64) -> i64 {
    let biased = bounded_int::add::<
        _, UnitInt<0x400000000000000000000000000000000000000000000000>,
    >(
        bounded_int::mul(bounded_int::sub(bounded_int::mul(a, b), bounded_int::mul(c, d)), e),
        0x400000000000000000000000000000000000000000000000,
    );
    let (q, _r) = bounded_int::div_rem::<
        _, UnitInt<0x10000000000000000>,
    >(biased, 0x10000000000000000);
    or_overflow(
        downcast(
            bounded_int::sub::<
                _, UnitInt<0x40000000000000000000000000000000>,
            >(q, 0x40000000000000000000000000000000),
        ),
