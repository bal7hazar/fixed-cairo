/// Unwraps `o` or panics with `Fixed: overflow` (out-of-line `panic_with_const_felt252`).
#[inline(always)]
fn or_overflow<T>(o: Option<T>) -> T {
    match o {
        Some(v) => v,
        None => core::panic_with_const_felt252::<'Fixed: overflow'>(),
    }
}
