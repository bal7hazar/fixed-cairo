/// `trunc((a * 2^32) / b)` with the prototype's flat structure: two sequential sign splits
/// carrying boolean flags, then one conditional negation (1 000 gas more than the nested
/// 4-way match of the library).
#[inline(always)]
fn div_trunc_flat_raw(a: i64, b: i64) -> i64 {
    let b_nz: NonZero<i64> = or_division_by_zero(b.try_into());
    let (num, a_neg): (BoundedInt<0x0, 0x800000000000000000000000>, bool) =
        match bounded_int::constrain::<i64, 0>(a) {
        Ok(n) => {
            let m = n.negate();
            (upcast(bounded_int::mul::<_, UnitInt<0x100000000>>(m, 0x100000000)), true)
        },
        Err(p) => (upcast(bounded_int::mul::<_, UnitInt<0x100000000>>(p, 0x100000000)), false),
    };
    let (q, neg): (BoundedInt<0x0, 0x800000000000000000000000>, bool) =
        match bounded_int::constrain::<NonZero<i64>, 0>(b_nz) {
        Ok(bn) => {
            let (q, _r) = bounded_int::div_rem(num, bn.negate());
            (q, !a_neg)
        },
        Err(dp) => {
            let (q, _r) = bounded_int::div_rem(num, dp);
            (q, a_neg)
        },
    };
    if neg {
        or_overflow(downcast(q.negate()))
    } else {
        or_overflow(downcast(q))
    }
}
